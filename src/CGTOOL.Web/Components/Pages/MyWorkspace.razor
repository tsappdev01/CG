@page "/my-workspace"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>My Workspace</PageTitle>

<div class="cg-shell cg-shell-full cg-workspace">
    <nav class="cg-breadcrumb" aria-label="Breadcrumb">
        <a href="" class="cg-breadcrumb-home" aria-label="Dashboard"></a>
        <span class="cg-breadcrumb-sep">|</span>
        <span>My Workspace</span>
    </nav>

    <div class="cg-workspace-head">
        <div>
            <h1>Insider Trading &amp; Related Party Declaration</h1>
            <p class="cg-subtitle">Disclose your related parties, close family members, in-laws, steps and companies for compliance with CG and regulatory requirements.</p>
        </div>
        <div class="cg-info-callout cg-workspace-notice">
            This declaration is mandatory for all Insiders, BOD members and key management personnel.
            Please ensure the information is complete and up to date.
        </div>
    </div>

    @if (!_loaded)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else if (_effectiveMember is null)
    {
        <div class="cg-empty-state">
            Your login isn't linked to a User record yet, so there is nothing to show here.
            Ask an Administrator to link your account on the User Management page.
        </div>
    }
    else
    {
        <section class="cg-card cg-summary-card">
            <h2 class="cg-card-title">Declaration Summary</h2>
            <div class="cg-summary-grid">
                <div class="cg-summary-item">
                    <span class="cg-summary-ico cg-ico-calendar" aria-hidden="true"></span>
                    <div>
                        <span class="cg-summary-label">Last Declared</span>
                        <span class="cg-summary-value">@(_lastDeclared ?? "—")</span>
                    </div>
                </div>
                <div class="cg-summary-item">
                    <span class="cg-summary-ico @(_hasSubmitted ? "cg-ico-check-green" : "cg-ico-pending")" aria-hidden="true"></span>
                    <div>
                        <span class="cg-summary-label">Status</span>
                        <span class="cg-summary-value @(_hasSubmitted ? "good" : "warn")">@(_hasSubmitted ? "Submitted" : "Not submitted")</span>
                    </div>
                </div>
                <div class="cg-summary-item">
                    <span class="cg-summary-ico cg-ico-page" aria-hidden="true"></span>
                    <div>
                        <span class="cg-summary-label">Declaration Period</span>
                        <span class="cg-summary-value">@(_declarationPeriod ?? "—")</span>
                    </div>
                </div>
                <div class="cg-summary-item">
                    <span class="cg-summary-ico cg-ico-clock" aria-hidden="true"></span>
                    <div>
                        <span class="cg-summary-label">Next Due Date</span>
                        <span class="cg-summary-value">@(_nextDueDate ?? "—")</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="cg-card cg-relatives-card">
            <div class="cg-relatives-head">
                <div>
                    <h2 class="cg-card-title">Relatives &amp; Related Parties</h2>
                    <p class="cg-subtitle">Add and maintain details of your relatives, in-laws, steps and companies in which you / your relatives have an interest.</p>
                </div>
                <button type="button" class="cg-action-btn cg-good cg-btn-add" disabled="@_addingRow" @onclick="StartAddRelative">Add Declaration</button>
            </div>

            <div class="cg-controls cg-relatives-filters">
                <div class="cg-search-wrap">
                    <input class="cg-input" type="search" placeholder="Search name, company or Emirates ID…"
                           @bind="_search" @bind:event="oninput" @bind:after="ResetRelativesPage" aria-label="Search related parties" />
                </div>
                <label class="cg-field cg-relation-filter">
                    <span>Relation</span>
                    <select class="cg-input" value="@(_relationFilter?.ToString() ?? "")"
                            @onchange="e => { var v = (string?)e.Value; _relationFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<RelativeRelationship>(v); ResetRelativesPage(); }">
                        <option value="">All Relations</option>
                        @foreach (var opt in RelativeOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                </label>
            </div>

            <div class="cg-table-wrap">
                <table class="cg-relatives-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Relation</th>
                            <th>Emirates ID / Passport</th>
                            <th>Date of Birth</th>
                            <th>Nationality</th>
                            <th>Occupation / Business</th>
                            <th>Company / Organization</th>
                            <th>Interest Type</th>
                            <th>Ownership %</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_addingRow && _draft is not null)
                        {
                            <tr class="cg-data-row cg-row-editing">
                                <td><input class="cg-input" placeholder="Full name" @bind="_draft.Name" maxlength="120" /></td>
                                <td>
                                    <select class="cg-input" @bind="_draft.Relationship">
                                        @foreach (var opt in RelativeOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </td>
                                <td><input class="cg-input" @bind="_draft.IdentificationNumber" maxlength="60" /></td>
                                <td><input type="date" class="cg-input" @bind="_draft.DateOfBirth" /></td>
                                <td><input class="cg-input" @bind="_draft.Nationality" maxlength="80" /></td>
                                <td><input class="cg-input" @bind="_draft.Occupation" maxlength="160" /></td>
                                <td><input class="cg-input" @bind="_draft.Organization" maxlength="160" /></td>
                                <td>
                                    <select class="cg-input" @bind="_draft.InterestType">
                                        <option value="@RelatedPartyInterestType.None">—</option>
                                        <option value="@RelatedPartyInterestType.Direct">Direct</option>
                                        <option value="@RelatedPartyInterestType.Indirect">Indirect</option>
                                    </select>
                                </td>
                                <td><input type="number" step="0.01" min="0" max="100" class="cg-input" @bind="_draft.OwnershipPercentage" /></td>
                                <td>
                                    <span class="cg-row-actions">
                                        <button type="button" class="cg-action-btn cg-good" @onclick="AddFamilyMemberAsync">Save</button>
                                        <button type="button" class="cg-action-btn" @onclick="CancelAddRelative">Cancel</button>
                                    </span>
                                </td>
                            </tr>
                        }

                        @foreach (var f in PagedRelatives())
                        {
                            if (_editingId == f.Id)
                            {
                                <tr class="cg-data-row cg-row-editing">
                                    <td><input class="cg-input" @bind="f.Name" maxlength="120" /></td>
                                    <td>
                                        <select class="cg-input" @bind="f.Relationship">
                                            @foreach (var opt in RelativeOptions)
                                            {
                                                <option value="@opt.Value">@opt.Label</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input class="cg-input" @bind="f.IdentificationNumber" maxlength="60" /></td>
                                    <td><input type="date" class="cg-input" @bind="f.DateOfBirth" /></td>
                                    <td><input class="cg-input" @bind="f.Nationality" maxlength="80" /></td>
                                    <td><input class="cg-input" @bind="f.Occupation" maxlength="160" /></td>
                                    <td><input class="cg-input" @bind="f.Organization" maxlength="160" /></td>
                                    <td>
                                        <select class="cg-input" @bind="f.InterestType">
                                            <option value="@RelatedPartyInterestType.None">—</option>
                                            <option value="@RelatedPartyInterestType.Direct">Direct</option>
                                            <option value="@RelatedPartyInterestType.Indirect">Indirect</option>
                                        </select>
                                    </td>
                                    <td><input type="number" step="0.01" min="0" max="100" class="cg-input" @bind="f.OwnershipPercentage" /></td>
                                    <td>
                                        <span class="cg-row-actions">
                                            <button type="button" class="cg-action-btn cg-good" @onclick="() => SaveFamilyMemberAsync(f)">Save</button>
                                            <button type="button" class="cg-action-btn" @onclick="CancelEditRelative">Cancel</button>
                                        </span>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="cg-data-row">
                                    <td class="cg-cell-name">@f.Name</td>
                                    <td>@RelationLabel(f.Relationship)</td>
                                    <td class="mono">@(string.IsNullOrWhiteSpace(f.IdentificationNumber) ? "—" : f.IdentificationNumber)</td>
                                    <td>@(f.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.Nationality) ? "—" : f.Nationality)</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.Occupation) ? "—" : f.Occupation)</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.Organization) ? "—" : f.Organization)</td>
                                    <td>@InterestLabel(f.InterestType)</td>
                                    <td>@(f.OwnershipPercentage is { } pct ? $"{pct:0.##}%" : "—")</td>
                                    <td>
                                        <span class="cg-row-actions">
                                            <button type="button" class="cg-icon-btn" title="Edit @f.Name" @onclick="() => StartEditRelative(f)"><span class="cg-ico cg-ico-pencil" aria-hidden="true"></span></button>
                                            <button type="button" class="cg-icon-btn cg-icon-btn-danger" title="Remove @f.Name" @onclick="() => RemoveFamilyMemberAsync(f)"><span class="cg-ico cg-ico-trash" aria-hidden="true"></span></button>
                                        </span>
                                    </td>
                                </tr>
                            }
                        }

                        @if (RelativesTotal == 0 && !_addingRow)
                        {
                            <tr><td colspan="10" class="cg-empty-state">No related parties recorded yet. Use <b>Add Declaration</b> to add one.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cg-table-foot">
                <span>Showing @FirstRelativeOnPage - @LastRelativeOnPage of @RelativesTotal records</span>
                <div class="cg-pager">
                    <button type="button" title="Previous page" disabled="@(_page <= 1)" @onclick="() => GoToRelativesPage(_page - 1)">‹</button>
                    @for (var n = 1; n <= RelativesPages; n++)
                    {
                        var target = n;
                        <button type="button" class="@(target == _page ? "active" : "")" @onclick="() => GoToRelativesPage(target)">@target</button>
                    }
                    <button type="button" title="Next page" disabled="@(_page >= RelativesPages)" @onclick="() => GoToRelativesPage(_page + 1)">›</button>
                </div>
            </div>
        </section>

        @* Kept below the related parties rather than dropped: the Related Party & COI declaration
           offers these as an "Add from My Companies" picker, so removing them would take a feature
           away from that wizard. *@
        <h2 class="cg-section-heading cg-workspace-companies-heading">My Companies</h2>
        <div class="cg-card cg-companies-card">
            <div class="cg-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Name of the Company</th>
                            <th>Trade License Details</th>
                            <th>Ownership %</th>
                            <th>Trade License</th>
                            <th>MOA</th>
                            <th>POA <em class="cg-subtitle" style="margin:0;">(optional)</em></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="cg-data-row">
                            <td><input class="cg-input" placeholder="Company name" @bind="_newCompanyName" maxlength="160" /></td>
                            <td><input class="cg-input" placeholder="Trade license details" @bind="_newCompanyTradeLicenseDetails" maxlength="400" /></td>
                            <td><input type="number" class="cg-input" placeholder="0-100" min="0" max="100" step="0.01" @bind="_newCompanyOwnership" /></td>
                            <td class="cg-subtitle">Save first</td>
                            <td class="cg-subtitle">Save first</td>
                            <td class="cg-subtitle">Save first</td>
                            <td><button type="button" class="cg-action-btn cg-good" @onclick="AddCompanyAsync">Add company</button></td>
                        </tr>
                        @foreach (var c in _companies)
                        {
                            <tr class="cg-data-row">
                                <td><input class="cg-input" @bind="c.CompanyName" maxlength="160" /></td>
                                <td><input class="cg-input" @bind="c.TradeLicenseDetails" maxlength="400" /></td>
                                <td><input type="number" class="cg-input" min="0" max="100" step="0.01" @bind="c.OwnershipPercentage" /></td>
                                <td>
                                    <InputFile OnChange="e => OnTradeLicenseSelectedAsync(c, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploading(c.Id, "trade-license")" />
                                    @if (IsUploading(c.Id, "trade-license"))
                                    {
                                        <span class="cg-subtitle">Uploading…</span>
                                    }
                                    else if (!string.IsNullOrEmpty(c.TradeLicensePath))
                                    {
                                        <a href="@c.TradeLicensePath" target="_blank" class="cg-subtitle">✓ view</a>
                                    }
                                </td>
                                <td>
                                    <InputFile OnChange="e => OnMoaSelectedAsync(c, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploading(c.Id, "moa")" />
                                    @if (IsUploading(c.Id, "moa"))
                                    {
                                        <span class="cg-subtitle">Uploading…</span>
                                    }
                                    else if (!string.IsNullOrEmpty(c.MoaPath))
                                    {
                                        <a href="@c.MoaPath" target="_blank" class="cg-subtitle">✓ view</a>
                                    }
                                </td>
                                <td>
                                    <InputFile OnChange="e => OnPoaSelectedAsync(c, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploading(c.Id, "poa")" />
                                    @if (IsUploading(c.Id, "poa"))
                                    {
                                        <span class="cg-subtitle">Uploading…</span>
                                    }
                                    else if (!string.IsNullOrEmpty(c.PoaPath))
                                    {
                                        <a href="@c.PoaPath" target="_blank" class="cg-subtitle">✓ view</a>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="cg-action-btn cg-good" @onclick="() => SaveCompanyAsync(c)">Save</button>
                                    <button type="button" class="cg-action-btn cg-critical" @onclick="() => RemoveCompanyAsync(c)">Remove</button>
                                </td>
                            </tr>
                        }
                        @if (_companies.Count == 0)
                        {
                            <tr><td colspan="7" class="cg-subtitle">No companies added yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
