@page "/admin/document-center"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDocumentTypeWriter DocumentTypeWriter
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ToastService Toasts

<PageTitle>Document Center</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="folder">Document Center</h1>
    <p class="cg-subtitle">Control Panel — the documents people are asked to keep on file.</p>

    @if (_types is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <section class="cg-card">
            <div class="cg-card-head">
                <div>
                    <span class="cg-card-title">User Documents</span>
                    <span class="cg-subtitle">
                        Shown on My Workspace and on the declaration forms. Required means a person
                        cannot complete a declaration without one; Inactive stops it being asked for
                        at all, without losing what has already been uploaded.
                    </span>
                </div>
                <button type="button" class="cg-action-btn cg-good" @onclick="StartAdd">+ Add document</button>
            </div>

            <div class="cg-table-wrap">
                <table class="cg-table">
                    <thead>
                        <tr>
                            <th scope="col">Document name</th>
                            <th scope="col">Requirement</th>
                            <th scope="col">Status</th>
                            <th scope="col">On file</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _types)
                        {
                            <tr class="@(type.IsActive ? "" : "cg-row-muted")">
                                <td>
                                    <input class="cg-input" maxlength="120" value="@type.Name"
                                           aria-label="@($"Name of {type.Name}")"
                                           @onchange="e => RenameAsync(type, (string?)e.Value)" />
                                    <input class="cg-input cg-input-subtle" maxlength="300" value="@type.Description"
                                           placeholder="What is wanted (optional)"
                                           aria-label="@($"Description of {type.Name}")"
                                           @onchange="e => RedescribeAsync(type, (string?)e.Value)" />
                                </td>
                                <td>
                                    <select class="cg-input" value="@(type.IsMandatory ? "required" : "optional")"
                                            aria-label="@($"Requirement for {type.Name}")"
                                            @onchange="e => SetMandatoryAsync(type, e.Value)">
                                        <option value="required">Required</option>
                                        <option value="optional">Optional</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="cg-input" value="@(type.IsActive ? "active" : "inactive")"
                                            aria-label="@($"Status of {type.Name}")"
                                            @onchange="e => SetActiveAsync(type, e.Value)">
                                        <option value="active">Active</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                </td>
                                <td>
                                    <span class="cg-result-count">@UploadCount(type.Id)</span>
                                </td>
                                <td>
                                    @if (type.IsBuiltIn)
                                    {
                                        @* Built-ins are the name over code written for that document -- the
                                           capture wiring and the declaration's own columns. Renaming and
                                           switching off are the whole of what can safely be done to them. *@
                                        <span class="cg-pill" title="Read automatically. Can be renamed or switched off, but not removed.">Built-in</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="cg-action-btn cg-critical"
                                                @onclick="() => _pendingDelete = type">Remove</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="cg-subtitle">
                Only Emirates ID, passport and trade licence are read automatically — those three have
                a trained model behind them. A document added here takes a file, a number and an expiry
                date, typed in.
            </p>
        </section>
    }
</div>

@if (_adding)
{
    <div class="cg-print-overlay">
        <div class="cg-confirm-modal">
            <h3>Add a document</h3>
            <label class="cg-field">
                <span>Document name <span class="cg-required" aria-hidden="true">*</span></span>
                <input class="cg-input" maxlength="120" @bind="_newName" @bind:event="oninput" aria-required="true" />
            </label>
            <label class="cg-field">
                <span>What is wanted</span>
                <input class="cg-input" maxlength="300" @bind="_newDescription" placeholder="Optional" />
            </label>
            <label class="cg-field">
                <span>Requirement</span>
                <select class="cg-input" @bind="_newMandatory">
                    <option value="false">Optional</option>
                    <option value="true">Required</option>
                </select>
            </label>
            <div class="cg-actions">
                <button type="button" class="cg-action-btn" @onclick="CancelAdd">Cancel</button>
                <button type="button" class="cg-action-btn cg-good" disabled="@_saving" @onclick="AddAsync">Add</button>
            </div>
        </div>
    </div>
}

@if (_pendingDelete is not null)
{
    <div class="cg-print-overlay">
        <div class="cg-confirm-modal">
            <h3>Remove “@_pendingDelete.Name”?</h3>
            <p class="cg-confirm-detail">
                It stops being asked for and is gone from the list. If anyone has already uploaded one,
                this is refused — set it to Inactive instead, which keeps their files readable.
            </p>
            <div class="cg-actions">
                <button type="button" class="cg-action-btn" @onclick="() => _pendingDelete = null">Cancel</button>
                <button type="button" class="cg-action-btn cg-critical" disabled="@_saving" @onclick="DeleteAsync">Remove</button>
            </div>
        </div>
    </div>
}
