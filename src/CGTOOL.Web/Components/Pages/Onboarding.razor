@page "/onboarding"
@attribute [Authorize]
@layout OnboardingLayout
@rendermode InteractiveServer
@using CGTOOL.Web.Components.Layout
@inject IMemberOnboardingService Flow
@inject IDocumentStore Documents
@inject IDocumentIntelligenceService DocIntel
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject ActingAsCookie ActingAs
@inject IHttpContextAccessor HttpContextAccessor
@inject ClientContext Client
@inject Branding Branding
@inject NavigationManager Nav

<PageTitle>Welcome</PageTitle>

<div class="cg-onboarding-card">
@if (_loading)
{
    <p class="cg-onboarding-lead">Loading…</p>
}
else if (_member is null)
{
    <h1>We could not find your record</h1>
    <p class="cg-onboarding-lead">
        You are signed in, but there is no member record for this account yet. Contact an
        administrator and they will set one up.
    </p>
}
else
{
    @if (_step != OnboardingStep.Welcome)
    {
        <ol class="cg-onboarding-steps">
            @foreach (var (step, label) in Rail)
            {
                <li class="@StepClass(step)">
                    @if (CanGoTo(step))
                    {
                        <button type="button" class="cg-onboarding-step-btn" disabled="@_busy"
                                title="Go back to @label" @onclick="() => GoTo(step)">@label</button>
                    }
                    else
                    {
                        <span>@label</span>
                    }
                </li>
            }
        </ol>
    }

    @switch (CurrentStep)
    {
        case OnboardingStep.Welcome:
            <svg class="cg-onboarding-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2.5 4 6v6c0 4.6 3.2 8.6 8 9.5 4.8-.9 8-4.9 8-9.5V6l-8-3.5Z" />
                <path d="m8.8 12 2.2 2.2 4.2-4.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h1>Welcome to @Branding.ParentHoldingCompany</h1>
            <p class="cg-onboarding-lead">Corporate Governance System</p>

            <p>Welcome, @_member.FullName.</p>
            <p>
                Before you start your declarations, we need a few minutes to complete your initial
                onboarding.
            </p>
            <p>
                It takes no more than <strong>five minutes</strong> and involves checking the
                Emirates ID and Dubai Financial Market details we already hold for you — or giving
                them to us if we do not have them.
            </p>

            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good" disabled="@_busy" @onclick="StartAsync">
                    Start onboarding
                </button>
            </div>
            break;

        case OnboardingStep.EmiratesId when _record!.EmiratesIdSource == OnboardingSource.Reference && !_editingEmiratesId:
            <h2>Step 1 — Check your Emirates ID</h2>
            <p>Please check these details and confirm they are correct.</p>

            @if (_record.EmiratesIdBlobId is int cardBlob)
            {
                <div class="cg-onboarding-source">
                    <span>📄</span>
                    <div>
                        <strong>The copy we hold</strong><br />
                        <a href="@DocumentUrl.For(cardBlob, null)" target="_blank" rel="noopener">Open it</a>
                    </div>
                </div>
            }

            <dl class="cg-onboarding-readback">
                <dt>Name on the card</dt>
                <dd>@Show(_record.EmiratesIdHolderName)</dd>
                <dt>Emirates ID number</dt>
                <dd>@Show(_record.EmiratesIdNumber)</dd>
                @if (!string.IsNullOrWhiteSpace(_record.EmiratesIdNationality))
                {
                    <dt>Nationality</dt>
                    <dd>@_record.EmiratesIdNationality</dd>
                }
                @if (_record.EmiratesIdExpiryDate is { } expiry)
                {
                    <dt>Expiry date</dt>
                    <dd>@expiry.ToString("dd/MM/yyyy")</dd>
                }
            </dl>

            @if (DocumentExpiry.IsExpired(_record.EmiratesIdExpiryDate))
            {
                @* Raised here rather than left to the first declaration: this is the screen where
                   the member is looking at the card, and where there is still time to replace it
                   before a deadline is involved. It does not stop them finishing onboarding. *@
                <div class="cg-onboarding-alert">
                    <strong>This Emirates ID has expired.</strong>
                    <span>
                        It expired on @_record.EmiratesIdExpiryDate!.Value.ToString("dd/MM/yyyy"). Please upload a
                        valid Emirates ID in My&nbsp;Workspace. You can still confirm these details and finish
                        onboarding now.
                    </span>
                </div>
            }

            <p><strong>Is the above correct?</strong></p>
            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good" disabled="@_busy" @onclick="ConfirmEmiratesIdAsync">
                    Yes, confirm
                </button>
                <button type="button" class="cg-action-btn" disabled="@_busy" @onclick="BeginEditEmiratesId">
                    No, I need to change it
                </button>
            </div>
            break;

        case OnboardingStep.EmiratesId when _editingEmiratesId:
            <h2>Correct your Emirates ID</h2>
            <p>
                Change whatever is wrong and continue. What you enter is recorded as yours and
                marked for checking; what we held before is kept alongside it.
            </p>

            @if (_record.EmiratesIdBlobId is int editBlob)
            {
                <div class="cg-onboarding-source">
                    <span>📄</span>
                    <div>
                        <strong>The copy we hold</strong><br />
                        <a href="@DocumentUrl.For(editBlob, null)" target="_blank" rel="noopener">Open it</a>
                    </div>
                </div>
            }

            @* This screen let the member correct every field except the one thing that settles
               them: the card itself. If what we hold is the wrong person's card, or unreadable,
               retyping the number around it does not fix the record. Same control, same reader
               and same limit as the upload step -- a member correcting their details can replace
               the copy here instead of being told to contact somebody. *@
            <div class="cg-field">
                <span>@(_record.EmiratesIdBlobId is null ? "Upload your Emirates ID" : "Replace the copy we hold")</span>
                <InputFile OnChange="UploadCardAsync" accept=".pdf" disabled="@_busy" />

                @if (_uploading)
                {
                    <div class="cg-onboarding-upload">
                        @if (_uploadPercent is { } editPercent)
                        {
                            <CgProgressBar Percent="editPercent" Label="@_uploadStage" />
                        }
                        else
                        {
                            <CgBusy Title="@(_uploadStage ?? "Working…")" />
                        }
                    </div>
                }
                else
                {
                    <p class="cg-hint">One PDF containing both sides of the card, up to @UploadLimits.DocumentLimit. Optional — leave it if the copy we hold is correct.</p>
                }
            </div>

            @if (_captureNote is not null) { <p class="cg-hint">@_captureNote</p> }

            <label class="cg-field">
                <span>Name on the card</span>
                <input class="cg-input" maxlength="200" @bind="_record.EmiratesIdHolderName" />
            </label>
            <label class="cg-field">
                <span>Emirates ID number</span>
                <input class="cg-input@(EmiratesIdNumber.IsInvalidEntry(_record.EmiratesIdNumber) ? " cg-input-invalid" : EmiratesIdNumber.IsComplete(_record.EmiratesIdNumber) ? " cg-input-valid" : "")"
                       maxlength="20" inputmode="numeric" placeholder="784 followed by 12 digits"
                       @bind="_record.EmiratesIdNumber" @bind:event="oninput" />
                @if (EmiratesIdNumber.IsInvalidEntry(_record.EmiratesIdNumber))
                {
                    <span class="cg-field-error">@EmiratesIdNumber.Hint</span>
                }
                else if (EmiratesIdNumber.IsComplete(_record.EmiratesIdNumber))
                {
                    <span class="cg-field-ok" role="status">&#10003; Complete</span>
                }
            </label>
            <label class="cg-field">
                <span>Nationality</span>
                <select class="cg-input" @bind="_record.EmiratesIdNationality">
                    <option value="">—</option>
                    @foreach (var country in Countries.All)
                    {
                        <option value="@country">@country</option>
                    }
                </select>
            </label>
            <label class="cg-field">
                <span>Expiry date</span>
                <input type="date" class="cg-input" @bind="_record.EmiratesIdExpiryDate" />
            </label>

            @if (_editNote is not null) { <p class="cg-error">@_editNote</p> }

            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good"
                        disabled="@(_busy || !EmiratesIdNumber.IsValid(_record.EmiratesIdNumber))" @onclick="SaveEmiratesIdAsync">
                    Save and continue
                </button>
                <button type="button" class="cg-action-btn" disabled="@_busy" @onclick="CancelEmiratesIdEdit">
                    Cancel
                </button>
            </div>
            break;

        case OnboardingStep.EmiratesId:
            <h2>Step 1 — Your Emirates ID</h2>
            <p>We do not have your Emirates ID on file. Please upload a copy to continue.</p>

            <div class="cg-field">
                <span>Your Emirates ID</span>
                <InputFile OnChange="UploadCardAsync" accept=".pdf" disabled="@_busy" />

                @if (_uploading)
                {
                    <div class="cg-onboarding-upload">
                        @if (_uploadPercent is { } percent)
                        {
                            <CgProgressBar Percent="percent" Label="@_uploadStage" />
                        }
                        else
                        {
                            <CgBusy Title="@(_uploadStage ?? "Working…")" />
                        }
                    </div>
                }
                else
                {
                    <p class="cg-hint">
                        @if (_record!.EmiratesIdBlobId is not null)
                        {
                            <span>Uploaded.</span>
                        }
                        else
                        {
                            <span>One PDF containing both sides of the card, up to @UploadLimits.DocumentLimit.</span>
                        }
                    </p>
                }
            </div>

            <label class="cg-field">
                <span>Name as it appears on the card</span>
                <input class="cg-input" maxlength="200" @bind="_record.EmiratesIdHolderName" />
            </label>
            <label class="cg-field">
                <span>Emirates ID number</span>
                <input class="cg-input@(EmiratesIdNumber.IsInvalidEntry(_record.EmiratesIdNumber) ? " cg-input-invalid" : EmiratesIdNumber.IsComplete(_record.EmiratesIdNumber) ? " cg-input-valid" : "")"
                       maxlength="20" inputmode="numeric" placeholder="784 followed by 12 digits"
                       @bind="_record.EmiratesIdNumber" @bind:event="oninput" />
                @if (EmiratesIdNumber.IsInvalidEntry(_record.EmiratesIdNumber))
                {
                    <span class="cg-field-error">@EmiratesIdNumber.Hint</span>
                }
                else if (EmiratesIdNumber.IsComplete(_record.EmiratesIdNumber))
                {
                    <span class="cg-field-ok" role="status">&#10003; Complete</span>
                }
            </label>
            <label class="cg-field">
                <span>Expiry date</span>
                <input type="date" class="cg-input" @bind="_record.EmiratesIdExpiryDate" />
            </label>

            @if (_captureNote is not null) { <p class="cg-hint">@_captureNote</p> }

            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good" disabled="@(_busy || !CanSubmitCard)" @onclick="SubmitEmiratesIdAsync">
                    Submit and continue
                </button>
            </div>
            <p class="cg-onboarding-note">
                What you give us is recorded as yours and marked for checking. It does not replace
                anything already held.
            </p>
            break;

        case OnboardingStep.Dfm when _record!.DfmSource == OnboardingSource.Reference && !_editingDfm:
            <h2>Step 2 — Check your DFM details</h2>
            <p>Please check your Dubai Financial Market registration details.</p>

            <dl class="cg-onboarding-readback">
                <dt>National Investor Number (NIN)</dt>
                <dd>@Show(_record.NinNumber)</dd>
                <dt>Registered name</dt>
                <dd>@Show(_record.NinRegisteredName)</dd>
            </dl>

            <p><strong>Is the above correct?</strong></p>
            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good" disabled="@_busy" @onclick="ConfirmDfmAsync">
                    Yes, confirm
                </button>
                <button type="button" class="cg-action-btn" disabled="@_busy" @onclick="BeginEditDfm">
                    No, I need to change it
                </button>
            </div>
            break;

        case OnboardingStep.Dfm when _editingDfm:
            <h2>Correct your DFM details</h2>
            <p>
                Change whatever is wrong and continue. What you enter is recorded as yours and
                marked for checking.
            </p>

            <label class="cg-field">
                <span>National Investor Number (NIN)</span>
                <input class="cg-input@(Nin.IsInvalidEntry(_record.NinNumber) ? " cg-input-invalid" : Nin.IsComplete(_record.NinNumber) ? " cg-input-valid" : "")"
                       maxlength="@Nin.Length" minlength="@Nin.Length" placeholder="10 letters or digits"
                       @bind="_record.NinNumber" @bind:event="oninput" />
                @if (Nin.IsInvalidEntry(_record.NinNumber))
                {
                    <span class="cg-field-error">@Nin.Hint</span>
                }
                else if (Nin.IsComplete(_record.NinNumber))
                {
                    <span class="cg-field-ok" role="status">&#10003; Complete</span>
                }
            </label>
            <label class="cg-field">
                <span>Registered name with DFM</span>
                <input class="cg-input" maxlength="200" @bind="_record.NinRegisteredName" />
            </label>

            @if (_editNote is not null) { <p class="cg-error">@_editNote</p> }

            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good"
                        disabled="@(_busy || !Nin.IsValid(_record.NinNumber))" @onclick="SaveDfmAsync">
                    Save and continue
                </button>
                <button type="button" class="cg-action-btn" disabled="@_busy" @onclick="CancelDfmEdit">
                    Cancel
                </button>
            </div>
            break;

        case OnboardingStep.Dfm:
            <h2>Step 2 — Your DFM details</h2>
            <p>We could not find Dubai Financial Market registration details for you.</p>
            <p><strong>Do you have a National Investor Number (NIN) registered with DFM?</strong></p>

            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn @(_hasNin == true ? "cg-good" : "")" disabled="@_busy"
                        @onclick="() => _hasNin = true">
                    Yes, I have a NIN
                </button>
                <button type="button" class="cg-action-btn @(_hasNin == false ? "cg-good" : "")" disabled="@_busy"
                        @onclick="() => _hasNin = false">
                    No, I do not
                </button>
            </div>

            @if (_hasNin == true)
            {
                <div style="margin-top:22px;">
                    <label class="cg-field">
                        <span>National Investor Number (NIN)</span>
                        <input class="cg-input@(Nin.IsInvalidEntry(_record!.NinNumber) ? " cg-input-invalid" : Nin.IsComplete(_record.NinNumber) ? " cg-input-valid" : "")"
                               maxlength="@Nin.Length" minlength="@Nin.Length" placeholder="10 letters or digits"
                               @bind="_record.NinNumber" @bind:event="oninput" />
                        @if (Nin.IsInvalidEntry(_record.NinNumber))
                        {
                            <span class="cg-field-error">@Nin.Hint</span>
                        }
                        else if (Nin.IsComplete(_record.NinNumber))
                        {
                            <span class="cg-field-ok" role="status">&#10003; Complete</span>
                        }
                    </label>
                    <label class="cg-field">
                        <span>Registered name with DFM</span>
                        <input class="cg-input" maxlength="200" @bind="_record.NinRegisteredName" />
                    </label>
                    <div class="cg-field">
                        <span>NIN confirmation or DFM statement <em>(optional)</em></span>
                        <InputFile OnChange="UploadNinDocumentAsync" accept=".pdf,.jpg,.jpeg,.png" disabled="@_busy" />
                        @if (_uploading)
                        {
                            <div class="cg-onboarding-upload">
                                @if (_uploadPercent is { } ninPercent)
                                {
                                    <CgProgressBar Percent="ninPercent" Label="@_uploadStage" />
                                }
                                else
                                {
                                    <CgBusy Title="@(_uploadStage ?? "Working…")" />
                                }
                            </div>
                        }
                        else if (_record.NinDocumentBlobId is not null) { <p class="cg-hint">Uploaded.</p> }
                    </div>

                    <div class="cg-onboarding-actions">
                        <button type="button" class="cg-action-btn cg-good"
                                disabled="@(_busy || !Nin.IsValid(_record.NinNumber))" @onclick="SubmitNinAsync">
                            Submit and continue
                        </button>
                    </div>
                </div>
            }
            else if (_hasNin == false)
            {
                <div style="margin-top:22px;">
                    <p>We will record that you do not have a NIN. You can tell us later if that changes.</p>
                    <div class="cg-onboarding-actions">
                        <button type="button" class="cg-action-btn cg-good" disabled="@_busy" @onclick="RecordNoNinAsync">
                            Continue
                        </button>
                    </div>
                </div>
            }
            break;

        case OnboardingStep.Done when _record!.Status != OnboardingStatus.Completed:
            <span class="cg-onboarding-done-mark">🎉</span>
            <h1>That is everything</h1>
            <p class="cg-onboarding-lead">Thank you for checking your details.</p>
            <div class="cg-onboarding-actions">
                <button type="button" class="cg-action-btn cg-good" disabled="@_busy" @onclick="CompleteAsync">
                    Finish onboarding
                </button>
            </div>
            <p class="cg-onboarding-note">
                Need to change something? Go back to
                <button type="button" class="cg-onboarding-link" disabled="@_busy"
                        @onclick="() => GoTo(OnboardingStep.EmiratesId)">your Emirates ID</button>
                or
                <button type="button" class="cg-onboarding-link" disabled="@_busy"
                        @onclick="() => GoTo(OnboardingStep.Dfm)">your DFM details</button>.
                Nothing is final until you finish.
            </p>
            break;

        default:
            <span class="cg-onboarding-done-mark">🎉</span>
            <h1>Congratulations</h1>
            <p class="cg-onboarding-lead">Your onboarding is complete.</p>
            <p>
                Your Emirates ID and Dubai Financial Market details have been recorded in the
                @Branding.ParentHoldingCompany Corporate Governance System, and added to your
                My&nbsp;Workspace so you will not be asked for them again.
            </p>
            <p>You can now go to your dashboard and complete the declarations assigned to you.</p>
            <div class="cg-onboarding-actions">
                <a class="cg-action-btn cg-good" href="@ReturnTarget">@ReturnLabel</a>
            </div>
            break;
    }
}
</div>
