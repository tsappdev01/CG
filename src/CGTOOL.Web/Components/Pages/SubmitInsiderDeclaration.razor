@page "/declarations/insider-trading"
@page "/declarations/insider-trading/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IInsiderDeclarationWriter Writer
@inject IFamilyMemberWriter FamilyMemberWriter
@inject IActivityEmailSender EmailSender
@inject SqlDbMailSender SqlMail
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ImpersonationContext Impersonation
@inject ToastService Toasts
@inject IWebHostEnvironment Env
@inject IDocumentIntelligenceService DocIntel
@inject Branding Branding

<PageTitle>Insider Trading Declaration</PageTitle>

<div class="cg-shell cg-declaration-wizard">
    @* The one operation on this page where a second click or a closed tab costs something
       real, so it takes the screen rather than only the button. *@
    <CgBlockingOverlay Visible="_submitting"
                       Title="@(_hadExistingRow ? "Saving your changes…" : "Submitting your declaration…")"
                       Detail="Recording your declaration and preparing your PDF copy. Please do not close this page." />

    <p><a href="/my-declarations">← Back to Declarations</a></p>
    <h1 data-icon="doc">Declaration of Transactions in DI Shares by Insiders</h1>
    <p class="cg-subtitle">Employee Name: <b>@_effectiveMember?.FullName</b></p>
    @if (Impersonation.ActingMemberId is not null)
    {
        <p class="cg-subtitle">Submitting on behalf of <b>@Impersonation.ActingMemberName</b>.</p>
    }

    @if (_step == Step.Loading)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else if (_step == Step.NoAccess)
    {
        <div class="cg-empty-state">
            @(_effectiveMember is null
                ? "Your login isn't linked to a User record yet. Ask an Administrator to link your account on the User Management page."
                : "You don't have Insider Trading declaration access assigned. Ask an Administrator to grant it on your User record.")
        </div>
    }
    else if (_step == Step.NotDue)
    {
        <div class="cg-empty-state">No Insider Trading declaration is currently due for @_effectiveMember!.FullName.</div>
    }
    else if (_step == Step.EditWindowClosed)
    {
        <div class="cg-empty-state">
            The due date for this declaration has passed, so the declaration you submitted can no longer be edited.
            It stands as filed — the audit trail holds what was submitted and when.
        </div>
    }
    else
    {
        var period = PeriodRange();
        <p class="cg-subtitle">
            I, @_effectiveMember!.FullName, have read the Securities Dealing Policy including the relevant section on Material Price Sensitive
            Information (<a href="@PolicyDocumentLink.CurrentUrl(Env)" target="_blank">Link to Policy</a>) and hereby confirm that I have wholly complied with the
            policies. Accordingly, I report the following in compliance with the Securities Dealing Policy during the period
            @period.From.ToString("dd-MM-yyyy") till @period.To.ToString("dd-MM-yyyy").
        </p>

        @if (_step == Step.Capture1 || _step == Step.Capture2 || _step == Step.Review)
        {
            <div class="cg-step-head">
                <p class="cg-subtitle">
                    @(_isEditing ? "Editing your submitted declaration. " : "")Due date: <b class="mono">@_run!.DueDateUtc.ToLocalDisplay("dd/MM/yyyy")</b>
                </p>
                @if (_draftSavedAtUtc is { } savedAt)
                {
                    <span class="cg-draft-pill">Draft saved at @savedAt.ToLocalDisplay("HH:mm")</span>
                }
            </div>

            @* Three steps, so the member can see how much is left rather than discovering it. *@
            <ol class="cg-stepper" aria-label="Progress">
                <li class="cg-step @(_step == Step.Capture1 ? "is-current" : "is-done")">
                    <span class="cg-step-num">1</span>
                    <span class="cg-step-label">Personal details</span>
                </li>
                <li class="cg-step-rule @(_step == Step.Capture1 ? "" : "is-done")" aria-hidden="true"></li>
                <li class="cg-step @(_step == Step.Capture2 ? "is-current" : _step == Step.Review ? "is-done" : "")">
                    <span class="cg-step-num">2</span>
                    <span class="cg-step-label">Documents &amp; shareholding</span>
                </li>
                <li class="cg-step-rule @(_step == Step.Review ? "is-done" : "")" aria-hidden="true"></li>
                <li class="cg-step @(_step == Step.Review ? "is-current" : "")">
                    <span class="cg-step-num">3</span>
                    <span class="cg-step-label">Review &amp; submit</span>
                </li>
            </ol>
        }

        @if (_step == Step.Capture1)
        {
            <div class="cg-member-form cg-declaration-form">
                <label class="cg-field">
                    <span>1. Do you have a National Investor Number (NIN)?</span>
                    <div class="cg-yesno">
                        <button type="button" class="cg-action-btn @(_hasNin ? "cg-good" : "")" @onclick="() => _hasNin = true">Yes, I have a NIN</button>
                        <button type="button" class="cg-action-btn @(!_hasNin ? "cg-good" : "")" @onclick="() => _hasNin = false">I don't have a NIN</button>
                    </div>
                </label>
                @if (_hasNin)
                {
                    <label class="cg-field">
                        <span>NIN Number</span>
                        <input class="cg-input cg-input-short@(NinFieldClass(_ninNumber))" @bind="_ninNumber" @bind:event="oninput"
                               maxlength="@Nin.Length" minlength="@Nin.Length" placeholder="10 letters or digits" />
                        @if (Nin.IsInvalidEntry(_ninNumber))
                        {
                            <span class="cg-field-error">@Nin.Hint</span>
                        }
                        else if (Nin.IsComplete(_ninNumber))
                        {
                            <span class="cg-field-ok" role="status">&#10003; Complete</span>
                        }
                        @if (_ninFromDfm)
                        {
                            <span class="cg-hint">From your DFM record in My Workspace — change it here if it is out of date.</span>
                        }
                    </label>
                }

                <label class="cg-field">
                    <span>2. Do your relatives have a National Investor Number (NIN)? <em class="cg-subtitle" style="margin:0;">(Father, Mother, Brother, Sister, Children, Spouse, Father-in-Law, Mother-in-Law, Stepchildren)</em></span>
                    <div class="cg-yesno">
                        <button type="button" class="cg-action-btn @(_relativesHaveNin ? "cg-good" : "")" @onclick="() => ChooseRelativesHaveNinAsync(true)">Yes, my relatives have a NIN</button>
                        <button type="button" class="cg-action-btn @(!_relativesHaveNin ? "cg-good" : "")" @onclick="() => ChooseRelativesHaveNinAsync(false)">No, my relatives do not have a NIN</button>
                    </div>
                </label>

                @if (_relativesHaveNin)
                {
                    <div class="cg-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Share Held By</th>
                                    <th>Name of Share Holder</th>
                                    <th>NIN</th>
                                    <th>Additional</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _ninHolders)
                                {
                                    <tr class="cg-data-row">
                                        <td>
                                            <select class="cg-input" @bind="h.Relationship">
                                                @foreach (var opt in RelativeOptions)
                                                {
                                                    <option value="@opt.Value">@opt.Label</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="cg-input" @bind="h.NameOfShareHolder" maxlength="120" /></td>
                                        <td>
                                            <input class="cg-input cg-input-short@(NinFieldClass(h.NinNumber))" @bind="h.NinNumber" @bind:event="oninput"
                                                   maxlength="@Nin.Length" minlength="@Nin.Length" placeholder="10 characters" />
                                            @if (Nin.IsInvalidEntry(h.NinNumber))
                                            {
                                                <span class="cg-field-error">@Nin.Hint</span>
                                            }
                                            else if (Nin.IsComplete(h.NinNumber))
                                            {
                                                <span class="cg-field-ok" role="status">&#10003;</span>
                                            }
                                        </td>
                                        <td><input class="cg-input" @bind="h.Additional" maxlength="400" /></td>
                                        <td><button type="button" class="cg-action-btn cg-critical" @onclick="() => RemoveNinHolderAsync(h)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="AddNinHolderAsync">+ Add relative</button>
                        <button type="button" class="cg-action-btn cg-good" @onclick="() => PullRelativesFromWorkspaceAsync(false)">Load from My Workspace</button>
                    </div>
                    <p class="cg-hint">Your relatives with a NIN in My Workspace are loaded here for you. Use the button to load again after adding one there; rows already here are never touched.</p>
                }

                <div class="cg-actions">
                    <button type="button" class="cg-action-btn cg-good" @onclick="GoToCapture2Async">Next</button>
                </div>

                @if (_offerWorkspaceSave)
                {
                    <ConfirmPrompt Show="true"
                                   Message="Add these relatives to My Workspace as well?"
                                   Detail="@($"{string.Join(", ", _newToWorkspace.Select(r => r.NameOfShareHolder))} — not recorded there yet. Saved once, they can be pulled into every future declaration instead of retyped.")"
                                   ConfirmLabel="Add to My Workspace"
                                   CancelLabel="Not now"
                                   OnConfirm="AcceptWorkspaceSaveAsync"
                                   OnCancel="DeclineWorkspaceSave" />
                }

                <ConfirmPrompt Show="_pendingCapture1Confirm"
                               Message="Please confirm all information entered above is correct before proceeding — you can still come back and edit it, but double-check now."
                               ConfirmLabel="All information is correct — proceed"
                               OnConfirm="ConfirmCapture1Async"
                               OnCancel="CancelCapture1Confirm" />
            </div>
        }
        else if (_step == Step.Capture2)
        {
            <div class="cg-member-form cg-declaration-form">
                <h2 class="cg-section-heading">Document Upload</h2>
                <p class="cg-subtitle">
                    Accepted file formats: JPG, PNG, PDF only. Maximum size 1 MB.
                    @(DocIntel.IsConfigured ? " Fields below will auto-fill from the uploaded Emirates ID / Passport / Trade Licence — please verify before continuing." : "")
                </p>

                @if (_offerDocumentPull)
                {
                    <ConfirmPrompt Show="true"
                                   Message="Load these from My Documents?"
                                   Detail="@($"{string.Join(", ", _pullableDocuments.Select(DocumentPullLabel))} — the file and the details it holds. This declaration keeps its own copy, so changing the document in My Workspace later will not change what you declared here.")"
                                   ConfirmLabel="Load them"
                                   CancelLabel="Not now"
                                   OnConfirm="AcceptDocumentPullAsync"
                                   OnCancel="DeclineDocumentPull" />
                }

                <div class="cg-source-banner">
                    <div class="cg-source-banner-text">
                        <span class="cg-source-banner-title">
                            @(WorkspaceLoadedCount > 0
                                ? $"{WorkspaceLoadedCount} document{(WorkspaceLoadedCount == 1 ? "" : "s")} loaded from My Workspace"
                                : "Nothing loaded from My Workspace yet")
                        </span>
                        <span class="cg-subtitle">Check that each detail below matches your document. Added something new to My Workspace? Reload to pull it in.</span>
                    </div>
                    <button type="button" class="cg-action-btn cg-good" @onclick="OfferDocumentPullAsync">Reload from My Workspace</button>
                </div>

                <h2 class="cg-section-heading">Identity documents</h2>
                <div class="cg-doc-cards">

                    @if (ShowDocument(MemberDocumentKind.EmiratesId))
                    {
                    @* Emirates ID *@
                    <div class="cg-doc-card @(IsExpiredOn(_emiratesIdExpiryDate) ? "is-expired" : "")">
                        <div class="cg-doc-card-head">
                            <span class="cg-doc-card-name">@DocumentName(MemberDocumentKind.EmiratesId, "Emirates ID")</span>
                            <span class="cg-pill @(RequiredDocument(MemberDocumentKind.EmiratesId) ? "cg-pill-required" : "")">@RequirementLabel(MemberDocumentKind.EmiratesId)</span>
                            <span class="cg-pill cg-pill-status @(HasEmiratesId ? "cg-pill-done" : "")">@(HasEmiratesId ? "Uploaded" : "Not uploaded")</span>
                        </div>
                        <div class="cg-doc-card-source">
                            <span>
                                @(_loadedFromWorkspace.Contains(MemberDocumentKind.EmiratesId)
                                    ? "Loaded from My Workspace"
                                    : HasEmiratesId ? "Uploaded here" : "JPG, PNG or PDF, up to 1 MB")
                            </span>
                            <span class="cg-doc-card-actions">
                                @if (HasEmiratesId)
                                {
                                    <a class="cg-doc-chip" href="@_emiratesIdPath" target="_blank" rel="noopener">View</a>
                                    @if (DocIntel.IsConfigured)
                                    {
                                        <button type="button" class="cg-doc-chip" disabled="@_rereadingEmiratesId" @onclick="ReadEmiratesIdAgainAsync">
                                            @if (_rereadingEmiratesId)
                                            {
                                                <CgSpinner /><span> Reading…</span>
                                            }
                                            else
                                            {
                                                <span>Read details</span>
                                            }
                                        </button>
                                    }
                                }
                                <InputFile OnChange="OnEmiratesIdSelectedAsync" accept=".png,.jpg,.jpeg,.pdf" disabled="@_uploadingEmiratesId" />
                            </span>
                        </div>
                        @if (_uploadingEmiratesId)
                        {
                            <CgProgressBar Label="Uploading…" Percent="_emiratesIdUploadProgress" />
                        }
                        else if (_emiratesIdExpiredNeedsReupload && !HasEmiratesId)
                        {
                            <p class="cg-error">Your Emirates ID on file has expired — please upload a current copy.</p>
                        }
                        <div class="cg-doc-card-fields">
                            <label class="cg-field cg-field-wide">
                                <span>Full name (as on ID)</span>
                                <input class="cg-input" @bind="_emiratesIdNameOnCard" maxlength="120" />
                            </label>
                            <label class="cg-field">
                                <span>ID number</span>
                                <input class="cg-input" @bind="_emiratesIdNumber" maxlength="40" />
                            </label>
                            <label class="cg-field">
                                <span>Expiry date</span>
                                <UaeDateInput CssClass="@(IsExpiredOn(_emiratesIdExpiryDate) ? "cg-input-invalid" : null)"
                                              Value="_emiratesIdExpiryDate"
                                              ValueChanged="d => _emiratesIdExpiryDate = d" />
                            </label>
                        </div>
                        @if (IsExpiredOn(_emiratesIdExpiryDate))
                        {
                            <p class="cg-error">Expired on @UaeDate.Show(_emiratesIdExpiryDate) — upload a current Emirates ID here, and update it in My Workspace.</p>
                        }
                    </div>

                    }
                    @if (ShowDocument(MemberDocumentKind.Passport))
                    {
                    @* Passport *@
                    <div class="cg-doc-card @(IsExpiredOn(_passportExpiryDate) ? "is-expired" : "")">
                        <div class="cg-doc-card-head">
                            <span class="cg-doc-card-name">@DocumentName(MemberDocumentKind.Passport, "Passport")</span>
                            <span class="cg-pill @(RequiredDocument(MemberDocumentKind.Passport) ? "cg-pill-required" : "")">@RequirementLabel(MemberDocumentKind.Passport)</span>
                            <span class="cg-pill cg-pill-status @(HasPassport ? "cg-pill-done" : "")">@(HasPassport ? "Uploaded" : "Not uploaded")</span>
                        </div>
                        <div class="cg-doc-card-source">
                            <span>
                                @(_loadedFromWorkspace.Contains(MemberDocumentKind.Passport)
                                    ? "Loaded from My Workspace"
                                    : HasPassport ? "Uploaded here" : "JPG, PNG or PDF, up to 1 MB")
                            </span>
                            <span class="cg-doc-card-actions">
                                @if (HasPassport)
                                {
                                    <a class="cg-doc-chip" href="@_passportPath" target="_blank" rel="noopener">View</a>
                                    @if (DocIntel.IsConfigured)
                                    {
                                        <button type="button" class="cg-doc-chip" disabled="@_rereadingPassport" @onclick="ReadPassportAgainAsync">
                                            @if (_rereadingPassport)
                                            {
                                                <CgSpinner /><span> Reading…</span>
                                            }
                                            else
                                            {
                                                <span>Read details</span>
                                            }
                                        </button>
                                    }
                                }
                                <InputFile OnChange="OnPassportSelectedAsync" accept=".png,.jpg,.jpeg,.pdf" disabled="@_uploadingPassport" />
                            </span>
                        </div>
                        @if (_uploadingPassport)
                        {
                            <CgProgressBar Label="Uploading…" Percent="_passportUploadProgress" />
                        }
                        else if (_passportExpiredNeedsReupload && !HasPassport)
                        {
                            <p class="cg-error">Your Passport on file has expired — please upload a current copy.</p>
                        }
                        <div class="cg-doc-card-fields">
                            <label class="cg-field">
                                <span>Nationality</span>
                                <input class="cg-input" @bind="_passportIssuingCountry" maxlength="80" />
                            </label>
                            <label class="cg-field">
                                <span>Passport number</span>
                                <input class="cg-input" @bind="_passportNumber" maxlength="40" />
                            </label>
                            <label class="cg-field cg-field-wide">
                                <span>Expiry date</span>
                                <UaeDateInput CssClass="@(IsExpiredOn(_passportExpiryDate) ? "cg-input-invalid" : null)"
                                              Value="_passportExpiryDate"
                                              ValueChanged="d => _passportExpiryDate = d" />
                            </label>
                        </div>
                        @if (IsExpiredOn(_passportExpiryDate))
                        {
                            <p class="cg-error">Expired on @UaeDate.Show(_passportExpiryDate) — upload a current passport here, and update it in My Workspace.</p>
                        }
                    </div>

                    }
                    @if (ShowDocument(MemberDocumentKind.TradeLicence))
                    {
                    @* Trade licence *@
                    <div class="cg-doc-card @(IsExpiredOn(_tradeLicenceExpiryDate) ? "is-expired" : "")">
                        <div class="cg-doc-card-head">
                            <span class="cg-doc-card-name">@DocumentName(MemberDocumentKind.TradeLicence, "Trade licence")</span>
                            <span class="cg-pill @(RequiredDocument(MemberDocumentKind.TradeLicence) ? "cg-pill-required" : "")">@RequirementLabel(MemberDocumentKind.TradeLicence)</span>
                            <span class="cg-pill cg-pill-status @(HasTradeLicence ? "cg-pill-done" : "")">@(HasTradeLicence ? "Uploaded" : "None added")</span>
                        </div>
                        <div class="cg-doc-card-source">
                            <span>
                                @(_loadedFromWorkspace.Contains(MemberDocumentKind.TradeLicence)
                                    ? "Loaded from My Workspace"
                                    : HasTradeLicence ? "Uploaded here" : "JPG, PNG or PDF, up to 1 MB")
                            </span>
                            <span class="cg-doc-card-actions">
                                @if (HasTradeLicence)
                                {
                                    <a class="cg-doc-chip" href="@_tradeLicencePath" target="_blank" rel="noopener">View</a>
                                    @if (DocIntel.IsConfigured)
                                    {
                                        <button type="button" class="cg-doc-chip" disabled="@_rereadingTradeLicence" @onclick="ReadTradeLicenceAgainAsync">
                                            @if (_rereadingTradeLicence)
                                            {
                                                <CgSpinner /><span> Reading…</span>
                                            }
                                            else
                                            {
                                                <span>Read details</span>
                                            }
                                        </button>
                                    }
                                }
                                <InputFile OnChange="OnTradeLicenceSelectedAsync" accept=".png,.jpg,.jpeg,.pdf" disabled="@_uploadingTradeLicence" />
                            </span>
                        </div>
                        @if (_uploadingTradeLicence)
                        {
                            <CgProgressBar Label="Uploading…" Percent="_tradeLicenceUploadProgress" />
                        }
                        else if (_tradeLicenceExpiredNeedsReupload && !HasTradeLicence)
                        {
                            <p class="cg-error">Your Trade Licence on file has expired — please upload a current copy.</p>
                        }
                        <div class="cg-doc-card-fields">
                            <label class="cg-field">
                                <span>Licence number</span>
                                <input class="cg-input" @bind="_tradeLicenceNumber" maxlength="40" />
                            </label>
                            <label class="cg-field">
                                <span>Expiry date</span>
                                <UaeDateInput CssClass="@(IsExpiredOn(_tradeLicenceExpiryDate) ? "cg-input-invalid" : null)"
                                              Value="_tradeLicenceExpiryDate"
                                              ValueChanged="d => _tradeLicenceExpiryDate = d" />
                            </label>
                            <label class="cg-field">
                                <span>Business name</span>
                                <input class="cg-input" @bind="_tradeLicenceLegalName" maxlength="160" />
                            </label>
                            <label class="cg-field">
                                <span>Issuing authority</span>
                                <input class="cg-input" @bind="_tradeLicenceIssuingAuthority" maxlength="160" />
                            </label>
                        </div>
                        @if (IsExpiredOn(_tradeLicenceExpiryDate))
                        {
                            <p class="cg-error">Expired on @UaeDate.Show(_tradeLicenceExpiryDate) — upload a current trade licence here, and update it in My Workspace.</p>
                        }
                    </div>

                    }
                    @if (ShowDocument(MemberDocumentKind.Other))
                    {
                    @* Other documents *@
                    <div class="cg-doc-card">
                        <div class="cg-doc-card-head">
                            <span class="cg-doc-card-name">@DocumentName(MemberDocumentKind.Other, "Other documents")</span>
                            <span class="cg-pill @(RequiredDocument(MemberDocumentKind.Other) ? "cg-pill-required" : "")">@RequirementLabel(MemberDocumentKind.Other)</span>
                            <span class="cg-pill cg-pill-status @(HasOtherDocument ? "cg-pill-done" : "")">@(HasOtherDocument ? "Uploaded" : "None added")</span>
                        </div>
                        <div class="cg-dropzone">
                            <span class="cg-dropzone-main">Choose a file to attach</span>
                            <span class="cg-subtitle">JPG, PNG or PDF, up to 1 MB</span>
                            <InputFile OnChange="OnOtherDocumentSelectedAsync" accept=".png,.jpg,.jpeg,.pdf" disabled="@_uploadingOtherDocument" />
                            @if (_uploadingOtherDocument)
                            {
                                <CgProgressBar Label="Uploading…" Percent="_otherDocumentUploadProgress" />
                            }
                            else if (HasOtherDocument)
                            {
                                <a class="cg-doc-chip" href="@_otherDocumentPath" target="_blank" rel="noopener">View attached file</a>
                            }
                        </div>
                    </div>
                    }

                    @* Documents an administrator added in the Document Centre. The three above have columns of
                       their own on the declaration and fields specific to them; these take a file, a reference
                       and an expiry date, and are stored as rows against the declaration. Nothing is read off
                       them -- there is no trained model for a document invented this afternoon. *@
                    @foreach (var type in AddedDocumentTypes)
                    {
                        var added = AddedDocumentFor(type.Id);
                        <div class="cg-doc-card @(IsExpiredOn(added.ExpiryDate) ? "is-expired" : "")">
                            <div class="cg-doc-card-head">
                                <span class="cg-doc-card-name">@type.Name</span>
                                <span class="cg-pill @(type.RequirementFor(DeclarationType.InsiderTrading) == DocumentRequirement.Required ? "cg-pill-required" : "")">@(type.RequirementFor(DeclarationType.InsiderTrading) == DocumentRequirement.Required ? "Required" : "Optional")</span>
                                <span class="cg-pill cg-pill-status @(string.IsNullOrWhiteSpace(added.FilePath) ? "" : "cg-pill-done")">@(string.IsNullOrWhiteSpace(added.FilePath) ? "Not uploaded" : "Uploaded")</span>
                            </div>
                            <div class="cg-doc-card-source">
                                <span>@(string.IsNullOrWhiteSpace(type.Description) ? "JPG, PNG or PDF, up to 1 MB" : type.Description)</span>
                                <span class="cg-doc-card-actions">
                                    @if (!string.IsNullOrWhiteSpace(added.FilePath))
                                    {
                                        <a class="cg-doc-chip" href="@added.FilePath" target="_blank" rel="noopener">View</a>
                                    }
                                    <InputFile OnChange="e => OnAddedDocumentSelectedAsync(type, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploadingType(type.Id)" />
                                </span>
                            </div>
                            @if (IsUploadingType(type.Id))
                            {
                                <CgProgressBar Label="Uploading…" Percent="TypeUploadProgress(type.Id)" />
                            }
                            <div class="cg-doc-card-fields">
                                <label class="cg-field">
                                    <span>Reference number</span>
                                    <input class="cg-input" @bind="added.DocumentNumber" maxlength="100" />
                                </label>
                                <label class="cg-field">
                                    <span>Expiry date</span>
                                    <UaeDateInput CssClass="@(IsExpiredOn(added.ExpiryDate) ? "cg-input-invalid" : null)"
                                                  Value="added.ExpiryDate"
                                                  ValueChanged="d => added.ExpiryDate = d" />
                                </label>
                            </div>
                        </div>
                    }

                </div>

                <h2 class="cg-section-heading">Do you or any of your relatives hold shares in @Branding.ParentHoldingCompany?</h2>
                <p class="cg-subtitle">Relatives: father, mother, brother, sister, children, spouse, father-in-law, mother-in-law, stepchildren.</p>

                <div class="cg-choice-cards" role="radiogroup" aria-label="@($"Do you or any of your relatives hold shares in {Branding.ParentHoldingCompany}?")">
                    <button type="button" role="radio" aria-checked="@_holdsSharesInDI"
                            class="cg-choice-card @(_holdsSharesInDI ? "is-picked" : "")"
                            @onclick="() => ChooseHoldsSharesAsync(true)">
                        <span class="cg-choice-dot" aria-hidden="true"></span>
                        <span class="cg-choice-text">
                            <span class="cg-choice-title">I / my relatives hold shares in DI</span>
                            <span class="cg-choice-sub">You will list the holdings below.</span>
                        </span>
                    </button>
                    <button type="button" role="radio" aria-checked="@(!_holdsSharesInDI)"
                            class="cg-choice-card @(!_holdsSharesInDI ? "is-picked" : "")"
                            @onclick="() => ChooseHoldsSharesAsync(false)">
                        <span class="cg-choice-dot" aria-hidden="true"></span>
                        <span class="cg-choice-text">
                            <span class="cg-choice-title">Neither I / my relatives hold shares in DI</span>
                            <span class="cg-choice-sub">You will go straight to review.</span>
                        </span>
                    </button>
                </div>
                @if (_holdsSharesInDI)
                {
                    <div class="cg-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Share Held By</th>
                                    <th>Name of Share Holder</th>
                                    <th>NIN</th>
                                    <th>Additional</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _relatives)
                                {
                                    <tr class="cg-data-row">
                                        <td>
                                            @if (r.IsSelf)
                                            {
                                                <span>Self</span>
                                            }
                                            else
                                            {
                                                <select class="cg-input" @bind="r.Relationship">
                                                    @foreach (var opt in RelativeOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            }
                                        </td>
                                        <td>
                                            @if (r.IsSelf)
                                            {
                                                <span>@_effectiveMember!.FullName</span>
                                            }
                                            else
                                            {
                                                <input class="cg-input" @bind="r.RelativeName" maxlength="120" />
                                            }
                                        </td>
                                        <td>
                                            <input class="cg-input cg-input-short@(NinFieldClass(r.NinNumber))" @bind="r.NinNumber" @bind:event="oninput"
                                                   maxlength="@Nin.Length" minlength="@Nin.Length" placeholder="10 characters" />
                                            @if (Nin.IsInvalidEntry(r.NinNumber))
                                            {
                                                <span class="cg-field-error">@Nin.Hint</span>
                                            }
                                            else if (Nin.IsComplete(r.NinNumber))
                                            {
                                                <span class="cg-field-ok" role="status">&#10003;</span>
                                            }
                                        </td>
                                        <td><input class="cg-input" @bind="r.Additional" maxlength="400" /></td>
                                        <td><button type="button" class="cg-action-btn cg-critical" @onclick="() => RemoveRelativeAsync(r)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="cg-hint">The relatives marked as holding DI shares in My Workspace are loaded here for you — enter the shares each one holds.</p>
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="AddRelativeAsync">+ Add shareholder</button>
                        @if (!_relatives.Any(r => r.IsSelf))
                        {
                            <button type="button" class="cg-action-btn" @onclick='() => { _relatives.Add(new RelativeRow { IsSelf = true }); }'>+ Add myself</button>
                        }
                    </div>
                }

                @* The share movement table from the printed declaration form. Shown to employees who
                   hold a DFM investor number: a board member or a corporate declarant reports through
                   other arrangements, and someone with no number has no holding to report. *@
                @if (ShowShareMovements)
                {
                    var declarationPeriod = PeriodRange();
                    <h2 class="cg-section-heading">Share transactions in @Branding.ParentHoldingCompany</h2>
                    <p class="cg-hint">
                        Every purchase and every sale in <b>@PeriodLabel()</b> —
                        <b class="mono">@declarationPeriod.From.ToString("dd/MM/yyyy")</b> to
                        <b class="mono">@declarationPeriod.To.ToString("dd/MM/yyyy")</b> — yours, your spouse's and
                        your relatives'. Record the holdings at the start and end of the period on the same table.
                    </p>

                    <div class="cg-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Share held by</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">NIN</th>
                                    <th scope="col">Entry</th>
                                    <th scope="col">Date</th>
                                    <th scope="col">No. of shares</th>
                                    <th scope="col">Rate of sale / purchase</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in _shareEntries)
                                {
                                    <tr class="cg-data-row">
                                        <td>
                                            <select class="cg-input" @bind="entry.HolderKind">
                                                @foreach (var kind in ShareHolderKinds)
                                                {
                                                    <option value="@kind.Value">@kind.Label</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            @if (entry.HolderKind == ShareHolderKind.Self)
                                            {
                                                <span class="cg-subtitle">@_effectiveMember!.FullName</span>
                                            }
                                            else
                                            {
                                                <input class="cg-input" @bind="entry.HolderName" maxlength="200" placeholder="Name of share holder" />
                                            }
                                        </td>
                                        <td>
                                            <input class="cg-input cg-input-short@(Nin.IsInvalidEntry(entry.HolderNin) ? " cg-input-invalid" : "")"
                                                   @bind="entry.HolderNin" @bind:event="oninput"
                                                   maxlength="@Nin.Length" minlength="@Nin.Length" placeholder="10 characters" />
                                        </td>
                                        <td>
                                            <select class="cg-input" @bind="entry.EntryKind">
                                                @foreach (var kind in ShareEntryKinds)
                                                {
                                                    <option value="@kind.Value">@kind.Label</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            @if (IsTransactionKind(entry.EntryKind))
                                            {
                                                <UaeDateInput CssClass="@(IsOutsidePeriod(entry.TransactionDate) ? "cg-input-invalid" : null)"
                                                              Value="entry.TransactionDate"
                                                              ValueChanged="d => entry.TransactionDate = d" />
                                                @if (IsOutsidePeriod(entry.TransactionDate))
                                                {
                                                    <span class="cg-field-error">Outside @PeriodLabel().</span>
                                                }
                                            }
                                            else
                                            {
                                                @* A balance is a position on a day the period already fixes,
                                                   not a transaction with a date of its own. *@
                                                <span class="cg-subtitle">—</span>
                                            }
                                        </td>
                                        <td><input class="cg-input cg-input-short" type="number" min="0" step="1" @bind="entry.NumberOfShares" /></td>
                                        <td>
                                            @if (IsTransactionKind(entry.EntryKind))
                                            {
                                                <input class="cg-input cg-input-short" type="number" min="0" step="0.0001" @bind="entry.Rate" />
                                            }
                                            else
                                            {
                                                <span class="cg-subtitle">—</span>
                                            }
                                        </td>
                                        <td><button type="button" class="cg-action-btn cg-critical" @onclick="() => RemoveShareEntry(entry)">Remove</button></td>
                                    </tr>
                                }

                                @if (_shareEntries.Count == 0)
                                {
                                    <tr><td colspan="8">
                                        <div class="cg-empty-state">
                                            <h3>Nothing recorded yet</h3>
                                            <p>Use <b>+ Add entry</b> below for each purchase and sale in this period.</p>
                                        </div>
                                    </td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="cg-dfm-actions cg-dfm-actions-save">
                        <button type="button" class="cg-action-btn cg-good" @onclick="AddShareEntry">+ Add entry</button>
                    </div>
                }

                <div class="cg-action-bar">
                    <button type="button" class="cg-action-btn" @onclick="() => _step = Step.Capture1">← Back</button>
                    <div class="cg-action-bar-right">
                        <span class="cg-ready @(StepIsComplete ? "" : "is-not-ready")">
                            @(StepIsComplete ? "All required details complete" : "Some required details are still missing")
                        </span>
                        <button type="button" class="cg-action-btn" disabled="@_savingDraft" @onclick="SaveDraftAsync">@(_savingDraft ? "Saving…" : "Save as draft")</button>
                        <button type="button" class="cg-action-btn cg-good" disabled="@(ExpiredDocuments().Count > 0)" @onclick="GoToReviewAsync">
                            @(_holdsSharesInDI ? "Continue to review" : "Continue to review")
                        </button>
                    </div>
                </div>
                @if (_offerShareholderSave)
                {
                    <ConfirmPrompt Show="true"
                                   Message="Add these shareholders to My Workspace as well?"
                                   Detail="@($"{string.Join(", ", _shareholdersNewToWorkspace.Select(r => r.RelativeName))} — not recorded there yet. Saved once, they are loaded into every future declaration instead of retyped.")"
                                   ConfirmLabel="Add to My Workspace"
                                   CancelLabel="Not now"
                                   OnConfirm="AcceptShareholderSaveAsync"
                                   OnCancel="DeclineShareholderSaveAsync" />
                }

                @if (ExpiredDocuments() is { Count: > 0 } expiredNow)
                {
                    <p class="cg-error">
                        Your @Join(expiredNow) @(expiredNow.Count == 1 ? "has" : "have") expired. A declaration cannot be submitted on an expired document —
                        upload a current copy above, and update it in My Workspace so it is right for next time.
                    </p>
                }
            </div>
        }
        else if (_step == Step.Review)
        {
            <div class="cg-member-form cg-declaration-form">
                @if (_justAutoSaved)
                {
                    <div class="cg-toast cg-toast-success" style="margin-bottom:12px;">Declaration saved</div>
                }
                <h2>@(_loadedAsSubmittedEdit ? "Are you sure you want to proceed for editing your declaration?" : "Are you sure you want to submit below declaration form?")</h2>
                @{ var reviewPeriod = PeriodRange(); }
                <h2 class="cg-section-heading">Declarant</h2>
                <div class="cg-table-wrap">
                    <table>
                        <tbody>
                            <tr><th>Name</th><td>@_effectiveMember!.FullName</td></tr>
                            <tr><th>Entity</th><td>@(_effectiveMember.Company?.Name ?? "—")</td></tr>
                            <tr><th>Declaration type</th><td>@MemberDeclarationTypes.Label(_effectiveMember.DeclarationType, Branding.ParentHoldingCompany)</td></tr>
                            <tr><th>Period</th><td class="mono">@PeriodLabel() — @reviewPeriod.From.ToString("dd/MM/yyyy") to @reviewPeriod.To.ToString("dd/MM/yyyy")</td></tr>
                            <tr><th>DFM National Investor No. (NIN)</th><td class="mono">@(_hasNin && !string.IsNullOrWhiteSpace(_ninNumber) ? _ninNumber : "—")</td></tr>
                            @if (Impersonation.ActingMemberId is not null)
                            {
                                <tr><th>Submitted</th><td>On behalf of @_effectiveMember.FullName</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h2 class="cg-section-heading">Declared</h2>
                <div class="cg-table-wrap">
                    <table>
                        <tbody>
                            <tr><th>Holds a NIN</th><td>@(_hasNin ? $"Yes ({_ninNumber})" : "No — I do not have a National Investor Number (NIN) from Dubai Financial Market (DFM).")</td></tr>
                            <tr><th>Relatives have a NIN</th><td>@(_relativesHaveNin ? "Yes" : "No")</td></tr>
                            <tr><th>Holds shares in @Branding.ParentHoldingCompany (self or relatives)</th><td>@(_holdsSharesInDI ? "Yes" : $"Neither I, my spouse, nor my relatives hold shares in {Branding.ParentHoldingCompany}.")</td></tr>
                        </tbody>
                    </table>
                </div>

                @if (ShowShareMovements && _shareEntries.Count > 0)
                {
                    <h2 class="cg-section-heading">Share transactions in @Branding.ParentHoldingCompany — @PeriodLabel()</h2>
                    <div class="cg-table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Share held by</th><th>Name</th><th>NIN</th><th>Entry</th>
                                    <th>Date</th><th>No. of shares</th><th>Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in _shareEntries)
                                {
                                    <tr class="cg-data-row">
                                        <td>@ShareHolderLabel(entry.HolderKind)</td>
                                        <td>@(entry.HolderKind == ShareHolderKind.Self ? _effectiveMember!.FullName : entry.HolderName)</td>
                                        <td class="mono">@(string.IsNullOrWhiteSpace(entry.HolderNin) ? "—" : entry.HolderNin)</td>
                                        <td>@ShareEntryLabel(entry.EntryKind)</td>
                                        <td class="mono">@(entry.TransactionDate is { } d ? d.ToString("dd/MM/yyyy") : "—")</td>
                                        <td class="mono">@entry.NumberOfShares.ToString("N0")</td>
                                        <td class="mono">@(entry.Rate is { } r ? r.ToString("N4") : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_relativesHaveNin && _ninHolders.Count > 0)
                {
                    <h2 class="cg-section-heading">Relatives' NIN</h2>
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Share Held By</th><th>Name of Share Holder</th><th>NIN</th><th>Additional</th></tr></thead>
                            <tbody>
                                @foreach (var h in _ninHolders)
                                {
                                    <tr class="cg-data-row">
                                        <td>@RelationshipLabel(h.Relationship)</td>
                                        <td>@h.NameOfShareHolder</td>
                                        <td>@h.NinNumber</td>
                                        <td>@h.Additional</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_holdsSharesInDI && _relatives.Count > 0)
                {
                    <h2 class="cg-section-heading">Shareholding</h2>
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Share Held By</th><th>Name of Share Holder</th><th>NIN</th><th>Additional</th></tr></thead>
                            <tbody>
                                @foreach (var r in _relatives)
                                {
                                    <tr class="cg-data-row">
                                        <td>@(r.IsSelf ? "Self" : RelationshipLabel(r.Relationship))</td>
                                        <td>@(r.IsSelf ? _effectiveMember!.FullName : r.RelativeName)</td>
                                        <td>@r.NinNumber</td>
                                        <td>@r.Additional</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* What is attached. The review listed every answer and none of the evidence, so the
                   last thing someone saw before signing did not mention the documents they had
                   just uploaded -- or, worse, had not. *@
                <h2 class="cg-section-heading">Documents attached</h2>
                <div class="cg-table-wrap">
                    <table>
                        <thead><tr><th>Document</th><th>Number</th><th>Expiry</th><th>Attached</th></tr></thead>
                        <tbody>
                            @foreach (var line in ReviewDocuments())
                            {
                                <tr class="cg-data-row">
                                    <td>@line.Name</td>
                                    <td class="mono">@line.Number</td>
                                    <td class="mono">@line.Expiry</td>
                                    <td>
                                        @if (line.Attached)
                                        {
                                            <span class="cg-pill cg-pill-done">Yes</span>
                                        }
                                        else
                                        {
                                            <span class="cg-pill @(line.Required ? "cg-pill-required" : "")">@(line.Required ? "Missing" : "Not attached")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="cg-subtitle">Please review carefully. You can still edit this declaration from Declarations until the due date (<b class="mono">@_run!.DueDateUtc.ToLocalDisplay("dd/MM/yyyy")</b>).</p>

                <label class="cg-switch cg-nothing-switch">
                    <input type="checkbox" @bind="_agreeConfirmed" />
                    <span class="cg-switch-track" aria-hidden="true"></span>
                    <span class="cg-switch-label">I agree and confirm that the information given in this form is true, complete and accurate.</span>
                </label>

                <div class="cg-actions">
                    <button type="button" class="cg-action-btn" disabled="@_submitting" @onclick="() => _step = Step.Capture2">← Back to edit</button>
                    <CgBusyButton CssClass="cg-good" Disabled="@(!_agreeConfirmed)"
                                  BusyLabel="@(_hadExistingRow ? "Saving…" : "Submitting…")" OnClick="SubmitAsync">
                        @(_hadExistingRow ? "Save changes" : "Confirm & Submit")
                    </CgBusyButton>
                </div>
            </div>
        }
        else if (_step == Step.Done)
        {
            <div class="cg-empty-state">
                <p><b>Your Insider Trading declaration was @(_hadExistingRow ? "updated" : "submitted") successfully</b> on @_submittedAtUtc!.Value.ToString("dd MMM yyyy HH:mm") UTC.</p>
                <p>A confirmation email with the details submitted has been sent@(string.IsNullOrWhiteSpace(_effectiveMember?.Email) ? "" : $" to {_effectiveMember!.Email}").</p>
                <p><a href="/my-declarations">Return to Declarations</a></p>
            </div>
        }
    }
</div>
