<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-CGTOOL.Web-4f4b3449-bec2-4783-a837-a092d50f1068</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13" />
    <!-- Kept in step with the version Microsoft.EntityFrameworkCore.SqlServer 10.0.13 itself
         depends on. The app references SqlClient directly (StoredProcedureExecutor and the
         call sites that switch on SqlException.Number), so the reference is deliberate, but
         it must not drift ahead of the provider's own dependency. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- Referenced only to raise it. SqlClient 6.1.7 still asks for Pkcs 9.0.11, which carries
         GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7; a direct reference wins over the
         transitive one, and 10.0.13 is the patched build matching the rest of the 10.0.13
         packages. Drop this once SqlClient's own dependency moves past it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.0" />
    <!-- Official PDFsharp, not the PdfSharpCore fork: the fork pins SixLabors.ImageSharp
         1.0.4, which carries unpatched high-severity advisories and has no fixed 1.x.
         PDFsharp 6 draws its own images and has no ImageSharp dependency at all. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.13" />
  </ItemGroup>

</Project>
