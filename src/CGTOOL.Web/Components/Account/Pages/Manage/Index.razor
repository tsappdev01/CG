@page "/Account/Manage"

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CGTOOL.Web.Data
@using CGTOOL.Web.Data.Governance

@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Profile</PageTitle>

<div class="cg-shell cg-shell-full cg-account">
    <div class="cg-account-head">
        <div>
            <h1>Manage your account</h1>
            <p class="cg-subtitle">View and manage your profile and sign-in &amp; security settings.</p>
        </div>
        <div class="cg-account-chips">
            @if (_isSingleSignOn)
            {
                <span class="cg-chip">
                    <span class="cg-chip-ico cg-ico-ms" aria-hidden="true"></span>
                    SSO
                    <span class="cg-chip-check" aria-hidden="true"></span>
                </span>
                <span class="cg-chip">
                    <span class="cg-chip-ico cg-ico-shield-blue" aria-hidden="true"></span>
                    Organization-managed account
                </span>
            }
            else
            {
                <span class="cg-chip">
                    <span class="cg-chip-ico cg-ico-key" aria-hidden="true"></span>
                    Password sign-in
                </span>
            }
        </div>
    </div>

    <StatusMessage />

    <div class="cg-account-grid">
        <section class="cg-card cg-account-card">
            <div class="cg-account-card-head">
                <h2>Profile</h2>
                @* Profile details are owned by Entra ID and refreshed by the directory sync, so there
                   is nothing to edit here -- the button is kept for continuity and disabled. *@
                <button type="button" class="cg-action-btn cg-good cg-btn-edit" disabled
                        title="Your profile is managed in Entra ID and cannot be edited here">
                    Edit Profile
                </button>
            </div>

            <div class="cg-account-identity">
                @if (!string.IsNullOrEmpty(_picturePath))
                {
                    <img src="@_picturePath" alt="" class="cg-account-avatar" />
                }
                else
                {
                    <span class="cg-account-avatar cg-account-avatar-initials">@Initials(_displayName ?? _userName)</span>
                }
                <div class="cg-account-identity-fields">
                    <div class="cg-account-field">
                        <span class="cg-account-label">Username</span>
                        <span class="cg-account-value">@_userName</span>
                    </div>
                    <div class="cg-account-field">
                        <span class="cg-account-label">Display name</span>
                        <span class="cg-account-value">@(_displayName ?? "—")</span>
                    </div>
                </div>
            </div>

            <div class="cg-account-row cg-account-row-split">
                <div class="cg-account-detail">
                    <span class="cg-account-ico cg-ico-phone" aria-hidden="true"></span>
                    <div>
                        <span class="cg-account-label">Phone number</span>
                        <span class="cg-account-value">@(string.IsNullOrWhiteSpace(_phoneNumber) ? "—" : _phoneNumber)</span>
                    </div>
                </div>
                <div class="cg-account-detail">
                    <span class="cg-account-ico cg-ico-case" aria-hidden="true"></span>
                    <div>
                        <span class="cg-account-label">Department</span>
                        <span class="cg-account-value">@(_department ?? "—")</span>
                    </div>
                </div>
            </div>

            <div class="cg-account-row">
                <div class="cg-account-detail">
                    <span class="cg-account-ico cg-ico-case" aria-hidden="true"></span>
                    <div>
                        <span class="cg-account-label">Job title</span>
                        <span class="cg-account-value">@(_jobTitle ?? "—")</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="cg-card cg-account-card">
            <div class="cg-account-card-head">
                <h2><span class="cg-account-head-ico cg-ico-shield-blue" aria-hidden="true"></span> Sign-in &amp; Security</h2>
            </div>

            <dl class="cg-account-security">
                <div class="cg-account-secrow">
                    <span class="cg-account-ico cg-ico-link" aria-hidden="true"></span>
                    <dt>Authentication method</dt>
                    <dd>@(_isSingleSignOn ? "Single Sign-On (SSO)" : "Password")</dd>
                </div>
                <div class="cg-account-secrow">
                    <span class="cg-account-ico cg-ico-entra" aria-hidden="true"></span>
                    <dt>Identity Provider</dt>
                    <dd>@(_isSingleSignOn ? "Microsoft Entra ID" : "This application")</dd>
                </div>
                <div class="cg-account-secrow">
                    <span class="cg-account-ico cg-ico-person-check" aria-hidden="true"></span>
                    <dt>Account status</dt>
                    <dd>
                        <span class="cg-account-status @(_isActive ? "on" : "off")">
                            <span class="cg-account-status-dot" aria-hidden="true"></span>
                            @(_isActive ? "Active" : "Deactivated")
                        </span>
                    </dd>
                </div>
                <div class="cg-account-secrow">
                    <span class="cg-account-ico cg-ico-mfa" aria-hidden="true"></span>
                    <dt>MFA</dt>
                    <dd>
                        @if (_isSingleSignOn)
                        {
                            <span class="cg-account-ico-inline cg-ico-shield-grey" aria-hidden="true"></span>
                            <span>Managed by your organization</span>
                        }
                        else
                        {
                            <span>@(_twoFactorEnabled ? "Enabled" : "Not enabled")</span>
                        }
                    </dd>
                </div>
                <div class="cg-account-secrow">
                    <span class="cg-account-ico cg-ico-clock" aria-hidden="true"></span>
                    <dt>Last sign-in</dt>
                    <dd>@_lastSignIn</dd>
                </div>
            </dl>

        </section>
    </div>
</div>

@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? _userName;
    private string? _displayName;
    private string? _phoneNumber;
    private string? _department;
    private string? _jobTitle;
    private string? _picturePath;
    private bool _isSingleSignOn;
    private bool _isActive;
    private bool _twoFactorEnabled;
    private string _lastSignIn = "—";

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        _userName = await UserManager.GetUserNameAsync(user);
        _phoneNumber = await UserManager.GetPhoneNumberAsync(user);
        _picturePath = string.IsNullOrEmpty(user.ProfilePicturePath)
            ? null
            : $"{user.ProfilePicturePath}?v={DateTime.UtcNow.Ticks}";

        // An account with an external login signs in through Entra; the setup account does not.
        _isSingleSignOn = (await UserManager.GetLoginsAsync(user)).Count > 0;
        _isActive = !await UserManager.IsLockedOutAsync(user);
        _twoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);

        _lastSignIn = user.LastSignInUtc is { } at
            ? $"{at.ToLocalDisplay("MMM d, yyyy, h:mm tt")} ({TimeZoneInfo.Local.StandardName})"
            : "—";

        await using var db = await DbFactory.CreateDbContextAsync();
        var member = await db.Members
            .Include(m => m.Department)
            .FirstOrDefaultAsync(m => m.ApplicationUserId == user.Id);

        _displayName = member?.FullName;
        _department = member?.Department?.Name;
        _jobTitle = member?.JobTitle;


    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split([' ', '.', ',', '@'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return (parts[0][..1] + parts[1][..1]).ToUpperInvariant();
    }
}
