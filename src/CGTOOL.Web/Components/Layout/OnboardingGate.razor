@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject IMemberOnboardingService Onboarding
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ActingAsCookie ActingAs
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

@* Renders nothing. Placed on the declaration pages -- the ones a member reaches from the link in
   their declaration email -- to send them through onboarding first, and back here afterwards.

   On those pages only, not on the whole application. The first version of this sat in MainLayout
   and gated every page, which was both more than the specification asks for (onboarding is
   triggered by the declaration link) and the cause of a redirect loop: anything that redirects on
   every page has to be perfectly sure it is not on the page it redirects to, and "perfectly sure"
   across layouts and render modes turned out to be wishful. Scoping it to three pages removes the
   class of problem rather than the instance.

   Statically rendered: a redirect decided inside a circuit happens after the page has been sent
   and drawn, which is a visible flash of a form the member should not be filling in yet. *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var context = HttpContextAccessor.HttpContext;

        // Only on a real page request. During the interactive render there is no response left to
        // redirect, and the static pass has already decided.
        if (context is null || context.Response.HasStarted) return;

        // Belt and braces. Nothing should place this on the onboarding page, but a redirect loop
        // is a bad way to find out that something did.
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        if (path.StartsWith("onboarding", StringComparison.OrdinalIgnoreCase)) return;

        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true) return;

        // An administrator acting as somebody is still that person here: completing their
        // onboarding on their behalf is a thing an assistant legitimately does.
        int? memberId = ActingAs.Read(context)?.MemberId;
        if (memberId is null)
        {
            var userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (userId is null) return;

            await using var db = await DbFactory.CreateDbContextAsync();
            memberId = await db.Members.AsNoTracking()
                .Where(m => m.ApplicationUserId == userId)
                .Select(m => (int?)m.Id)
                .FirstOrDefaultAsync();
        }

        // Signed in with no member record -- an administrator account, say. Nothing to onboard.
        if (memberId is null) return;

        if (await Onboarding.IsRequiredAsync(memberId.Value))
        {
            // Where to put them back afterwards: the declaration they were trying to open.
            var returnTo = Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri));
            Nav.NavigateTo($"/onboarding?returnUrl={returnTo}", forceLoad: false);
        }
    }
}
