@inherits LayoutComponentBase
@inject ClientContext ClientContext
@inject ActingAsCookie ActingAs
@inject PersistentComponentState AppState
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu @rendermode="InteractiveServer" />
    </div>

    <main>
        <TopBar @rendermode="InteractiveServer" />
        <DefaultAdminBanner @rendermode="InteractiveServer" />
        <AdminImpersonationBanner @rendermode="InteractiveServer" />
        <ImpersonationBanner @rendermode="InteractiveServer" />
        @* Before @Body, so the acting-as profile is in place by the time a page reads it. *@
        <ActingAsRestore @rendermode="InteractiveServer" />
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<IdleLockOverlay @rendermode="InteractiveServer" />
<ClientContextRestore @rendermode="InteractiveServer" />
<ToastContainer @rendermode="InteractiveServer" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private PersistingComponentStateSubscription _persisting;

    protected override void OnInitialized()
    {
        ClientContext.CaptureOnce(HttpContext);

        // The acting-as profile lives in a signed cookie so it survives a refresh; only this static
        // render can read it, so it is handed to the circuit the same way the client context is.
        var actingAs = ActingAs.Read(HttpContext);

        // Handed to the circuit, which cannot read HttpContext itself and does not share this scope.
        _persisting = AppState.RegisterOnPersisting(() =>
        {
            AppState.PersistAsJson(ClientContextSnapshot.PersistenceKey, ClientContext.Snapshot());
            AppState.PersistAsJson(ImpersonationContext.StorageKey, actingAs);
            return Task.CompletedTask;
        });
    }

    public void Dispose() => _persisting.Dispose();
}
