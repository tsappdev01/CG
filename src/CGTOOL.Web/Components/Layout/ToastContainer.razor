@implements IDisposable
@inject ToastService Toasts

<div class="cg-toast-stack">
    @foreach (var toast in _active)
    {
        <div class="cg-toast cg-toast-@toast.Level.ToString().ToLowerInvariant()">
            <span>@toast.Text</span>
            <button type="button" class="cg-toast-close" @onclick="() => Dismiss(toast.Id)">×</button>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _active = [];

    protected override void OnInitialized()
    {
        Toasts.OnShow += HandleShow;
    }

    /// <summary>Pressing Refresh four times used to put four "Dashboard refreshed." notices on the
    /// screen, one under another, saying the same thing four times and covering the page while
    /// they said it. The same message arriving again replaces the one already up and restarts its
    /// six seconds, so what is on screen is the latest of them and there is one of it.
    ///
    /// Only an identical message, matched on its text and its level. Two different things that
    /// happened both deserve saying, and a warning that reads like a success is not the same
    /// notice.</summary>
    private void HandleShow(ToastMessage toast)
    {
        _active.RemoveAll(t => t.Level == toast.Level
            && string.Equals(t.Text, toast.Text, StringComparison.Ordinal));

        _active.Add(toast);
        InvokeAsync(StateHasChanged);

        _ = DismissAfterDelayAsync(toast.Id);
    }

    private async Task DismissAfterDelayAsync(Guid id)
    {
        await Task.Delay(6000);
        Dismiss(id);
    }

    private void Dismiss(Guid id)
    {
        _active.RemoveAll(t => t.Id == id);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Toasts.OnShow -= HandleShow;
    }
}
