@inherits LayoutComponentBase
@inject Branding Branding

@* No nav, no top bar. Onboarding is the one thing the member can do until it is finished, and a
   menu full of pages the gate would bounce them off is an invitation to try. It is also why the
   gate cannot loop: the onboarding page is not inside MainLayout.

   The masthead is the navy the rest of the application wears, with the same logo file the sidebar
   uses. The first version put the transparent-background mark on a white bar, which rendered as a
   dark smear -- that file is drawn to sit on navy. *@
<div class="cg-onboarding-shell">
    <header class="cg-onboarding-brand">
        <img src="images/di-logo-en.png" alt="@Branding.ParentHoldingCompany" />
    </header>

    <main class="cg-onboarding-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
