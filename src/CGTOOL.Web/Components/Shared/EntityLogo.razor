@using CGTOOL.Web.Data.Governance

@if (Company is null)
{
    <span>—</span>
}
else if (DocumentUrl.Exists(Company.LogoBlobId, Company.LogoPath))
{
    <img src="@DocumentUrl.For(Company.LogoBlobId, Company.LogoPath)" alt="@Company.Name" title="@Company.Name" class="cg-entity-logo" />
}
else
{
    <span title="@Company.Name">@(Company.ShortCode.Length > 0 ? Company.ShortCode : Company.Name)</span>
}

@code {
    [Parameter] public Company? Company { get; set; }
}
