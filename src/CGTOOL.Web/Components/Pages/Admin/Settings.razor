@page "/admin/settings"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IPolicyDocumentVersionWriter VersionWriter
@inject INavMenuItemOrderWriter NavOrderWriter
@inject INavMenuItemLabelWriter NavLabelWriter
@inject INavMenuItemVisibilityWriter NavVisibilityWriter
@using CGTOOL.Web.Components.Layout
@inject NavMenuStateNotifier NavState
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ToastService Toasts
@inject IWebHostEnvironment Env

<PageTitle>Settings</PageTitle>

<div class="cg-shell">
    <h1 data-icon="settings">Settings</h1>
    <p class="cg-subtitle">Control Panel — application-wide documents and configuration.</p>

    <div class="cg-member-form" style="max-width:720px;">
        <h2>Policy Document</h2>
        <p class="cg-subtitle">Uploaded here as <code>/assets/policy.pdf</code>, linked wherever the app references the corporate policy document. Every replacement backs up the previous copy before overwriting it.</p>

        @if (_currentDocumentExists)
        {
            <p><a href="/assets/policy.pdf" target="_blank">View current policy document</a></p>
        }
        else
        {
            <p class="cg-subtitle">No policy document has been uploaded yet.</p>
        }

        <label class="cg-field">
            <span>Upload new version (PDF only)</span>
            <InputFile OnChange="OnFileSelectedAsync" accept="application/pdf" disabled="@_uploading" />
        </label>
        @if (_uploading)
        {
            <p class="cg-subtitle">Uploading…</p>
        }

        @if (_versions is null)
        {
            <p class="cg-loading"><em>Loading…</em></p>
        }
        else
        {
            <details class="cg-audit-history">
                <summary>Version history (@_versions.Count)</summary>
                @if (_versions.Count == 0)
                {
                    <div class="cg-empty-state">No previous versions have been backed up yet.</div>
                }
                else
                {
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Replaced on</th><th>Replaced by</th><th>Original file name</th><th>Backup</th></tr></thead>
                            <tbody>
                                @foreach (var v in _versions)
                                {
                                    <tr class="cg-data-row">
                                        <td class="mono">@v.UploadedAtUtc.ToLocalDisplay("dd/MM/yyyy HH:mm")</td>
                                        <td>@v.UploadedByName</td>
                                        <td>@v.OriginalFileName</td>
                                        <td><a href="@v.FilePath" target="_blank">View backup</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </details>
        }
    </div>

    <div class="cg-member-form" style="max-width:720px; margin-top:24px;">
        <h2>Related Party Transaction Roles</h2>
        <p class="cg-subtitle">
            CCAO, CFO, COO, and MD&amp;CEO are positions in the RP Transaction workflow -- separate from the System
            roles (Administrator/Normal User) above. Open a User's record in
            <a href="/admin/user-management">User Management</a> and set their "RP Transaction Role" (one position at
            most per person, any number of people per position). CCAO gates the CCAO Review screen directly and every
            CFO holder is emailed at each notification stage; COO and MD&amp;CEO are assignable positions for now
            (offline reviewers per the FRD) without a dedicated screen or automated notification of their own yet.
        </p>
    </div>

    <div class="cg-member-form" style="max-width:720px; margin-top:24px;">
        <h2>Menu Order &amp; Names</h2>
        <p class="cg-subtitle">Reorder or rename the sections and items in the left-hand nav menu. Changes apply immediately for everyone.</p>

        @* Each group is a collapsible panel -- the flat list ran to eight headings and forty rows,
           which meant scrolling past everything to reach the one section being edited. *@
        @foreach (var group in OrderGroups)
        {
            var items = SortedGroupItems(group);
            var open = IsSectionOpen(group.Title);

            <section class="cg-menu-section">
                <button type="button" class="cg-menu-section-head @(open ? "open" : "")"
                        @onclick="() => ToggleSection(group.Title)" aria-expanded="@open">
                    <span class="cg-menu-chevron" aria-hidden="true"></span>
                    <span class="cg-menu-section-title">@group.Title</span>
                    <span class="cg-menu-section-count">@VisibleCount(items) of @items.Count shown</span>
                </button>

                @if (open)
                {
                    <div class="cg-menu-section-body">
                        @if (items.Count == 0)
                        {
                            <p class="cg-subtitle">No items in this group.</p>
                        }
                        else
                        {
                            @for (var i = 0; i < items.Count; i++)
                            {
                                var item = items[i];
                                var pos = i;
                                var state = StateOf(item);
                                <div class="cg-menu-row @(state == NavMenuItemState.Removed ? "removed" : "")">
                                    <input class="cg-input cg-menu-row-name" maxlength="120"
                                           disabled="@(state == NavMenuItemState.Removed)"
                                           value="@(_labelEdits.TryGetValue(item.Key, out var v) ? v : item.Label)"
                                           @onchange="e => _labelEdits[item.Key] = e.Value?.ToString() ?? string.Empty"
                                           aria-label="Menu name" />

                                    <button type="button" class="cg-action-btn" disabled="@(state == NavMenuItemState.Removed)"
                                            @onclick="() => SaveLabelAsync(item)">Save name</button>

                                    @if (IsRenamed(item))
                                    {
                                        <button type="button" class="cg-icon-btn" title="Reset to default name (@item.Label)" @onclick="() => ResetLabelAsync(item)">↺</button>
                                    }

                                    <span class="cg-menu-row-move">
                                        <button type="button" class="cg-icon-btn" title="Move up" disabled="@(pos == 0)" @onclick="() => MoveAsync(group, item, -1)">▲</button>
                                        <button type="button" class="cg-icon-btn" title="Move down" disabled="@(pos == items.Count - 1)" @onclick="() => MoveAsync(group, item, 1)">▼</button>
                                    </span>

                                    @if (state == NavMenuItemState.Removed)
                                    {
                                        <span class="cg-menu-removed-tag">Removed from menu</span>
                                        <button type="button" class="cg-action-btn cg-good" @onclick="() => SetStateAsync(item, NavMenuItemState.Visible)">Restore</button>
                                    }
                                    else
                                    {
                                        <span class="cg-menu-row-show">
                                            <ToggleSwitch Value="@(state == NavMenuItemState.Visible)"
                                                          ValueChanged="on => SetStateAsync(item, on ? NavMenuItemState.Visible : NavMenuItemState.Hidden)" />
                                            <span class="cg-menu-row-show-text @(state == NavMenuItemState.Visible ? "on" : "off")">
                                                @(state == NavMenuItemState.Visible ? "Shown" : "Hidden")
                                            </span>
                                        </span>

                                        <button type="button" class="cg-action-btn cg-critical" title="Remove from the menu for everyone"
                                                @onclick="() => _pendingRemoval = item">Delete</button>
                                    }
                                </div>

                                @if (HasHiddenChildren(item, state))
                                {
                                    <p class="cg-menu-row-note">Items under this section are hidden with it. Their own settings are kept.</p>
                                }
                            }
                        }
                    </div>
                }
            </section>
        }

        @if (_pendingRemoval is not null)
        {
            <div class="cg-print-overlay">
                <div class="cg-confirm-modal">
                    <h3>Remove “@EffectiveLabel(_pendingRemoval)” from the menu?</h3>
                    <p>
                        It disappears from the left-hand nav for everyone, immediately. Anything under it
                        goes too. Nothing is deleted — the pages still exist and anyone with the address
                        can still open them, and you can put it back from this screen at any time.
                    </p>
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn cg-critical" @onclick="ConfirmRemovalAsync">Remove from menu</button>
                        <button type="button" class="cg-action-btn" @onclick="() => _pendingRemoval = null">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
