@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        @if (_locked)
        {
            <div class="cg-lock-overlay">
                <div class="cg-lock-card">
                    <h2>Session locked</h2>
                    <p class="cg-subtitle">
                        No activity for @IdleDescription. Signing you out — confirm who you are with
                        Microsoft and you will come back to this screen.
                    </p>
                    <CgSpinner />
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private const int DefaultIdleMinutes = 15;

    /// <summary>
    /// Security:IdleLockMinutes in appsettings. 0 or less turns the lock off entirely, which is the
    /// only way to disable it -- a deployment that wants no lock says so rather than setting a
    /// number so large it never fires. Anything unparseable falls back to the default rather than
    /// leaving the screen unlocked, since that is the safer of the two failures.
    /// </summary>
    private int IdleMinutes
    {
        get
        {
            var configured = Configuration.GetValue<int?>("Security:IdleLockMinutes");
            return configured ?? DefaultIdleMinutes;
        }
    }

    private int IdleTimeoutMs => IdleMinutes * 60 * 1000;

    private string IdleDescription => IdleMinutes == 1 ? "1 minute" : $"{IdleMinutes} minutes";

    private bool _locked;
    private DotNetObjectReference<IdleLockOverlay>? _selfRef;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_started)
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true && IdleMinutes > 0)
            {
                _started = true;
                _selfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("cgtoolIdleLock.start", _selfRef, IdleTimeoutMs);
            }
        }
    }

    /// <summary>
    /// Hands the browser to /Account/Lock, which signs the session out and sends the person back
    /// through Entra with prompt=login, returning them to this same URL.
    ///
    /// It used to ask for a password here and check it with IActiveDirectoryAuthenticator. On a
    /// deployment with no ActiveDirectory:Server configured that resolves to the local Identity
    /// password hash -- which an SSO account does not have -- so the box rejected every password
    /// anyone could type and the only way back in was to refresh the page. Which also says what
    /// the lock was worth: it was a flag on this component, and refreshing cleared it.
    ///
    /// Unsaved form content on the page does not survive this, and cannot: the circuit ends when
    /// the browser navigates away. That is the price of a lock that actually closes the session,
    /// and the reason the idle window is a deployment setting.
    /// </summary>
    [JSInvokable]
    public void OnIdleTimeout()
    {
        if (_locked) return;

        _locked = true;
        StateHasChanged();

        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(
            $"Account/Lock?returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: true);
    }

    public async ValueTask DisposeAsync()
    {
        if (_selfRef is not null)
        {
            try { await JS.InvokeVoidAsync("cgtoolIdleLock.stop"); } catch { /* circuit may already be gone */ }
            _selfRef.Dispose();
        }
    }
}
