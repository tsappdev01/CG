@* Delete asks first. The record is gone from the screen afterwards but not from the record: the
   audit entry carries every field it held, which is what the warning promises. *@
@if (_pendingDeleteDocument is { } pendingDocument)
{
    <div class="cg-modal-backdrop" @onclick="CancelRemoveDocument"></div>
    <div class="cg-modal cg-confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="cg-del-doc-title">
        <div class="cg-modal-head">
            <div>
                <h2 id="cg-del-doc-title">Delete this document?</h2>
                <p class="cg-subtitle">@KindTitle(pendingDocument)</p>
            </div>
            <button type="button" class="cg-modal-close" aria-label="Close" @onclick="CancelRemoveDocument">×</button>
        </div>

        <div class="cg-modal-body">
            <p>This removes the document and the details read from it. It cannot be undone here.</p>
            <p class="cg-hint">The uploaded file stays on disk, and the audit trail keeps a full record of what was deleted, when, and under whose name.</p>
        </div>

        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="CancelRemoveDocument">Cancel</button>
            <button type="button" class="cg-action-btn cg-critical" @onclick="ConfirmRemoveDocumentAsync">Delete</button>
        </div>
    </div>
}

