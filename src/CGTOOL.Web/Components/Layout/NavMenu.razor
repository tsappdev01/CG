                        <div class="nav-item px-3" style="order:@OrderOf("DeclarationSetup.Notifications");@HideOf("DeclarationSetup.Notifications")"><NavLink class="@NotificationsLinkClass" Match="NavLinkMatch.All" href="admin/declarations-setup">@LabelOf("DeclarationSetup.Notifications")</NavLink></div>
                        <div class="nav-item px-3" style="order:@OrderOf("DeclarationSetup.ScheduledMaintenance");@HideOf("DeclarationSetup.ScheduledMaintenance")"><NavLink class="nav-link" href="admin/declarations-setup/scheduled-maintenance">@LabelOf("DeclarationSetup.ScheduledMaintenance")</NavLink></div>
