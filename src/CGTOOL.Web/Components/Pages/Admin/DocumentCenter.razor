@page "/admin/document-center"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDocumentTypeWriter DocumentTypeWriter
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ToastService Toasts

<PageTitle>Document Center</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="folder">Document Center</h1>
    <p class="cg-subtitle">Control Panel — documents on file, and what each declaration asks for.</p>

    @if (_types is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <div class="cg-tabs" role="tablist">
            <button type="button" class="cg-tab @(_tab == Tab.Documents ? "active" : "")" role="tab"
                    aria-selected="@(_tab == Tab.Documents)" @onclick="() => _tab = Tab.Documents">
                User Documents — @_types.Count
            </button>
            <button type="button" class="cg-tab @(_tab == Tab.Insider ? "active" : "")" role="tab"
                    aria-selected="@(_tab == Tab.Insider)" @onclick="() => _tab = Tab.Insider">
                Insider Declaration — @RequiredCount(DeclarationType.InsiderTrading) required
            </button>
            <button type="button" class="cg-tab @(_tab == Tab.RpCoi ? "active" : "")" role="tab"
                    aria-selected="@(_tab == Tab.RpCoi)" @onclick="() => _tab = Tab.RpCoi">
                RP &amp; COI Declaration — @RequiredCount(DeclarationType.ConflictOfInterest) required
            </button>
        </div>

        @if (_tab == Tab.Documents)
        {
            <div class="cg-actions">
                <button type="button" class="cg-action-btn cg-good" @onclick="StartAdd">+ Add document</button>
            </div>

            <p class="cg-subtitle">
                <b>Inactive</b> withdraws a document everywhere, keeping what is already uploaded.
                What each declaration asks for is set on its own tab.
            </p>

            <div class="cg-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Insider Declaration</th>
                            <th scope="col">RP &amp; COI Declaration</th>
                            <th scope="col">On file</th>
                            <th scope="col">Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _types)
                        {
                            <tr class="cg-data-row">
                                <td>
                                    @type.Name
                                    @if (type.IsBuiltIn)
                                    {
                                        <span class="cg-pill" title="Read automatically. Can be renamed or switched off, but not removed.">Built-in</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(type.Description))
                                    {
                                        <p class="cg-subtitle">@type.Description</p>
                                    }
                                </td>
                                <td><span class="cg-pill @PillClass(type.RequirementFor(DeclarationType.InsiderTrading))">@Describe(type.RequirementFor(DeclarationType.InsiderTrading))</span></td>
                                <td><span class="cg-pill @PillClass(type.RequirementFor(DeclarationType.ConflictOfInterest))">@Describe(type.RequirementFor(DeclarationType.ConflictOfInterest))</span></td>
                                <td class="mono">@UploadCount(type.Id)</td>
                                <td><ToggleSwitch Value="type.IsActive" ValueChanged="() => _pendingJustify = type" /></td>
                                <td>
                                    <button type="button" class="cg-action-btn" @onclick="() => Edit(type)">Edit</button>
                                    @if (!type.IsBuiltIn)
                                    {
                                        <button type="button" class="cg-action-btn cg-critical" @onclick="() => _pendingDelete = type">Remove</button>
                                    }
                                </td>
                            </tr>
                        }

                        @if (_types.Count == 0)
                        {
                            <tr><td colspan="6">
                                <div class="cg-empty-state">
                                    <h3>No documents configured</h3>
                                    <p>Use <b>+ Add document</b> above.</p>
                                </div>
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="cg-subtitle">
                Only Emirates ID, passport and trade licence are read automatically. Anything added
                here is typed in.
            </p>
        }
        else
        {
            var declaration = _tab == Tab.Insider ? DeclarationType.InsiderTrading : DeclarationType.ConflictOfInterest;

            <p class="cg-subtitle">
                <b>Required</b> blocks submission until attached. <b>Optional</b> offers it.
                <b>Not requested</b> leaves it off this form.
            </p>

            <div class="cg-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">On this declaration</th>
                            <th scope="col">On file</th>
                            <th scope="col">Read automatically</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _types.Where(t => t.IsActive))
                        {
                            <tr class="cg-data-row">
                                <td>
                                    @type.Name
                                    @if (type.IsBuiltIn)
                                    {
                                        <span class="cg-pill" title="Read automatically. Can be renamed or switched off, but not removed.">Built-in</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(type.Description))
                                    {
                                        <p class="cg-subtitle">@type.Description</p>
                                    }
                                </td>
                                <td>
                                    <select class="cg-input cg-requirement-select" value="@((int)type.RequirementFor(declaration))"
                                            aria-label="@($"What {DeclarationLabel(declaration)} asks of {type.Name}")"
                                            @onchange="e => SetRequirementAsync(type, declaration, e.Value)">
                                        <option value="0">Not requested</option>
                                        <option value="1">Optional</option>
                                        <option value="2">Required</option>
                                    </select>
                                </td>
                                <td class="mono">@UploadCount(type.Id)</td>
                                <td class="cg-subtitle">
                                    @(type.IsBuiltIn && type.BuiltInKind != MemberDocumentKind.Other ? "Yes" : "No — typed in")
                                </td>
                            </tr>
                        }

                        @if (!_types.Any(t => t.IsActive))
                        {
                            <tr><td colspan="4">
                                <div class="cg-empty-state">
                                    <h3>Nothing to ask for</h3>
                                    <p>Every document is Inactive. Switch one on under <b>User Documents</b> first.</p>
                                </div>
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_types.Any(t => !t.IsActive))
            {
                <p class="cg-subtitle">
                    @_types.Count(t => !t.IsActive) Inactive document(s) are not listed — an inactive
                    document is withdrawn from every declaration.
                </p>
            }
        }

        @if (_pendingJustify is not null)
        {
            <JustificationPrompt Show="true"
                                 Label="@($"Why are you {(_pendingJustify.IsActive ? "switching off" : "switching on")} {_pendingJustify.Name}?")"
                                 Toasts="Toasts"
                                 OnConfirm="ToggleActiveAsync"
                                 OnCancel="() => _pendingJustify = null" />
        }
    }
</div>

@if (_editing is not null)
{
    <div class="cg-modal-backdrop" @onclick="CancelEdit"></div>
    <div class="cg-modal cg-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="cg-doctype-title">
        <div class="cg-modal-head">
            <div>
                <h2 id="cg-doctype-title">@(_editing.Id == 0 ? "Add a document" : $"Edit “{_editing.Name}”")</h2>
                <p class="cg-subtitle">Shown on My Workspace and the declaration forms.</p>
            </div>
            <button type="button" class="cg-modal-close" aria-label="Close" @onclick="CancelEdit">×</button>
        </div>

        <div class="cg-modal-body">
            <label class="cg-field">
                <span>Document name <span class="cg-required" aria-hidden="true">*</span></span>
                <input class="cg-input" maxlength="120" @bind="_formName" @bind:event="oninput" aria-required="true" />
            </label>
            <label class="cg-field">
                <span>What is wanted</span>
                <input class="cg-input" maxlength="300" @bind="_formDescription" placeholder="Optional — the line shown under the name" />
            </label>
            @if (_editing.Id == 0)
            {
                <p class="cg-hint">Starts <b>Optional</b> on both declarations. Set each on its own tab.</p>
            }
            else if (_editing.IsBuiltIn)
            {
                <p class="cg-hint">Read automatically, so it cannot be removed. The name and description are yours.</p>
            }
        </div>

        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="CancelEdit">Cancel</button>
            <button type="button" class="cg-action-btn cg-good" disabled="@_saving" @onclick="SaveEditAsync">Save</button>
        </div>
    </div>
}

@if (_pendingDelete is not null)
{
    <div class="cg-modal-backdrop" @onclick="() => _pendingDelete = null"></div>
    <div class="cg-modal cg-confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="cg-doctype-del-title">
        <div class="cg-modal-head">
            <div>
                <h2 id="cg-doctype-del-title">Remove “@_pendingDelete.Name”?</h2>
            </div>
            <button type="button" class="cg-modal-close" aria-label="Close" @onclick="() => _pendingDelete = null">×</button>
        </div>

        <div class="cg-modal-body">
            <p>It stops being asked for on every declaration and is gone from the list.</p>
            <p class="cg-hint">Refused if anyone has uploaded one — switch it off instead.</p>
        </div>

        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="() => _pendingDelete = null">Cancel</button>
            <button type="button" class="cg-action-btn cg-critical" disabled="@_saving" @onclick="DeleteAsync">Remove</button>
        </div>
    </div>
}
