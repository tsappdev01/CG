@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CGTOOL.Web.Data
@using CGTOOL.Web.Data.Governance
@using Microsoft.EntityFrameworkCore

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IActiveDirectoryAuthenticator DirectoryAuthenticator
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>DI Corporate Governance Tool — Sign In</PageTitle>

<div class="cg-shell cg-narrow cg-signin">
    <img src="images/di-logo-en.png" alt="Dubai Investments" class="cg-login-logo" />
    <h1>Corporate Governance Tool</h1>

    @if (_useSingleSignOn)
    {
        <p class="cg-subtitle">Sign in with your Dubai Investments account.</p>
        <ExternalLoginPicker />
    }
    else
    {
        @if (_ssoConfigured)
        {
            <div class="cg-info-callout">
                <b>First-time setup.</b>
                No users have been loaded from Entra ID yet, so sign in with the built-in setup
                account, then load the directory from <b>User Management &rarr; Sync from Entra ID</b>.
                Once real users exist this page signs in with single sign-on only.
            </div>

            @* Offered here too, not just once real users exist: otherwise single sign-on could
               never be exercised on a fresh deployment (or a developer machine) until the
               directory had already been synced through it. *@
            <ExternalLoginPicker />
            <p class="cg-divider"><span>or use the setup account</span></p>
        }
        else
        {
            <div class="cg-info-callout">
                <b>Single sign-on is not configured for this deployment.</b>
                Set <code>AzureAd:TenantId</code> and <code>AzureAd:ClientId</code> to sign in with
                Entra ID. Until then, use the setup account below.
            </div>
        }

        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="User name" />
                    <label for="username" class="form-label">User Name</label>
                    <ValidationMessage For="() => Input.UserName" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label for="password" class="form-label">Password</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Remember me
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Sign in</button>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private bool _ssoConfigured;
    private bool _useSingleSignOn;

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }

        _ssoConfigured = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

        // Everyone signs in through Entra ID. The one exception is a deployment that has no real
        // users yet: nobody could sign in through SSO to load them, so the setup account's password
        // form is offered instead. The moment real users exist this flips to single sign-on, and if
        // SSO is not configured at all the form stays as the only way in.
        var hasRealUsers = await UserManager.Users.AnyAsync(u => !u.IsDefaultAdmin);
        _useSingleSignOn = _ssoConfigured && hasRealUsers;
    }

    public async Task LoginUser()
    {
        var result = await DirectoryAuthenticator.AuthenticateAsync(Input.UserName, Input.Password);
        if (!result.Succeeded)
        {
            Logger.LogWarning("Corporate directory sign-in failed for {UserName}.", Input.UserName);
            errorMessage = $"Error: {result.ErrorMessage ?? "Invalid corporate credentials."}";
            return;
        }

        // IActiveDirectoryAuthenticator implementations may match an existing account by username
        // OR email (see LocalIdentityAuthenticator), so this lookup must do the same -- otherwise a
        // user who types their email address here ends up with a brand-new, picture-less duplicate
        // ApplicationUser instead of signing into their existing (already-configured) account.
        var user = await UserManager.FindByNameAsync(Input.UserName)
            ?? await UserManager.FindByEmailAsync(Input.UserName);
        if (user is null)
        {
            user = new ApplicationUser
            {
                UserName = Input.UserName,
                Email = result.Email ?? $"{Input.UserName}@corporate.local",
                EmailConfirmed = true,
            };
            var createResult = await UserManager.CreateAsync(user);
            if (!createResult.Succeeded)
            {
                errorMessage = "Error: could not provision an account for these credentials.";
                return;
            }
        }

        if (await UserManager.IsLockedOutAsync(user))
        {
            Logger.LogWarning("Sign-in blocked for deactivated account {UserName}.", Input.UserName);
            errorMessage = "Error: this account has been deactivated. Contact an administrator.";
            return;
        }

        await SignInManager.SignInAsync(user, Input.RememberMe);
        Logger.LogInformation("User {UserName} signed in via the corporate directory.", Input.UserName);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private sealed class InputModel
    {
        [Required]
        [Display(Name = "User Name")]
        public string UserName { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}
