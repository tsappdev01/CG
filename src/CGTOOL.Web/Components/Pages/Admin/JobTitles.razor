@page "/admin/job-titles"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject IJobTitleWriter JobTitleWriter
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Job Titles</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="folder">Job titles</h1>
    <p class="cg-subtitle">Control Panel — standard job title / designation options.</p>

    @if (_jobTitles is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <div class="cg-actions">
            <button type="button" class="cg-action-btn cg-good" @onclick="AddNew">+ Add job title</button>
            <button type="button" class="cg-action-btn" @onclick="() => _showPrintPreview = true">Print Preview</button>
        </div>

        <div class="cg-bulk-bar">
            <button type="button" class="cg-action-btn" disabled="@(_selectedIds.Count == 0)" @onclick="DeselectAll">Deselect all</button>
            @if (_selectedIds.Count > 0)
            {
                <span class="cg-result-count">@_selectedIds.Count selected</span>
                <button type="button" class="cg-action-btn cg-critical" @onclick="() => _bulkSetActive = false">Deactivate selected</button>
                <button type="button" class="cg-action-btn cg-good" @onclick="() => _bulkSetActive = true">Reactivate selected</button>
            }
        </div>

        @if (_bulkSetActive is not null)
        {
            <JustificationPrompt Show="true"
                                 Label="@($"Why are you {(_bulkSetActive == true ? "reactivating" : "deactivating")} {_selectedIds.Count} job title(s)?")"
                                 Toasts="Toasts"
                                 OnConfirm="BulkSetActiveAsync"
                                 OnCancel="() => _bulkSetActive = null" />
        }

        <div class="cg-controls cg-filter-bar">
            <div class="cg-search-wrap">
                <input class="cg-input" type="search" placeholder="Search job titles…"
                       @bind="_search" @bind:event="oninput" aria-label="Search job titles" />
            </div>

            <select class="cg-input cg-filter-select" value="@_statusFilter"
                    @onchange="e => _statusFilter = (string)e.Value!" aria-label="Filter by status">
                <option value="all">All statuses</option>
                <option value="active">Active only</option>
                <option value="inactive">Inactive only</option>
            </select>

            <button type="button" class="cg-action-btn cg-btn-filter" disabled="@(!HasActiveFilters)" @onclick="ClearFilters">Clear Filters</button>
            <span class="cg-result-count">@VisibleJobTitles().Count of @_jobTitles.Count shown</span>
        </div>

        <div class="cg-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="cg-select-col"><input type="checkbox" checked="@AllSelected" @onchange="e => ToggleSelectAll((bool)e.Value!)" aria-label="Select all" /></th>
                        <SortableHeader Label="Name" Column="Name" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                        <SortableHeader Label="Users" Column="Users" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                        <SortableHeader Label="Status" Column="Status" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in VisibleJobTitles())
                    {
                        <tr class="cg-data-row">
                            <td class="cg-select-col"><input type="checkbox" checked="@_selectedIds.Contains(j.Id)" @onchange="e => ToggleSelect(j.Id, (bool)e.Value!)" aria-label="Select @j.Name" /></td>
                            <td>@j.Name</td>
                            <td class="mono">@MemberCount(j.Name)</td>
                            <td><ToggleSwitch Value="j.Active" ValueChanged="() => _pendingJustify = j" /></td>
                            <td>
                                <button type="button" class="cg-action-btn" @onclick="() => Edit(j)">Edit</button>
                                <button type="button" class="cg-icon-btn" title="Print preview" @onclick="() => _printSingleRecord = j"><span class="cg-icon-print-glyph"></span></button>
                            </td>
                        </tr>
                    }

                    @if (_jobTitles.Count == 0)
                    {
                        <tr><td colspan="5">
                            <div class="cg-empty-state">
                                <h3>No job titles yet</h3>
                                <p>Use <b>+ Add job title</b> above. Job titles are the designation options offered on a user's record.</p>
                            </div>
                        </td></tr>
                    }
                    else if (VisibleJobTitles().Count == 0)
                    {
                        <tr><td colspan="5">
                            <div class="cg-empty-state">
                                <h3>Nothing matches those filters</h3>
                                <p>All @_jobTitles.Count job titles are hidden by the current search or status filter.</p>
                            </div>
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_pendingJustify is not null)
        {
            <JustificationPrompt Show="true"
                                  Label="@($"Why are you {(_pendingJustify.Active ? "deactivating" : "reactivating")} {_pendingJustify.Name}?")"
                                  Toasts="Toasts"
                                  OnConfirm="ToggleActiveAsync"
                                  OnCancel="() => _pendingJustify = null" />
        }

        @if (_showPrintPreview || _printSingleRecord is not null)
        {
            <div class="cg-print-overlay">
                <div class="cg-print-modal cg-print-modal-wide">
                    <div class="cg-print-modal-actions no-print">
                        <button type="button" class="cg-action-btn cg-good" @onclick="PrintAsync">Print / Save as PDF</button>
                        <button type="button" class="cg-action-btn" @onclick="() => { _showPrintPreview = false; _printSingleRecord = null; }">Close</button>
                    </div>
                    <div class="cg-print-area">
                        <div class="cg-print-header">
                            <img src="images/di-logo.jpg" alt="Dubai Investments" />
                            <div>
                                <h2>Corporate Governance Tool — @(_printSingleRecord is not null ? $"Job Title — {_printSingleRecord.Name}" : "Job Titles")</h2>
                                <PrintFooter />
                            </div>
                        </div>
                        <div class="cg-table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Users</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var j in PrintRows())
                                    {
                                        <tr class="cg-data-row">
                                            <td>@j.Name</td>
                                            <td class="mono">@MemberCount(j.Name)</td>
                                            <td>@(j.Active ? "Active" : "Inactive")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
