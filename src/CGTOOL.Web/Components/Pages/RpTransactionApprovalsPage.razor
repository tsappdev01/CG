@page "/rp-transactions/approvals"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IRelatedPartyTransactionWriter Writer
@inject IActivityEmailSender EmailSender
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ToastService Toasts

<PageTitle>RP Transactions — Pending My Approval</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="swap">Pending My Approval</h1>
    <p class="cg-subtitle">Related Party Transactions awaiting your decision as the designated Approver for your entity.</p>

    @if (_step == Step.Loading)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else if (_step == Step.NoAccess)
    {
        <div class="cg-empty-state">Your login isn't linked to a User record yet. Ask an Administrator to link your account on the User Management page.</div>
    }
    else if (_pending.Count == 0)
    {
        <div class="cg-empty-state">No transactions are awaiting your approval.</div>
    }
    else
    {
        @* Each tile filters to what it counts -- the first question on a queue is almost always
           "what is about to escalate" or "what is the big one". *@
        <section class="cg-kpis" aria-label="Queue overview">
            @foreach (var (key, label) in Tiles)
            {
                <button type="button" class="cg-kpi cg-kpi-button @(_filter == key ? "is-selected" : "")"
                        data-tone="@ToneOf(key)" aria-pressed="@(_filter == key)" @onclick="() => ToggleFilter(key)">
                    <div class="cg-kpi-label">@label</div>
                    <div class="cg-kpi-value">@CountOf(key)</div>
                </button>
            }
        </section>

        <div class="cg-workbench">
            <div class="cg-queue">
                <div class="cg-queue-head">
                    <div class="cg-search-wrap" style="flex:1;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.2" y2="16.2" /></svg>
                        <input type="search" placeholder="Search reference or counter-party…" @bind="_search" @bind:event="oninput" aria-label="Search the queue" />
                    </div>
                    <select class="cg-input" style="width:auto;" @bind="_sort" aria-label="Sort the queue">
                        <option value="oldest">Oldest first</option>
                        <option value="value">Highest value</option>
                    </select>
                </div>

                @foreach (var t in Queue())
                {
                    <button type="button" class="cg-queue-item @(_selectedId == t.Id ? "is-selected" : "")" @onclick="() => Select(t.Id)">
                        <div class="cg-queue-item-top">
                            <span class="cg-queue-ref">@RpTransactionDisplay.Reference(t)</span>
                            <span class="cg-queue-value">AED @t.TransactionValue.ToString("N0")</span>
                        </div>
                        <div class="cg-queue-party">@t.CounterPartyName</div>
                        <div class="cg-queue-meta">
                            <span>@(t.Member?.FullName ?? t.SubmittedByName)</span>
                            @if (RpTransactionDisplay.ApproverAge(t, DateTime.UtcNow) is { } age)
                            {
                                <span class="cg-sla" data-tone="@RpTransactionDisplay.AgeTone(age.Remaining)">
                                    <span class="cg-sla-track"><span class="cg-sla-fill" style="width:@(Math.Min(100, age.Elapsed * 100 / RelatedPartyTransactionReminderHostedService.AutoEscalateAfterDays))%;"></span></span>
                                    @age.Elapsed@("d · ")@age.Remaining left
                                </span>
                            }
                        </div>
                    </button>
                }

                @if (Queue().Count == 0)
                {
                    <div class="cg-empty-state" style="border:0;">Nothing matches.</div>
                }
            </div>

            @if (Selected is { } s)
            {
                <div class="cg-member-form" style="margin:0; max-width:none;">
                    <div class="cg-detail-head">
                        <div>
                            <div class="cg-detail-title">@RpTransactionDisplay.Reference(s) · @s.CounterPartyName</div>
                            <div class="cg-detail-sub">
                                Raised by @(s.Member?.FullName ?? s.SubmittedByName) (@(s.Company?.Name ?? "—")) · @s.DateOfRequest.ToString("dd/MM/yyyy")
                                @if (s.AmendmentCount > 0)
                                {
                                    <span> · amended @(s.AmendmentCount == 1 ? "once" : $"{s.AmendmentCount} times")</span>
                                }
                            </div>
                        </div>
                        <div style="text-align:right;">
                            <div class="cg-detail-amount">AED @s.TransactionValue.ToString("N2")</div>
                            <a class="cg-doc-chip" href="/rp-transactions/@RpTransactionDisplay.Reference(s)">Open full record</a>
                        </div>
                    </div>

                    <RpStageRail Transaction="s" />

                    @if (RpTransactionDisplay.ApproverAge(s, DateTime.UtcNow) is { } selectedAge)
                    {
                        <div class="cg-checks">
                            <span class="cg-check" data-state="@(selectedAge.Remaining <= 7 ? "fail" : selectedAge.Remaining <= 14 ? "warn" : "pass")">
                                @selectedAge.Elapsed days with you —
                                @(selectedAge.Remaining == 0
                                    ? "escalates to the CCAO at the next check"
                                    : $"escalates to the CCAO in {selectedAge.Remaining} day{(selectedAge.Remaining == 1 ? "" : "s")}")
                            </span>
                        </div>
                    }

                    <h2 style="margin-top:18px;">Transaction</h2>
                    <div class="cg-facts">
                        <div><div class="cg-fact-label">Entity</div><div class="cg-fact-value">@(s.Company?.Name ?? "—")</div></div>
                        <div><div class="cg-fact-label">Requestor</div><div class="cg-fact-value">@(s.Member?.FullName ?? s.SubmittedByName)</div></div>
                        <div><div class="cg-fact-label">Counter-party</div><div class="cg-fact-value">@s.CounterPartyName</div></div>
                        <div><div class="cg-fact-label">Date of request</div><div class="cg-fact-value">@s.DateOfRequest.ToString("dd/MM/yyyy")</div></div>
                    </div>

                    <div class="cg-fact-label">Description, including material terms and conditions</div>
                    <p style="font-size:13.5px; margin:4px 0 14px; white-space:pre-wrap;">@s.Description</p>

                    @if (s.Documents.Count > 0)
                    {
                        <div class="cg-fact-label">Documents</div>
                        <div class="cg-doc-chips" style="margin-top:6px;">
                            @foreach (var doc in s.Documents)
                            {
                                <a class="cg-doc-chip" href="@doc.FilePath" target="_blank" rel="noopener">@doc.FileName</a>
                            }
                        </div>
                    }

                    @if (s.ApproverAction == RpApproverAction.Return && !string.IsNullOrWhiteSpace(s.ApproverRemarks))
                    {
                        <div class="cg-sidepanel" style="margin-top:16px; border-left:3px solid var(--cg-warning);">
                            <h3>You returned this before</h3>
                            <p style="font-size:13px; margin:0;">@s.ApproverRemarks</p>
                        </div>
                    }

                    <label class="cg-field" style="margin-top:18px;">
                        <span>Your remarks <b style="color:var(--cg-critical);">*</b>
                            <em class="cg-subtitle" style="margin:0;">— recorded on the transaction and shown to the CCAO</em></span>
                        <textarea class="cg-input" rows="3" placeholder="Why you are approving, escalating, returning or rejecting this…"
                                  value="@RemarksFor(s.Id)" @oninput="e => _remarks[s.Id] = e.Value?.ToString() ?? string.Empty"></textarea>
                    </label>

                    <div class="cg-action-bar">
                        <button type="button" class="cg-action-btn cg-good" disabled="@_acting" @onclick="() => ApproveAsync(s)">Approve</button>
                        <button type="button" class="cg-action-btn" disabled="@_acting" @onclick="() => EscalateAsync(s)">Escalate to CCAO</button>
                        <button type="button" class="cg-action-btn" disabled="@_acting" @onclick="() => ReturnAsync(s)">Return to requestor</button>
                        <button type="button" class="cg-action-btn cg-critical" disabled="@_acting" @onclick="() => RejectAsync(s)">Reject</button>
                    </div>
                </div>
            }
        </div>
    }
</div>
