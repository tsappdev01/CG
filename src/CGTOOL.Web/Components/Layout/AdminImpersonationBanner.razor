@using System.Security.Claims
@inject AuthenticationStateProvider AuthState

<AuthorizeView>
    <Authorized>
        @if (_originalAdminName is not null)
        {
            <div class="cg-impersonation-banner cg-admin-impersonation-banner">
                Signed in as <b>@context.User.Identity?.Name</b> (support session started by <b>@_originalAdminName</b>)
                @* Ending the session signs the administrator back in, which writes a cookie, so it
                   has to be a form post rather than a circuit event. *@
                <form method="post" action="/Account/ImpersonateEnd">
                    <AntiforgeryToken />
                    <button type="submit" class="cg-action-btn">Return to my account</button>
                </form>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private string? _originalAdminName;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _originalAdminName = state.User.FindFirst(AdminImpersonationClaims.OriginalAdminName)?.Value;
    }
}
