@* The uploaded document, shown beside the fields that were read off it, so a number can be checked
   against the thing it came from without opening another tab.

   Rendered by file type rather than hopefully: a browser handed a type it cannot display either
   downloads it or shows an empty box, and an empty box beside a filled-in form reads as a bug. *@
@if (!string.IsNullOrWhiteSpace(FilePath))
{
    <aside class="cg-doc-preview">
        <div class="cg-doc-preview-head">
            <span class="cg-doc-preview-name" title="@DisplayName">@DisplayName</span>
            <a class="cg-doc-chip" href="@Source" target="_blank" rel="noopener">Open</a>
        </div>
        @if (IsPdf)
        {
            @* toolbar=0 drops the viewer's own chrome, which in a 460px column is most of the box. *@
            <iframe class="cg-doc-preview-frame" src="@(Source + "#toolbar=0&navpanes=0&view=FitH")"
                    title="@($"Preview of {DisplayName}")"></iframe>
        }
        else if (IsImage)
        {
            <img class="cg-doc-preview-image" src="@Source" alt="@($"Preview of {DisplayName}")" />
        }
        else
        {
            <p class="cg-subtitle cg-doc-preview-note">No preview for this kind of file — use <b>Open</b>.</p>
        }
    </aside>
}

@code {
    [Parameter] public string? FilePath { get; set; }

    /// <summary>The name the person uploaded, when there is one. The stored path is named after the
    /// row id, so showing it would tell them nothing.</summary>
    [Parameter] public string? OriginalFileName { get; set; }

    /// <summary>When this version of the document was stored.
    ///
    /// A document is written to a path named after its row -- "41-emiratesid.pdf" -- so replacing
    /// it reuses the same address, and the browser answers from its cache. The fields beside the
    /// preview showed the new card while the preview showed the old one, which is the worst way
    /// round: the picture is there to check the fields against.</summary>
    [Parameter] public DateTime? Version { get; set; }

    /// <summary>The path with the version on it, so a replaced file is a different address. The
    /// query goes before the fragment -- a PDF viewer's "#toolbar=0" is not part of the URL the
    /// server is asked for, and anything after it would not reach the cache key.</summary>
    private string Source => Version is { } at
        ? $"{FilePath}?v={at.Ticks}"
        : FilePath ?? string.Empty;

    private string DisplayName =>
        string.IsNullOrWhiteSpace(OriginalFileName) ? "Attached document" : OriginalFileName!;

    /// <summary>What kind of file this is, taken from the name the person uploaded and only then
    /// from the address.
    ///
    /// It used to read the address alone, which worked while that was "41-emiratesid.pdf". A stored
    /// document is served from "/documents/41" now, which has no extension at all -- so every
    /// preview would have fallen through to "no preview for this kind of file" while the document
    /// itself was perfectly displayable, and nothing would have looked broken enough to notice.</summary>
    private string Extension
    {
        get
        {
            var fromName = System.IO.Path.GetExtension(OriginalFileName ?? string.Empty);
            return (fromName is { Length: > 0 }
                ? fromName
                : System.IO.Path.GetExtension(FilePath ?? string.Empty)).ToLowerInvariant();
        }
    }

    private bool IsPdf => Extension == ".pdf";
    private bool IsImage => Extension is ".png" or ".jpg" or ".jpeg";
}
