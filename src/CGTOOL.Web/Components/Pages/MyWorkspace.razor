@page "/my-workspace"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>My Workspace</PageTitle>

<div class="cg-shell cg-shell-full cg-workspace">
    <nav class="cg-breadcrumb" aria-label="Breadcrumb">
        <a href="" class="cg-breadcrumb-home" aria-label="Dashboard"></a>
        <span class="cg-breadcrumb-sep">|</span>
        <span>My Workspace</span>
    </nav>

    @* Title and the declaration summary strip both dropped: the breadcrumb already names the page,
       and the summary repeated what My Declarations shows in full. *@
    <div class="cg-info-callout cg-workspace-notice">
        This declaration is mandatory for all Insiders, BOD members and key management personnel.
        Please ensure the information is complete and up to date.
    </div>

    @if (!_loaded)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else if (_effectiveMember is null)
    {
        <div class="cg-empty-state">
            Your login isn't linked to a User record yet, so there is nothing to show here.
            Ask an Administrator to link your account on the User Management page.
        </div>
    }
    else
    {
        @* The member's own documents, above the registers: the Emirates ID, passport and trade
           licence a declaration asks for every quarter, uploaded once and read for what they say. *@
        <section class="cg-card cg-accordion @(_documentsOpen ? "is-open" : "")">
            <button type="button" class="cg-accordion-head" aria-expanded="@_documentsOpen" @onclick="() => _documentsOpen = !_documentsOpen">
                <span class="cg-accordion-chevron" aria-hidden="true"></span>
                <span class="cg-accordion-titles">
                    <span class="cg-card-title">My Documents</span>
                    <span class="cg-subtitle">Your Emirates ID, passport, trade licence and anything else on file. The details are read off each one where document capture is configured — check them.</span>
                </span>
                @if (ExpiredDocumentCount > 0)
                {
                    <span class="cg-accordion-count cg-count-critical">@ExpiredDocumentCount expired</span>
                }
                <span class="cg-accordion-count">@_documents.Count(d => !string.IsNullOrEmpty(d.FilePath))</span>
            </button>

            @if (_documentsOpen)
            {
            <div class="cg-accordion-body">
                @foreach (var named in NamedDocumentKinds)
                {
                    var kind = named.Kind;
                    var doc = DocumentOf(kind);
                    <div class="cg-doc-panel @(IsExpired(doc) ? "is-expired" : "")">
                        <div class="cg-doc-panel-head">
                            <div>
                                <h3>@named.Title @if (IsExpired(doc)) { <span class="cg-pill-critical">Expired</span> }</h3>
                                <p class="cg-subtitle">@named.Blurb</p>
                            </div>
                            <div class="cg-doc-panel-file">
                                <InputFile OnChange="e => OnMemberDocumentSelectedAsync(kind, doc, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploadingDocument(kind)" />
                                @if (IsUploadingDocument(kind))
                                {
                                    <span class="cg-doc-upload-state">Reading…</span>
                                    <progress class="cg-doc-progress"></progress>
                                }
                                else if (doc is not null && !string.IsNullOrEmpty(doc.FilePath))
                                {
                                    <a class="cg-doc-chip" href="@doc.FilePath" target="_blank" rel="noopener">View</a>
                                }
                            </div>
                        </div>

                        @if (doc is not null && !string.IsNullOrEmpty(doc.FilePath))
                        {
                            <div class="cg-form-grid cg-captured-grid">
                                <label class="cg-field">
                                    <span>@(kind == MemberDocumentKind.TradeLicence ? "Trade License No" : kind == MemberDocumentKind.Passport ? "Passport No" : "Emirates ID No")</span>
                                    <input class="cg-input" @bind="doc.DocumentNumber" maxlength="100" />
                                </label>
                                <label class="cg-field">
                                    <span>@(kind == MemberDocumentKind.TradeLicence ? "Legal Name" : "Name on ID")</span>
                                    <input class="cg-input" @bind="doc.HolderName" maxlength="200" />
                                </label>
                                @if (kind == MemberDocumentKind.Passport)
                                {
                                    <label class="cg-field">
                                        <span>Nationality</span>
                                        <select class="cg-input" @bind="doc.Nationality">
                                            <option value="">—</option>
                                            @foreach (var country in Countries.All)
                                            {
                                                <option value="@country">@country</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="cg-field">
                                        <span>Issue Date</span>
                                        <input class="cg-input" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                                               @bind:get="UaeDate.Show(doc.IssueDate)"
                                               @bind:set="v => SetDate(v, d => doc.IssueDate = d)" />
                                    </label>
                                }
                                <label class="cg-field">
                                    <span>Expiry Date</span>
                                    <input class="cg-input@(IsExpired(doc) ? " cg-input-invalid" : "")" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                                           @bind:get="UaeDate.Show(doc.ExpiryDate)"
                                           @bind:set="v => SetDate(v, d => doc.ExpiryDate = d)" />
                                    @if (IsExpired(doc))
                                    {
                                        <span class="cg-field-error">Expired — upload a current one. A declaration cannot be submitted on it.</span>
                                    }
                                </label>
                                @if (kind == MemberDocumentKind.EmiratesId)
                                {
                                    <label class="cg-field">
                                        <span>Date of Birth</span>
                                        <input class="cg-input" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                                               @bind:get="UaeDate.Show(doc.DateOfBirth)"
                                               @bind:set="v => SetDate(v, d => doc.DateOfBirth = d)" />
                                    </label>
                                }
                            </div>
                            <div class="cg-actions cg-doc-panel-actions">
                                <button type="button" class="cg-action-btn cg-good" @onclick="() => SaveDocumentAsync(doc)">Save</button>
                                <button type="button" class="cg-action-btn cg-critical" @onclick="() => AskRemoveDocument(doc)">Remove</button>
                            </div>
                        }
                    </div>
                }

                <div class="cg-doc-panel">
                    <div class="cg-doc-panel-head">
                        <div>
                            <h3>Other Documents</h3>
                            <p class="cg-subtitle">Anything else worth keeping on file — a visa, a power of attorney, a certificate. Name it yourself; these are not read automatically.</p>
                        </div>
                        <div class="cg-doc-panel-file">
                            @if (_addingOtherDocument)
                            {
                                <InputFile OnChange="e => OnMemberDocumentSelectedAsync(MemberDocumentKind.Other, null, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploadingDocument(MemberDocumentKind.Other)" />
                                @if (IsUploadingDocument(MemberDocumentKind.Other))
                                {
                                    <span class="cg-doc-upload-state">Reading…</span>
                                    <progress class="cg-doc-progress"></progress>
                                }
                                else
                                {
                                    <button type="button" class="cg-action-btn" @onclick="CancelOtherDocument">Cancel</button>
                                }
                            }
                            else
                            {
                                <button type="button" class="cg-action-btn cg-good cg-btn-add" @onclick="AddOtherDocument">Add</button>
                            }
                        </div>
                    </div>

                    @foreach (var other in OtherDocuments())
                    {
                        <div class="cg-form-grid cg-captured-grid">
                            <label class="cg-field">
                                <span>Document name <b class="cg-req-mark">*</b></span>
                                <input class="cg-input" placeholder="What this document is" @bind="other.Title" maxlength="120" />
                            </label>
                            <label class="cg-field">
                                <span>Reference No</span>
                                <input class="cg-input" @bind="other.DocumentNumber" maxlength="100" />
                            </label>
                            <label class="cg-field">
                                <span>Expiry Date</span>
                                <input class="cg-input@(IsExpired(other) ? " cg-input-invalid" : "")" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                                       @bind:get="UaeDate.Show(other.ExpiryDate)"
                                       @bind:set="v => SetDate(v, d => other.ExpiryDate = d)" />
                                @if (IsExpired(other))
                                {
                                    <span class="cg-field-error">Expired — upload a current one.</span>
                                }
                            </label>
                            <label class="cg-field">
                                <span>File</span>
                                <span class="cg-doc-panel-file">
                                    @if (!string.IsNullOrEmpty(other.FilePath))
                                    {
                                        <a class="cg-doc-chip" href="@other.FilePath" target="_blank" rel="noopener">@(string.IsNullOrWhiteSpace(other.OriginalFileName) ? "View" : other.OriginalFileName)</a>
                                    }
                                    else
                                    {
                                        <span class="cg-subtitle">Not attached</span>
                                    }
                                </span>
                            </label>
                            <div class="cg-actions cg-doc-panel-actions cg-field-wide">
                                <button type="button" class="cg-action-btn cg-good" @onclick="() => SaveDocumentAsync(other)">Save</button>
                                <button type="button" class="cg-action-btn cg-critical" @onclick="() => AskRemoveDocument(other)">Remove</button>
                            </div>
                        </div>
                    }

                    @if (OtherDocuments().Count == 0 && !_addingOtherDocument)
                    {
                        <p class="cg-subtitle">Nothing else on file.</p>
                    }
                </div>
            </div>
            }
        </section>

        <section class="cg-card cg-accordion @(_relativesOpen ? "is-open" : "")">
            <button type="button" class="cg-accordion-head" aria-expanded="@_relativesOpen" @onclick="() => _relativesOpen = !_relativesOpen">
                <span class="cg-accordion-chevron" aria-hidden="true"></span>
                <span class="cg-accordion-titles">
                    <span class="cg-card-title">Relatives &amp; Related Parties</span>
                    <span class="cg-subtitle">Add and maintain details of your relatives, in-laws, steps and companies in which you / your relatives have an interest.</span>
                </span>
                <span class="cg-accordion-count">@_familyMembers.Count</span>
            </button>

            @if (_relativesOpen)
            {
            <div class="cg-accordion-body">
                <div class="cg-controls cg-relatives-filters">
                    <div class="cg-search-wrap">
                        <input class="cg-input" type="search" placeholder="Search name, company or Emirates ID…"
                               @bind="_search" @bind:event="oninput" @bind:after="ResetRelativesPage" aria-label="Search related parties" />
                    </div>
                    <label class="cg-field cg-relation-filter">
                        <span>Relation</span>
                        <select class="cg-input" value="@(_relationFilter?.ToString() ?? "")"
                                @onchange="e => { var v = (string?)e.Value; _relationFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<RelativeRelationship>(v); ResetRelativesPage(); }">
                            <option value="">All Relations</option>
                            @foreach (var opt in RelativeOptions)
                            {
                                <option value="@opt.Value">@opt.Label</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="cg-action-btn cg-good cg-btn-add" @onclick="OpenAddRelative">+ Add</button>
                </div>

                <div class="cg-table-wrap">
                    <table class="cg-relatives-table">
                        <thead>
                            <tr>
                                <th class="cg-col-relname">Name</th>
                                <th>Relation</th>
                                <th>Emirates ID / Passport</th>
                                <th>NIN Number</th>
                                <th>Nationality</th>
                                <th>Occupation / Business</th>
                                <th>Companies held</th>
                                <th>Documents</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in PagedRelatives())
                            {
                                var docs = RelativeDocuments(f);
                                <tr class="cg-data-row">
                                    <td class="cg-cell-name">@f.Name</td>
                                    <td>@RelationLabel(f.Relationship)</td>
                                    <td class="mono">@(IdentifierOf(f) ?? "—")</td>
                                    <td class="mono">@(string.IsNullOrWhiteSpace(f.NinNumber) ? "—" : f.NinNumber)</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.Nationality) ? "—" : f.Nationality)</td>
                                    <td>@(string.IsNullOrWhiteSpace(f.Occupation) ? "—" : f.Occupation)</td>
                                    <td>
                                        @if (f.Holdings.Count == 0)
                                        {
                                            <span class="cg-subtitle">—</span>
                                        }
                                        else
                                        {
                                            @foreach (var holding in f.Holdings)
                                            {
                                                <div class="cg-holding-line">
                                                    <span class="cg-holding-name">@holding.CompanyName</span>
                                                    <span class="cg-subtitle">
                                                        @HoldingLabel(holding.NatureOfHolding)@(holding.OwnershipPercentage is { } pct ? $" · {pct:0.##}%" : "")
                                                    </span>
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="cg-doc-chips">
                                            @foreach (var doc in docs)
                                            {
                                                <a class="cg-doc-chip" href="@doc.Path" target="_blank" rel="noopener">@doc.Short</a>
                                            }
                                            @if (docs.Count == 0)
                                            {
                                                <span class="cg-subtitle">—</span>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="cg-row-actions">
                                            <button type="button" class="cg-icon-btn" title="Edit @f.Name" @onclick="() => OpenEditRelative(f)"><span class="cg-ico cg-ico-pencil" aria-hidden="true"></span></button>
                                            <button type="button" class="cg-icon-btn cg-icon-btn-danger" title="Remove @f.Name" @onclick="() => AskRemoveRelative(f)"><span class="cg-ico cg-ico-trash" aria-hidden="true"></span></button>
                                        </span>
                                    </td>
                                </tr>
                            }

                            @if (RelativesTotal == 0)
                            {
                                <tr><td colspan="9" class="cg-empty-state">No related parties recorded yet. Use <b>+ Add</b> to add one.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="cg-table-foot">
                    <span>Showing @FirstRelativeOnPage - @LastRelativeOnPage of @RelativesTotal records</span>
                    <div class="cg-pager">
                        <button type="button" title="Previous page" disabled="@(_page <= 1)" @onclick="() => GoToRelativesPage(_page - 1)">‹</button>
                        @for (var n = 1; n <= RelativesPages; n++)
                        {
                            var target = n;
                            <button type="button" class="@(target == _page ? "active" : "")" @onclick="() => GoToRelativesPage(target)">@target</button>
                        }
                        <button type="button" title="Next page" disabled="@(_page >= RelativesPages)" @onclick="() => GoToRelativesPage(_page + 1)">›</button>
                    </div>
                </div>
            </div>
            }
        </section>

        @* Kept below the related parties rather than dropped: the Related Party & COI declaration
           offers these as an "Add from My Companies" picker, so removing them would take a feature
           away from that wizard. *@
        <section class="cg-card cg-accordion @(_companiesOpen ? "is-open" : "")">
            <button type="button" class="cg-accordion-head" aria-expanded="@_companiesOpen" @onclick="() => _companiesOpen = !_companiesOpen">
                <span class="cg-accordion-chevron" aria-hidden="true"></span>
                <span class="cg-accordion-titles">
                    <span class="cg-card-title">My Companies</span>
                    <span class="cg-subtitle">Companies you hold an interest in, with their trade licence, MOA and POA on file.</span>
                </span>
                <span class="cg-accordion-count">@_companies.Count</span>
            </button>

            @if (_companiesOpen)
            {
            <div class="cg-accordion-body">
                <div class="cg-controls cg-companies-controls">
                    <button type="button" class="cg-action-btn cg-good cg-btn-add" @onclick="OpenAddCompany">+ Add</button>
                </div>

                <div class="cg-table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Name of the Company</th>
                                <th>Nature Of Holding</th>
                                <th>Ownership %</th>
                                <th>Trade License</th>
                                <th>MOA</th>
                                <th>POA <em class="cg-subtitle" style="margin:0;">(optional)</em></th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _companies)
                            {
                                <tr class="cg-data-row">
                                    <td class="cg-cell-name">
                                        @if (c.ServesAsBoardMemberOrExecutive)
                                        {
                                            <span class="cg-pill cg-pill-role" title="You serve as a board member or senior executive of this company">Board / Exec</span>
                                        }
                                        @c.CompanyName
                                    </td>
                                    <td>@HoldingLabel(c.NatureOfHolding)</td>
                                    <td>@(c.OwnershipPercentage is { } pct ? $"{pct:0.##}%" : "—")</td>
                                    <td>@DocumentCell(c.TradeLicensePath)</td>
                                    <td>@DocumentCell(c.MoaPath)</td>
                                    <td>@DocumentCell(c.PoaPath)</td>
                                    <td>
                                        <span class="cg-row-actions">
                                            <button type="button" class="cg-icon-btn" title="Edit @c.CompanyName" @onclick="() => OpenEditCompany(c)"><span class="cg-ico cg-ico-pencil" aria-hidden="true"></span></button>
                                            <button type="button" class="cg-icon-btn cg-icon-btn-danger" title="Remove @c.CompanyName" @onclick="() => AskRemoveCompany(c)"><span class="cg-ico cg-ico-trash" aria-hidden="true"></span></button>
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (_companies.Count == 0)
                            {
                                <tr><td colspan="7" class="cg-empty-state">No companies added yet. Use <b>+ Add</b> to add one.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }
        </section>
    }
</div>

@* Add and edit both happen here rather than in the row: a related party carries eight fields and
   three documents, which does not fit a table cell, and a draft row that is abandoned halfway
   leaves the grid in a half-written state. *@
@if (_relativeDialogOpen && _relativeForm is not null)
{
    <div class="cg-modal-backdrop" @onclick="CloseRelativeDialog"></div>
    <div class="cg-modal cg-record-modal" role="dialog" aria-modal="true" aria-labelledby="cg-relative-title">
        <div class="cg-modal-head">
            <div>
                <h2 id="cg-relative-title">@(_relativeTarget is null ? "Add relative" : "Edit relative details")</h2>
                <p class="cg-subtitle">Every add, edit and delete is written to the audit trail against your name.</p>
            </div>
            <button type="button" class="cg-modal-close" aria-label="Close" @onclick="CloseRelativeDialog">×</button>
        </div>

        <div class="cg-modal-body">
            <div class="cg-form-grid">
                <label class="cg-field cg-field-wide">
                    <span>Name <b class="cg-req-mark">*</b></span>
                    <input class="cg-input" placeholder="Full name" @bind="_relativeForm.Name" maxlength="120" />
                </label>
                <label class="cg-field">
                    <span>Relation</span>
                    <select class="cg-input" @bind="_relativeForm.Relationship">
                        @foreach (var opt in RelativeOptions)
                        {
                            <option value="@opt.Value">@opt.Label</option>
                        }
                    </select>
                </label>
                <label class="cg-field">
                    <span>NIN Number</span>
                    <input class="cg-input@(Nin.IsInvalidEntry(_relativeForm.NinNumber) ? " cg-input-invalid" : "")"
                           placeholder="National Investor Number" @bind="_relativeForm.NinNumber" @bind:event="oninput"
                           maxlength="60" minlength="@Nin.MinimumLength" />
                    @if (Nin.IsInvalidEntry(_relativeForm.NinNumber))
                    {
                        <span class="cg-field-error">@Nin.Hint</span>
                    }
                </label>
                <label class="cg-field">
                    <span>Nationality</span>
                    <select class="cg-input" @bind="_relativeForm.Nationality">
                        <option value="">—</option>
                        @foreach (var country in Countries.All)
                        {
                            <option value="@country">@country</option>
                        }
                    </select>
                </label>
                <label class="cg-field">
                    <span>Occupation / Business</span>
                    <select class="cg-input" @bind="_occupationChoice">
                        <option value="">—</option>
                        @foreach (var occupation in Occupations.All)
                        {
                            <option value="@occupation">@occupation</option>
                        }
                        <option value="@Occupations.Other">Other</option>
                    </select>
                </label>
                @if (_occupationChoice == Occupations.Other)
                {
                    <label class="cg-field">
                        <span>Occupation / Business (other)</span>
                        <input class="cg-input" placeholder="Type the occupation or business" @bind="_occupationOther" maxlength="160" />
                    </label>
                }
                <div class="cg-field cg-field-wide">
                    <span>Companies held</span>
                    <span class="cg-hint">A relative can hold interests in several companies — add one row for each.</span>

                    @foreach (var holding in _relativeForm.Holdings)
                    {
                        <div class="cg-holding-card">
                        <div class="cg-holding-row">
                            <label class="cg-field">
                                <span>Company / Organization</span>
                                <input class="cg-input" placeholder="Company name" @bind="holding.CompanyName" maxlength="160" />
                            </label>
                            <label class="cg-field">
                                <span>Nature Of Holding</span>
                                <select class="cg-input" @bind="holding.NatureOfHolding">
                                    <option value="@RelatedPartyHoldingNature.None">—</option>
                                    <option value="@RelatedPartyHoldingNature.Affiliate">Affiliate</option>
                                    <option value="@RelatedPartyHoldingNature.Owned">Owned</option>
                                    <option value="@RelatedPartyHoldingNature.Subsidiary">Subsidiary</option>
                                </select>
                            </label>
                            <label class="cg-field">
                                <span>Ownership %</span>
                                <input type="number" step="0.01" min="0" max="100" class="cg-input" @bind="holding.OwnershipPercentage" />
                            </label>
                            <button type="button" class="cg-icon-btn cg-icon-btn-danger" title="Remove this company"
                                    @onclick="() => RemoveHolding(holding)"><span class="cg-ico cg-ico-trash" aria-hidden="true"></span></button>
                        </div>
                        <div class="cg-holding-detail">
                            <label class="cg-field cg-field-wide">
                                <span>Principal Business Activity</span>
                                <input class="cg-input" @bind="holding.PrincipalBusinessActivity" maxlength="400"
                                       placeholder="What the company principally does" />
                            </label>
                            <div class="cg-doc-upload cg-field-wide">
                                <span class="cg-doc-upload-label">Trade License</span>
                                <InputFile OnChange="e => OnHoldingLicenceSelectedAsync(holding, e)" accept=".png,.jpg,.jpeg,.pdf"
                                           disabled="@IsUploadingHolding(holding)" />
                                @if (IsUploadingHolding(holding))
                                {
                                    <span class="cg-doc-upload-state">Uploading…</span>
                                    <progress class="cg-doc-progress"></progress>
                                }
                                else if (!string.IsNullOrEmpty(holding.TradeLicencePath))
                                {
                                    <a class="cg-doc-chip" href="@holding.TradeLicencePath" target="_blank" rel="noopener">View</a>
                                }
                                else
                                {
                                    <span class="cg-subtitle">Not attached</span>
                                }
                            </div>
                            <label class="cg-field">
                                <span>Trade License Number</span>
                                <input class="cg-input" @bind="holding.TradeLicenceNumber" maxlength="100" />
                            </label>
                            <label class="cg-field">
                                <span>Trade License Expiry Date</span>
                                <input class="cg-input" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                                       @bind:get="UaeDate.Show(holding.TradeLicenceExpiryDate)"
                                       @bind:set="v => SetDate(v, d => holding.TradeLicenceExpiryDate = d)" />
                            </label>
                            <label class="cg-field cg-field-wide">
                                <span>License Activities</span>
                                <input class="cg-input" @bind="holding.LicenceActivities" maxlength="400" />
                            </label>
                        </div>
                        </div>
                    }

                    @if (_relativeForm.Holdings.Count == 0)
                    {
                        <p class="cg-subtitle">No companies recorded for this relative.</p>
                    }

                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="AddHolding">+ Add company</button>
                    </div>
                </div>
                <div class="cg-field cg-field-wide">
                    <span>Have shares in Dubai Investments PJSC?</span>
                    <label class="cg-switch">
                        <input type="checkbox" @bind="_relativeForm.HoldsDiShares" />
                        <span class="cg-switch-track" aria-hidden="true"></span>
                        <span class="cg-switch-label">@(_relativeForm.HoldsDiShares ? "Yes" : "No")</span>
                    </label>
                    <span class="cg-hint">Marking this here is what puts them in the Insider Trading declaration's shareholding grid.</span>
                </div>
            </div>

            <h3 class="cg-doc-heading">Documents</h3>
            @if (_relativeTarget is null)
            {
                <p class="cg-hint">Save the relative first — the documents are filed under the saved record, and this dialog stays open so you can attach them straight away.</p>
            }
            else
            {
                <div class="cg-doc-uploads">
                    @RelativeUpload("emirates-id", "Emirates ID", _relativeTarget.EmiratesIdPath)
                    @RelativeUpload("passport", "Passport", _relativeTarget.PassportPath)
                    @RelativeUpload("trade-licence", "Trade License", _relativeTarget.TradeLicencePath)
                </div>
                <p class="cg-hint">JPEG, PNG or PDF, up to 1 MB. Uploading replaces the document already on file.</p>

                <h3 class="cg-doc-heading">From the documents</h3>
                <p class="cg-hint">Read off the uploaded documents automatically where document capture is configured. Always check them — the reading is best-effort, not authoritative — and correct anything wrong before saving. Dates are @UaeDate.Pattern.ToLowerInvariant().</p>
                <div class="cg-form-grid cg-captured-grid">
                    <label class="cg-field">
                        <span>Emirates ID No</span>
                        <input class="cg-input" @bind="_relativeForm.EmiratesIdNumber" maxlength="60" />
                    </label>
                    <label class="cg-field">
                        <span>Emirates ID Expiry</span>
                        <input class="cg-input" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                               @bind:get="UaeDate.Show(_relativeForm.EmiratesIdExpiryDate)"
                               @bind:set="v => SetDate(v, d => _relativeForm.EmiratesIdExpiryDate = d)" />
                    </label>
                    <label class="cg-field">
                        <span>Passport No</span>
                        <input class="cg-input" @bind="_relativeForm.PassportNumber" maxlength="60" />
                    </label>
                    <label class="cg-field">
                        <span>Passport Expiry</span>
                        <input class="cg-input" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                               @bind:get="UaeDate.Show(_relativeForm.PassportExpiryDate)"
                               @bind:set="v => SetDate(v, d => _relativeForm.PassportExpiryDate = d)" />
                    </label>
                    <label class="cg-field">
                        <span>Trade License No</span>
                        <input class="cg-input" @bind="_relativeForm.TradeLicenceNumber" maxlength="100" />
                    </label>
                    <label class="cg-field">
                        <span>Expiry</span>
                        <input class="cg-input" placeholder="@UaeDate.Pattern.ToLowerInvariant()" maxlength="10"
                               @bind:get="UaeDate.Show(_relativeForm.TradeLicenceExpiryDate)"
                               @bind:set="v => SetDate(v, d => _relativeForm.TradeLicenceExpiryDate = d)" />
                    </label>
                    <label class="cg-field cg-field-wide">
                        <span>Legal Name</span>
                        <input class="cg-input" @bind="_relativeForm.TradeLicenceLegalName" maxlength="200" />
                    </label>
                </div>
            }
        </div>

        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="CloseRelativeDialog">@(_relativeTarget is null ? "Cancel" : "Close")</button>
            <button type="button" class="cg-action-btn cg-good" @onclick="SaveRelativeAsync">Save</button>
        </div>
    </div>
}

