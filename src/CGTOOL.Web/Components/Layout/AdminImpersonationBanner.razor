@using System.Security.Claims
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject IAuditLogger AuditLog
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        @if (_originalAdminName is not null)
        {
            <div class="cg-impersonation-banner cg-admin-impersonation-banner">
                Signed in as <b>@context.User.Identity?.Name</b> (support session started by <b>@_originalAdminName</b>)
                <button type="button" class="cg-action-btn" @onclick="ReturnToAdminAsync">Return to my account</button>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private string? _originalAdminName;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _originalAdminName = state.User.FindFirst(AdminImpersonationClaims.OriginalAdminName)?.Value;
    }

    private async Task ReturnToAdminAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var originalAdminId = state.User.FindFirst(AdminImpersonationClaims.OriginalAdminId)?.Value;
        var impersonatedName = state.User.Identity?.Name;
        if (originalAdminId is null) return;

        var admin = await UserManager.FindByIdAsync(originalAdminId);
        if (admin is null) return;

        await SignInManager.SignInAsync(admin, isPersistent: false);
        await AuditLog.LogAsync(admin.UserName ?? "unknown", AuditAction.ImpersonationEnd, nameof(ApplicationUser), originalAdminId, $"Ended support session acting as {impersonatedName}");

        Nav.NavigateTo("/", forceLoad: true);
    }
}
