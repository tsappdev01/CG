@page "/declarations/related-party-coi"
@page "/declarations/related-party-coi/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ILogger<SubmitRelatedPartyCoiDeclaration> Logger
@inject IRelatedPartyCoiDeclarationWriter Writer
@inject IDocumentStore Documents
@inject ClientContext Client
@inject IFamilyMemberWriter FamilyMemberWriter
@inject IOwnedCompanyWriter CompanyWriter
@inject IFamilyMemberHoldingWriter HoldingWriter
@inject IActivityEmailSender EmailSender
@inject SqlDbMailSender SqlMail
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject ImpersonationContext Impersonation
@inject ToastService Toasts
@inject IWebHostEnvironment Env
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IUaePassAuthService UaePass
@inject Microsoft.AspNetCore.DataProtection.IDataProtector UaePassStateProtector
@inject IDocumentIntelligenceService DocIntel
@inject IJSRuntime JS
@inject Branding Branding

@* Onboarding first, if they have not done it -- then back to this page. *@
<CGTOOL.Web.Components.Layout.OnboardingGate />

<PageTitle>Related Party & COI Declaration</PageTitle>

<div class="cg-shell cg-declaration-wizard">
    @* The one operation on this page where a second click or a closed tab costs something
       real, so it takes the screen rather than only the button. *@
    <CgBlockingOverlay Visible="_submitting"
                       Title="@(_hadExistingRow ? "Saving your changes…" : "Submitting your declaration…")"
                       Detail="Signing and recording your declaration. Please do not close this page." />

    <p><a href="/my-declarations">← Back to Declarations</a></p>
    <h1 data-icon="doc">Related Party &amp; Conflict of Interest Declaration</h1>
    @* The declarant's own statement, not a caption: it is what they are signing, and it named them
       in the same grey as a hint. *@
    <p class="cg-declaration-lead">I, @_effectiveMember?.FullName, the undersigned, declare the following in respect of Related Party and Conflict of Interest matters.</p>
    @if (Impersonation.ActingMemberId is not null)
    {
        <p class="cg-subtitle">Submitting on behalf of <b>@Impersonation.ActingMemberName</b>.</p>
    }

    @if (_step == Step.Loading)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else if (_step == Step.NoAccess)
    {
        <div class="cg-empty-state">
            @(_effectiveMember is null
                ? "Your login isn't linked to a User record yet. Ask an Administrator to link your account on the User Management page."
                : "You don't have Related Party / Conflict of Interest declaration access assigned. Ask an Administrator to grant it on your User record.")
        </div>
    }
    else if (_step == Step.NotDue)
    {
        <div class="cg-empty-state">No Related Party &amp; COI declaration is currently due for @_effectiveMember!.FullName.</div>
    }
    else if (_step == Step.EditWindowClosed)
    {
        <div class="cg-empty-state">The due date for this declaration has passed, so it can no longer be edited.</div>
    }
    else
    {
        @if (IsWizardStep)
        {
            <div class="cg-info-callout">
                <p>@(_isEditing ? "Editing your submitted declaration. " : "")Due date: <b class="mono">@_run!.DueDateUtc.ToLocalDisplay("dd/MM/yyyy")</b></p>
            </div>

            @* One section per step. The form asks five separate questions and the answer to each is
               its own list; on one page they run together, and the member cannot see how much is
               left. Every step is reachable from here, forwards through its own checks. *@
            <ol class="cg-stepper cg-stepper-wrap" aria-label="Progress">
                @for (var i = 0; i < ChevronSteps.Length; i++)
                {
                    var wizardStep = ChevronSteps[i];
                    var number = i + 1;
                    if (i > 0)
                    {
                        <li class="cg-step-rule @RuleClass(i - 1)" aria-hidden="true"></li>
                    }
                    <li class="cg-step @StepClass(wizardStep.Step)">
                        <button type="button" class="cg-step-jump" @onclick="() => GoToStep(wizardStep.Step)">
                            <span class="cg-step-num">@number</span>
                            <span class="cg-step-label">@wizardStep.Label</span>
                        </button>
                    </li>
                }
            </ol>

            @* The "please confirm all information entered above is correct" window that used to
               stand between the last step and Review is gone. It asked the member to confirm the
               form before showing them the summary of it, which is the page that exists to be
               checked -- and the review step asks the same thing again, after they have seen it.
               Next now shows the review page. *@
        }

        @if (_step == Step.Relatives)
        {
            <div class="cg-member-form cg-declaration-form">
                <div class="cg-info-callout">
                    <p>I, @_effectiveMember?.FullName, the undersigned, hereby declare the following:</p>
                    <ul class="cg-pointer-list">
                        <li>List of my relatives.</li>
                        <li>Companies in which I, or my relatives, hold more than 30% of paid-up share capital, wherein my shareholding represents both beneficial interest and ability to influence strategic, operating, investing and financial decision-making.</li>
                        <li>Companies in which I serve as a board member or senior executive.</li>
                    </ul>
                </div>

                <h3>List of Relatives</h3>
                <div class="cg-info-callout">
                    <p><b>Relative:</b> Father, mother, brother, sister, children, spouse, father-in-law, mother-in-law, and children of the spouse.</p>
                </div>
                <DeclareChoice Question="Do you have any relatives to declare?"
                               Value="@AnswerFor(Step.Relatives)"
                               ValueChanged="@(v => Answer(Step.Relatives, v))" />
                @if (!_nothingRelatives)
                {
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Name</th><th>Relationship</th><th>On file</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var r in _relatives)
                                {
                                    <tr class="cg-data-row">
                                        <td>
                                            <input id="@RelativeFieldId(r, "name")" class="cg-input" @bind="r.Name" maxlength="120" />
                                        </td>
                                        <td>
                                            <select class="cg-input" @bind="r.Relationship">
                                                @foreach (var opt in RelativeOptions)
                                                {
                                                    <option value="@opt.Value">@opt.Label</option>
                                                }
                                            </select>
                                        </td>
                                        <td>@(r.FamilyMemberId is null ? "This declaration only" : "In My Workspace")</td>
                                        <td><button type="button" class="cg-action-btn cg-critical" @onclick="() => AskRemoveRelative(r)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="AddRelative">+ Add relative</button>
                        @if (_myFamilyMembers.Count > 0)
                        {
                            <select class="cg-input" style="width:auto; display:inline-block;" @bind="_pickFamilyMemberId">
                                <option value="">Add from My Family…</option>
                                @foreach (var f in AvailableFamilyMembers)
                                {
                                    <option value="@f.Id">@f.Name (@RelationshipLabel(f.Relationship))</option>
                                }
                            </select>
                            <button type="button" class="cg-action-btn" disabled="@(_pickFamilyMemberId is null)" @onclick="AddFromMyFamily">Add</button>
                        }
                    </div>
                }

                @StepActions()
            </div>
        }
        else if (_step == Step.SelfOwned)
        {
            <div class="cg-member-form cg-declaration-form">
                <h3>Companies in which I own ≥30% of paid-up share capital</h3>
                @* The declaration's own wording, not a generic "nothing to declare": what the member
                   is answering here is a specific statement about their shareholdings, and it is the
                   statement they are signing. *@
                <DeclareChoice Question="Are there companies in which you hold more than 30% of paid up capital, wherein your shareholding represents both beneficial interest and the ability to influence strategic, operating, investing and financial decision-making?"
                               YesLabel="Yes — I'll list them below"
                               NoLabel="No — there are none"
                               Value="@AnswerFor(Step.SelfOwned)"
                               ValueChanged="@(v => Answer(Step.SelfOwned, v))" />
                @if (!_nothingSelfOwned)
                {
                    @foreach (var row in _selfOwnedCompanies)
                    {
                        <CompanyRowEditor Row="row" Relatives="_relatives" ShowRelativeLink="false"
                                          OnRemove="() => RemoveCompany(_selfOwnedCompanies, row)"
                                          OnFileSelected="e => UploadTradeLicenseFileAsync(row, e)"
                                          OnFileRemove="doc => RemoveDocument(row, doc)" />
                    }
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="() => AddCompany(_selfOwnedCompanies)">+ Add company</button>
                        @if (_myCompanies.Count > 0)
                        {
                            <select class="cg-input" style="width:auto; display:inline-block;" @bind="_pickSelfCompanyId">
                                <option value="">Add from My Companies…</option>
                                @foreach (var c in AvailableCompaniesFor(_selfOwnedCompanies))
                                {
                                    <option value="@c.Id">@c.CompanyName</option>
                                }
                            </select>
                            <button type="button" class="cg-action-btn" disabled="@(_pickSelfCompanyId is null)" @onclick='() => { AddCompanyFromWorkspace(_selfOwnedCompanies, _pickSelfCompanyId); _pickSelfCompanyId = null; }'>Add</button>
                        }
                    </div>
                }

                @StepActions()
            </div>
        }
        else if (_step == Step.RelativeOwned)
        {
            <div class="cg-member-form cg-declaration-form">
                <h3>Companies in which a relative owns ≥30% of its shares</h3>
                <DeclareChoice Question="Are there companies owned 30% or more by one of your relatives?"
                               NoLabel="No — there are none"
                               Value="@AnswerFor(Step.RelativeOwned)"
                               ValueChanged="@(v => Answer(Step.RelativeOwned, v))" />
                @if (!_nothingRelativeOwned)
                {
                    @foreach (var row in _relativeOwnedCompanies)
                    {
                        <CompanyRowEditor Row="row" Relatives="_relatives" ShowRelativeLink="true" EarlierCompanies="_selfOwnedCompanies"
                                          OnRemove="() => RemoveCompany(_relativeOwnedCompanies, row)"
                                          OnFileSelected="e => UploadTradeLicenseFileAsync(row, e)"
                                          OnFileRemove="doc => RemoveDocument(row, doc)" />
                    }
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="() => AddCompany(_relativeOwnedCompanies)">+ Add company</button>
                        @if (_myCompanies.Count > 0)
                        {
                            <select class="cg-input" style="width:auto; display:inline-block;" @bind="_pickRelativeCompanyId">
                                <option value="">Add from My Companies…</option>
                                @foreach (var c in AvailableCompaniesFor(_relativeOwnedCompanies))
                                {
                                    <option value="@c.Id">@c.CompanyName</option>
                                }
                            </select>
                            <button type="button" class="cg-action-btn" disabled="@(_pickRelativeCompanyId is null)" @onclick='() => { AddCompanyFromWorkspace(_relativeOwnedCompanies, _pickRelativeCompanyId); _pickRelativeCompanyId = null; }'>Add</button>
                        }
                    </div>
                }

                @StepActions()
            </div>
        }
        else if (_step == Step.BoardRoles)
        {
            <div class="cg-member-form cg-declaration-form">
                <h3>Companies in which I serve as board member or senior executive</h3>
                <DeclareChoice Question="Are there companies in which you serve as a board member or senior executive?"
                               NoLabel="No — there are none"
                               Value="@AnswerFor(Step.BoardRoles)"
                               ValueChanged="@(v => Answer(Step.BoardRoles, v))" />
                @if (!_nothingBoardRoles)
                {
                    @foreach (var row in _boardRoleCompanies)
                    {
                        <CompanyRowEditor Row="row" Relatives="_relatives" ShowRelativeLink="false" EarlierCompanies="CompaniesBeforeBoardRole"
                                          OnRemove="() => RemoveCompany(_boardRoleCompanies, row)"
                                          OnFileSelected="e => UploadTradeLicenseFileAsync(row, e)"
                                          OnFileRemove="doc => RemoveDocument(row, doc)" />
                    }
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="() => AddCompany(_boardRoleCompanies)">+ Add company</button>
                        @if (_myCompanies.Count > 0)
                        {
                            <select class="cg-input" style="width:auto; display:inline-block;" @bind="_pickBoardCompanyId">
                                <option value="">Add from My Companies…</option>
                                @foreach (var c in AvailableCompaniesFor(_boardRoleCompanies))
                                {
                                    <option value="@c.Id">@c.CompanyName</option>
                                }
                            </select>
                            <button type="button" class="cg-action-btn" disabled="@(_pickBoardCompanyId is null)" @onclick='() => { AddCompanyFromWorkspace(_boardRoleCompanies, _pickBoardCompanyId); _pickBoardCompanyId = null; }'>Add</button>
                        }
                    </div>
                }

                @StepActions()
            </div>
        }
        else if (_step == Step.Conflicts)
        {
            <div class="cg-member-form cg-declaration-form">
                <h2 class="cg-section-heading">Conflict of Interest Declaration</h2>
                @if (IsBod)
                {
                    <div class="cg-info-callout">
                        <p>
                            A conflict of interest is a transaction or relationship that presents or might conflict with a Board member's obligations owed to @Branding.ParentHoldingCompany
                            and the Board member's personal, business or other interests. All conflict of interest are not necessarily prohibited or harmful to it.
                            However, full disclosure of all actual and potential conflicts is necessary, and the interested Board member(s) shall be recused from
                            participating in discussions and voting on the matter. Board members must recognize that conflict of interest, even when in fact it
                            may not exist, can be damaging to them and to @Branding.ParentHoldingCompany and accordingly, must be avoided.
                        </p>
                    </div>
                }
                else
                {
                    <div class="cg-info-callout">
                        <p>
                            A conflict of interest is a transaction or relationship that presents or might conflict with an Employee's obligations owed to
                            @Branding.ParentHoldingCompany and its Group Companies, and the individual's personal, business or other interests. All conflicts of interest
                            are not necessarily prohibited or harmful to them. However, full disclosure of all actual and potential conflicts is necessary, and the
                            interested individual shall be recused from participating in decision making on the matter. An employee must recognize that conflict
                            of interest, even when in fact it may not exist, can be damaging to them and to @Branding.ParentHoldingCompany and accordingly, must be avoided.
                        </p>
                    </div>
                    @* Bold, and not a subtitle: the paragraph above it explains what a conflict of
                       interest is, which is background. This one is an undertaking the declarant is
                       giving, and it was set in the same grey as the explanation. *@
                    <p class="cg-undertaking">
                        I hereby declare that if at any time following the submission of this form I become aware of any actual or potential transactions,
                        relationships, or activities that could reasonably be expected to give rise to potential conflicts of interest, I will promptly
                        escalate the matter to the Corporate Affairs Office of @Branding.ParentHoldingCompany for further decision making on the matter.
                    </p>
                }
                <DeclareChoice Question="Do you have any conflicts of interest to declare?"
                               NoLabel="No — I have none"
                               Value="@AnswerFor(Step.Conflicts)"
                               ValueChanged="@(v => Answer(Step.Conflicts, v))" />
                @if (!_nothingConflicts)
                {
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Legal Name of Company/Counterparty</th><th>Principal Business Activity</th><th>Nature of Holding</th><th>Nature of Interest</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in _conflicts)
                                {
                                    <tr class="cg-data-row">
                                        <td>
                                            @{ var suggestions = ConflictSuggestionsFor(c); }
                                            <input id="@ConflictFieldId(c, "name")" class="cg-input" list="@($"conflict-company-names-{c.Key:N}")" value="@c.CompanyOrCounterpartyName"
                                                   @oninput="e => OnConflictCompanyNameInput(c, e)" maxlength="160" />
                                            @if (suggestions.Count > 0)
                                            {
                                                <datalist id="@($"conflict-company-names-{c.Key:N}")">
                                                    @foreach (var name in suggestions)
                                                    {
                                                        <option value="@name"></option>
                                                    }
                                                </datalist>
                                            }
                                        </td>
                                        <td><input class="cg-input" @bind="c.PrincipalBusinessActivity" maxlength="400" /></td>
                                        <td>
                                            <select id="@ConflictFieldId(c, "nature")" class="cg-input" @bind="c.NatureOfHolding">
                                                <option value="">Select…</option>
                                                @foreach (var opt in NatureOfHoldingOptions)
                                                {
                                                    <option value="@opt">@opt</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="cg-input" @bind="c.NatureOfInterest" maxlength="400" placeholder="Supplier, customer&hellip;" /></td>
                                        <td><button type="button" class="cg-action-btn cg-critical" @onclick="() => RemoveConflict(c)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="cg-actions"><button type="button" class="cg-action-btn" @onclick="AddConflict">+ Add conflict</button></div>
                }

                <div class="cg-info-callout">
                    <p>
                        <b>Note:</b>
                        @(IsBod
                            ? "The above declared information on I. Related Party and II. Conflict of Interest shall be reviewed at every board meeting and updated for any changes in a Board Member's interests."
                            : "Updates to the above declared information on I. Related Party and II. Conflict of Interest, if any, shall be made on the online platform for submission of RP declarations, as and when they occur.")
                    </p>
                </div>

                @StepActions()

            </div>
        }
        else if (_step == Step.Documents)
        {
            <div class="cg-member-form cg-declaration-form">
                <h2 class="cg-section-heading">Supporting documents</h2>
                <p class="cg-hint">
                    What this declaration asks for is set in the Document Center, separately from the
                    Insider Declaration — the two need not ask for the same things. Anything marked
                    <b>Required</b> must be attached before you can continue.
                </p>

                @if (!RequestedDocumentTypes.Any())
                {
                    <div class="cg-empty-state">
                        <h3>No documents are asked for</h3>
                        <p>This declaration does not ask for any supporting documents. Continue to the review step.</p>
                    </div>
                }
                else
                {
                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn" @onclick="PullDocumentsFromWorkspaceAsync">Load from My Workspace</button>
                    </div>
                    <p class="cg-hint">
                        What you already keep on file is brought across, and this declaration keeps its own
                        copy — replacing a document in My Workspace later will not change what you declared here.
                    </p>

                    @foreach (var type in RequestedDocumentTypes)
                    {
                        var row = DocumentFor(type.Id);
                        var attached = DocumentUrl.Exists(row.BlobId, row.FilePath);
                        <div class="cg-doc-panel @(IsExpiredOn(row.ExpiryDate) ? "is-expired" : "")">
                            <div class="cg-doc-panel-head">
                                <div>
                                    <h3>
                                        @type.Name
                                        <span class="cg-pill @(IsRequired(type) ? "cg-pill-required" : "")">@(IsRequired(type) ? "Required" : "Optional")</span>
                                        <span class="cg-pill cg-pill-status @(attached ? "cg-pill-done" : "")">@(attached ? "Attached" : "Not attached")</span>
                                    </h3>
                                    <p class="cg-subtitle">@(string.IsNullOrWhiteSpace(type.Description) ? $"JPG, PNG or PDF, up to {UploadLimits.SupportingDocumentLimit}." : type.Description)</p>
                                </div>
                                <div class="cg-doc-panel-file">
                                    <InputFile OnChange="e => OnDeclarationDocumentSelectedAsync(type, e)" accept=".png,.jpg,.jpeg,.pdf" disabled="@IsUploadingDocument(type.Id)" />
                                    @if (IsUploadingDocument(type.Id))
                                    {
                                        <CgProgressBar Label="Uploading…" Percent="DocumentUploadProgress(type.Id)" />
                                    }
                                </div>
                            </div>

                            @if (attached)
                            {
                            <div class="cg-doc-panel-split">
                                <div>
                                    <div class="cg-form-grid cg-captured-grid">
                                        <label class="cg-field">
                                            <span>Reference number</span>
                                            <input class="cg-input" @bind="row.DocumentNumber" maxlength="100" />
                                        </label>
                                        @* The card above this says it wants "number, name on the ID,
                                           expiry and date of birth" and used to offer nowhere to put
                                           the name -- so the one field saying whose document this is
                                           was the one not captured. It comes across with the file
                                           when the document is loaded from My Workspace. *@
                                        <label class="cg-field">
                                            <span>Name as per the document</span>
                                            <input class="cg-input" @bind="row.HolderName" maxlength="200" />
                                        </label>
                                        <label class="cg-field">
                                            <span>Expiry date</span>
                                            <UaeDateInput CssClass="@(IsExpiredOn(row.ExpiryDate) ? "cg-input-invalid" : null)"
                                                          Value="row.ExpiryDate"
                                                          ValueChanged="d => row.ExpiryDate = d" />
                                            @if (IsExpiredOn(row.ExpiryDate))
                                            {
                                                <span class="cg-field-error">Expired — attach a current one.</span>
                                            }
                                        </label>
                                    </div>
                                    <div class="cg-actions cg-doc-panel-actions">
                                        <button type="button" class="cg-action-btn cg-critical" @onclick="() => RemoveDeclarationDocument(row)">Remove</button>
                                    </div>
                                </div>
                                <DocumentPreview FilePath="@DocumentUrl.For(row.BlobId, row.FilePath)" OriginalFileName="@row.OriginalFileName" Version="@DocumentVersion(row.DocumentTypeId)" />
                            </div>
                            }
                        </div>
                    }
                }

                @StepActions()

            </div>
        }
        else if (_step == Step.Review)
        {
            <div class="cg-member-form cg-declaration-form">
                <h2>@(_loadedAsSubmittedEdit ? "Are you sure you want to proceed for editing your declaration?" : "Are you sure you want to submit below declaration form?")</h2>

                <div class="cg-table-wrap">
                    <table>
                        <tbody>
                            <tr><th>List of Relatives</th><td>@(_nothingRelatives ? "Nothing to declare" : $"{_relatives.Count} declared")</td></tr>
                            <tr><th>Companies I own ≥30%</th><td>@(_nothingSelfOwned ? "Nothing to declare" : $"{_selfOwnedCompanies.Count} declared")</td></tr>
                            <tr><th>Companies a relative owns ≥30%</th><td>@(_nothingRelativeOwned ? "Nothing to declare" : $"{_relativeOwnedCompanies.Count} declared")</td></tr>
                            <tr><th>Companies I serve as board member/executive</th><td>@(_nothingBoardRoles ? "Nothing to declare" : $"{_boardRoleCompanies.Count} declared")</td></tr>
                            <tr><th>Conflicts of Interest</th><td>@(_nothingConflicts ? "Nothing to declare" : $"{_conflicts.Count} declared")</td></tr>
                        </tbody>
                    </table>
                </div>

                @* The documents the previous step collected. They were missing from this sheet
                   entirely: a member who had attached their Emirates ID got to the last stage, saw
                   no mention of it, and had no way to tell whether it had gone with the
                   declaration. The Insider declaration's review has shown them all along. *@
                @if (RequestedDocumentTypes.Any())
                {
                    <h2 class="cg-section-heading">Documents attached</h2>
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Document</th><th>Name on it</th><th>Number</th><th>Expiry</th><th>Attached</th></tr></thead>
                            <tbody>
                                @foreach (var type in RequestedDocumentTypes)
                                {
                                    var reviewRow = DocumentFor(type.Id);
                                    <tr class="cg-data-row">
                                        <td>@type.Name</td>
                                        <td>@(string.IsNullOrWhiteSpace(reviewRow.HolderName) ? "—" : reviewRow.HolderName)</td>
                                        <td class="mono">@(string.IsNullOrWhiteSpace(reviewRow.DocumentNumber) ? "—" : reviewRow.DocumentNumber)</td>
                                        <td class="mono">@(reviewRow.ExpiryDate is { } on ? on.ToString("dd/MM/yyyy") : "—")</td>
                                        <td>
                                            @if (IsAttached(reviewRow))
                                            {
                                                <span class="cg-pill cg-pill-done">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="cg-pill @(IsRequired(type) ? "cg-pill-required" : "")">No</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <p class="cg-subtitle">Please review carefully. You can still edit this declaration from Declarations until the due date (<b class="mono">@_run!.DueDateUtc.ToLocalDisplay("dd/MM/yyyy")</b>).</p>

                @* The attestation sits on the review sheet itself. It used to open in a
                   "Confirm and submit" window; business asked for the popup to go, and Submit
                   to conclude the declaration from here. The signature is still captured and
                   still stored -- it is reproduced on the RP & COI reports -- so it moved onto
                   the page rather than being dropped. *@
                <h2 class="cg-section-heading">Confirm and submit</h2>

                <label class="cg-field">
                    <span>Typed signature (full name)</span>
                    <input class="cg-input" @bind="_attestationName" maxlength="160" />
                </label>

                @* The drawn signature was dropped at the business's request: the typed name above
                   and the confirmation below are what the declarant gives now, and neither is
                   harder to stand behind than a finger-drawn line. A declaration signed before
                   this still carries its signature -- the column, the stored image and the block
                   on the reports are all untouched, so nothing already filed loses what it was
                   signed with. *@
                <dl class="cg-signature-block">
                    <div><dt>Full Name</dt><dd>@_effectiveMember!.FullName</dd></div>
                    <div><dt>Date</dt><dd class="mono">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</dd></div>
                </dl>

                @* The offer to verify is hidden. A declaration that was verified still
                   says so, and the UAE PASS round trip behind it is untouched --
                   StartUaePassVerificationAsync and the callback still work -- so
                   offering it again is putting the button back. *@
                @if (_uaePassVerifiedAtUtc is not null)
                {
                    <div class="cg-info-callout">
                        <p>✅ Identity verified via <b>UAE PASS</b> as <b>@_uaePassVerifiedName</b> on <span class="mono">@_uaePassVerifiedAtUtc.Value.ToLocalDisplay("dd MMM yyyy HH:mm")</span>.</p>
                    </div>
                }

                <label class="cg-switch cg-undertakings-confirm">
                    <input type="checkbox" @bind="_attestationConfirmed" />
                    <span class="cg-switch-track" aria-hidden="true"></span>
                    <span class="cg-switch-label">I, @_attestationName, confirm the above declaration is complete and accurate.</span>
                </label>

                <div class="cg-actions">
                    <button type="button" class="cg-action-btn" disabled="@_submitting" @onclick="() => _step = Step.Conflicts">← Back to edit</button>
                    @* Save as Draft, as on every capture step. It was missing only here, so
                       somebody who reached the last stage and wanted to come back to it had to
                       step backwards to find the button. The Insider declaration offers it on
                       its review step for the same reason. *@
                    <button type="button" class="cg-action-btn" disabled="@(_savingDraft || _submitting)" @onclick="SaveDraftAsync">@(_savingDraft ? "Saving…" : "Save as Draft")</button>
                    @* Submit files the declaration from here. No intermediate window. *@
                    <CgBusyButton CssClass="cg-good" Disabled="@(!_attestationConfirmed || _savingDraft)"
                                  BusyLabel="Submitting…" OnClick="SubmitAsync">
                        Submit
                    </CgBusyButton>
                </div>
            </div>
        }
        else if (_step == Step.Done)
        {
            <div class="cg-empty-state">
                @* The declarant's own clock, not the server's. It said "19:47 UTC" to someone who
                   had pressed Submit at 23:47, which reads as the wrong time rather than the same
                   time somewhere else -- and this line is the receipt for when they filed.
                   Converted explicitly to UAE time rather than to the machine's local time, so it
                   stays right if the site is ever hosted somewhere else. *@
                <p><b>Your Related Party &amp; COI declaration was @(_hadExistingRow ? "updated" : "submitted") successfully</b> on @UaeTime.FromUtc(_submittedAtUtc!.Value).ToString("dd MMM yyyy HH:mm") GST.</p>
                <p><a href="/my-declarations">Return to Declarations</a></p>
            </div>
        }
    }
</div>

@* Corrections made in the declaration are corrections to the register too, if the member wants
   them there. Asked once on the way out of the step rather than per field, and shown as a list:
   several records' changes written out as a sentence is a paragraph to decode, not a question to
   answer. *@
@if (_pendingWorkspaceUpdates is { Count: > 0 } workspaceUpdates)
{
    <div class="cg-modal-backdrop" @onclick="DeclineWorkspaceUpdates"></div>
    <div class="cg-modal cg-ws-modal" role="dialog" aria-modal="true" aria-labelledby="cg-ws-title">
        <div class="cg-modal-head">
            <div>
                <h2 id="cg-ws-title">Update My Workspace?</h2>
                <p class="cg-subtitle">
                    @(workspaceUpdates.Count == 1
                        ? "You entered this differently here from what My Workspace holds."
                        : $"You entered {workspaceUpdates.Count} of these differently here from what My Workspace holds.")
                </p>
            </div>
            <button type="button" class="cg-modal-close" aria-label="Close" @onclick="DeclineWorkspaceUpdates">&times;</button>
        </div>

        <div class="cg-modal-body">
            @foreach (var update in workspaceUpdates)
            {
                <div class="cg-ws-card">
                    <div class="cg-ws-company">@update.Title</div>
                    @foreach (var change in update.Changes)
                    {
                        <div class="cg-ws-field">@change.Field</div>
                        <div class="cg-ws-change">
                            <span class="@BeforeClass(string.IsNullOrWhiteSpace(change.Before))">@BlankAware(change.Before)</span>
                            <span class="cg-ws-arrow" aria-hidden="true">&rarr;</span>
                            <span class="cg-ws-after">@BlankAware(change.After)</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="DeclineWorkspaceUpdates">Keep to this declaration</button>
            <button type="button" class="cg-action-btn cg-good" @onclick="ConfirmWorkspaceUpdatesAsync">Update My Workspace</button>
        </div>
    </div>
}

@* Removing a relative that came from the register is two different acts wearing one button, so it
   asks which one is meant rather than guessing. *@
@if (_pendingRelativeRemoval is { } pendingRelative)
{
    <div class="cg-modal-backdrop" @onclick="CancelRemoveRelative"></div>
    <div class="cg-modal cg-confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="cg-coi-del-title">
        <div class="cg-modal-head">
            <div>
                <h2 id="cg-coi-del-title">Remove @pendingRelative.Name?</h2>
                <p class="cg-subtitle">@RelationshipLabel(pendingRelative.Relationship) — also recorded in My Workspace.</p>
            </div>
            <button type="button" class="cg-modal-close" aria-label="Close" @onclick="CancelRemoveRelative">×</button>
        </div>

        <div class="cg-modal-body">
            <p>Remove them from My Workspace as well, or only from this declaration?</p>
            <p class="cg-hint">Removing from My Workspace deletes the related party and everything recorded against them there — documents, NIN, nature of holding. Removing from this declaration leaves the register untouched, and they will be listed again on your next one.</p>
        </div>

        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="CancelRemoveRelative">Cancel</button>
            <button type="button" class="cg-action-btn" @onclick="RemoveRelativeFromDeclarationOnly">This declaration only</button>
            <button type="button" class="cg-action-btn cg-critical" @onclick="RemoveRelativeEverywhereAsync">Remove from both</button>
        </div>
    </div>
}

@code {
    /// <summary>Back, Save as Draft and Next, the same on every capture step. Save as Draft stays on
    /// all of them: a member part-way through step two should not have to reach the end to keep what
    /// they have entered.</summary>
    private RenderFragment StepActions() => @<div class="cg-actions cg-step-actions">
        @if (PreviousStep is { } previous)
        {
            <button type="button" class="cg-action-btn" @onclick="() => GoToStep(previous)">← Back</button>
        }
        <button type="button" class="cg-action-btn" disabled="@_savingDraft" @onclick="SaveDraftAsync">@(_savingDraft ? "Saving…" : "Save as Draft")</button>
        @if (NextStep is { } next)
        {
            @* One label for every step, review included. The step before review used to say
               "Proceed to Submission", which read as the thing that files the declaration on a
               button that only turns the page -- and now that review is not numbered in the
               chevron, there is nothing left for it to be proceeding to. *@
            <button type="button" class="cg-action-btn cg-good" @onclick="() => GoToStep(next)">Next →</button>
        }
    </div>;
}
