@page "/reports/rp-coi-submission"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer

<PageTitle>RP and COI Submission Report</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="report">RP and COI submission report</h1>
    <p class="cg-subtitle">Everyone notified of a Related Party &amp; Conflict of Interest declaration for a period, and whether they have completed it.</p>

    @if (_rows is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <ReportViewer Report="Build()">
            <Filters>
                <div class="cg-search-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.2" y2="16.2" /></svg>
                    <input type="search" placeholder="Search user…" @bind="_search" @bind:event="oninput" aria-label="Search user" />
                </div>
                <select class="cg-input" style="width:auto;" @bind="_yearFilter" aria-label="Filter by year">
                    <option value="0">All years</option>
                    @foreach (var y in Years()) { <option value="@y">@y</option> }
                </select>
                <select class="cg-input" style="width:auto;" @bind="_quarterFilter" aria-label="Filter by quarter">
                    <option value="0">All quarters</option>
                    <option value="1">Q1 (Jan–Mar)</option><option value="2">Q2 (Apr–Jun)</option>
                    <option value="3">Q3 (Jul–Sep)</option><option value="4">Q4 (Oct–Dec)</option>
                </select>
                <select class="cg-input" style="width:auto;" @bind="_companyFilter" aria-label="Filter by entity">
                    <option value="0">All entities</option>
                    @foreach (var c in _companies ?? []) { <option value="@c.Id">@c.Name</option> }
                </select>
                <select class="cg-input" style="width:auto;" @bind="_statusFilter" aria-label="Filter by status">
                    <option value="">Submitted and not</option>
                    <option value="submitted">Submitted only</option>
                    <option value="pending">Not submitted only</option>
                </select>
            </Filters>
        </ReportViewer>
    }
</div>
