@page "/admin/user-management"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IMemberWriter MemberWriter
@inject IMemberIdentityImporter IdentityImporter
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject ProfilePictureResolver ProfilePictures
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IJSRuntime JS
@inject IEntraDirectorySync EntraSync
@inject IDirectoryImporter DirectoryImporter
@inject Branding Branding
@inject IMemberWelcomeEmailSender WelcomeEmailSender

<PageTitle>User Management</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="users">User Management</h1>
    <p class="cg-subtitle">Manage users, assign roles and control access across the system.</p>

    <AuthorizeView Roles="@GovernanceRoles.Administrator" Context="adminCtx">
        <Authorized>
            <div class="cg-member-form cg-um-roles">
                <div class="cg-roles-bar">
                    <div class="cg-roles-main">
                        <h2>Roles</h2>
                        <div class="cg-role-chip-row">
                            @foreach (var role in _roles ?? [])
                            {
                                <span class="cg-role-chip @RolePillClass(role.Name)">
                                    <span class="cg-role-chip-icon @(role.Name == GovernanceRoles.Administrator ? "cg-role-icon-shield" : "cg-role-icon-user")" aria-hidden="true"></span>
                                    @role.Name
                                    @if (!GovernanceRoles.All.Contains(role.Name))
                                    {
                                        <button type="button" class="cg-role-chip-remove" title="Delete role" @onclick="() => _roleToDelete = role.Name">×</button>
                                    }
                                </span>
                            }
                            <input class="cg-input cg-role-new-input" placeholder="New role name" @bind="_newRoleName" aria-label="New role name" />
                            <button type="button" class="cg-action-btn" @onclick="CreateRoleAsync">+ Create Role</button>
                        </div>
                    </div>

                    <div class="cg-roles-stats">
                        <span class="cg-roles-stats-icon" aria-hidden="true"></span>
                        <div class="cg-roles-stat">
                            <span class="cg-roles-stat-label">Total Users</span>
                            <span class="cg-roles-stat-value">@(_members?.Count ?? 0)</span>
                        </div>
                        <div class="cg-roles-stat">
                            <span class="cg-roles-stat-label"><span class="cg-dot-good"></span> Active Users</span>
                            <span class="cg-roles-stat-value">@(_members?.Count(m => m.Active) ?? 0)</span>
                        </div>
                    </div>
                </div>

                @if (_roleToDelete is not null)
                {
                    <JustificationPrompt Show="true"
                                         Label="@($"Why are you deleting the role '{_roleToDelete}'?")"
                                         Toasts="Toasts"
                                         OnConfirm="DeleteRoleAsync"
                                         OnCancel="() => _roleToDelete = null" />
                }
            </div>
        </Authorized>
    </AuthorizeView>

    @if (_members is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <div>
            <div class="cg-tabs" role="tablist">
                <button type="button" class="cg-tab @(_statusFilter == StatusFilter.Active ? "active" : "")" role="tab" aria-selected="@(_statusFilter == StatusFilter.Active)" @onclick="() => SetStatusFilter(StatusFilter.Active)">
                    Active
                </button>
                <button type="button" class="cg-tab @(_statusFilter == StatusFilter.Recent ? "active" : "")" role="tab" aria-selected="@(_statusFilter == StatusFilter.Recent)" @onclick="() => SetStatusFilter(StatusFilter.Recent)">
                    Recent
                </button>
                <button type="button" class="cg-tab @(_statusFilter == StatusFilter.Inactive ? "active" : "")" role="tab" aria-selected="@(_statusFilter == StatusFilter.Inactive)" @onclick="() => SetStatusFilter(StatusFilter.Inactive)">
                    Inactive
                </button>
            </div>
        </div>

        @if (_statusFilter == StatusFilter.Recent)
        {
            <div class="cg-actions">
                <span class="cg-subtitle" style="margin:0;">Window (open item, TBC with Corporate Affairs):</span>
                @foreach (var days in RecentWindowOptions)
                {
                    <button type="button" class="cg-action-btn @(_recentDays == days ? "cg-good" : "")" @onclick="() => SetRecentWindow(days)">Last @days days</button>
                }
            </div>
        }

        <div class="cg-controls cg-filter-bar">
            <div class="cg-search-wrap">
                <input class="cg-input" type="search" placeholder="Search users by name, email or role…" @bind="_search" @bind:event="oninput" @bind:after="ResetToFirstPage" aria-label="Search users" />
            </div>

            <select class="cg-input cg-filter-select" value="@_companyFilter" @onchange="e => SetCompanyFilter(int.Parse((string)e.Value!))" aria-label="Filter by entity">
                <option value="0">All entities</option>
                @foreach (var c in _companies ?? [])
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>

            <select class="cg-input cg-filter-select" value="@_departmentFilter" @onchange="e => SetDepartmentFilter(int.Parse((string)e.Value!))" aria-label="Filter by department">
                <option value="0">All Departments</option>
                @foreach (var d in _departments ?? [])
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>

            <select class="cg-input cg-filter-select" value="@_roleFilter" @onchange="e => SetRoleFilter((string)e.Value!)" aria-label="Filter by role">
                <option value="">All Roles</option>
                @foreach (var r in _roles ?? [])
                {
                    <option value="@r.Name">@r.Name</option>
                }
            </select>

            <button type="button" class="cg-action-btn cg-btn-filter" disabled="@(!HasActiveFilters)" @onclick="ClearFilters">Clear Filters</button>
            <button type="button" class="cg-action-btn cg-btn-sync" disabled="@_syncing" @onclick="SyncFromEntraAsync"
                    title="@(EntraSync.IsConfigured ? "Load users from Entra ID" : "Entra ID is not configured for this deployment")">
                @(_syncing ? "Syncing…" : "Sync from Entra ID")
            </button>
            <button type="button" class="cg-action-btn cg-btn-upload" disabled="@_importing" @onclick="() => _showUpload = !_showUpload"
                    title="Load users from a spreadsheet instead of Entra ID">
                @(_importing ? "Importing…" : "Upload user list")
            </button>
            <button type="button" class="cg-action-btn cg-good cg-btn-add" @onclick="AddNew">Add User</button>
        </div>

        @* Stands in for Sync from Entra ID where a deployment has no tenant connection. It runs the
           same import, so what lands is the same thing the tenant sync would have produced. *@
        @if (_showUpload)
        {
            <section class="cg-upload-panel">
                <div class="cg-upload-head">
                    <h2>Upload a user list</h2>
                    <button type="button" class="cg-icon-btn" title="Close" @onclick="() => _showUpload = false">×</button>
                </div>

                <p class="cg-subtitle">
                    A spreadsheet (.xlsx or .csv) with one row per person. <b>Display Name</b>,
                    <b>Email Address</b> and <b>Company Name</b> are required; Department, Title, Role
                    and Reporting Manager are optional. Columns are matched by heading, so their order
                    does not matter. Someone already here is updated rather than duplicated — matched
                    on their email address. An entity that does not exist yet is created.
                </p>
                <p class="cg-subtitle">
                    If the file also has <b>NIN</b>, <b>EmiratesID</b>, <b>NameOnEmiratesID</b> or
                    <b>Nationality</b>, those are loaded at the same time as what each person is asked
                    to confirm during onboarding. Rows without either a NIN or an Emirates ID are
                    imported as people but hold nothing for onboarding to show, so those members are
                    asked to supply their own. The card scans themselves are uploaded under
                    <b>Onboarding Data</b>.
                </p>

                <div class="cg-upload-row">
                    <InputFile OnChange="OnUserListSelectedAsync" accept=".xlsx,.xls,.csv" disabled="@_importing" />
                    <a class="cg-action-btn" href="/admin/user-list-template.csv" download>Download template</a>
                </div>

                @* A directory of a few hundred people takes long enough that a screen showing
                   nothing reads as a hang, and the upload gets abandoned half-applied. *@
                @if (_progressPhase != ImportPhase.Idle)
                {
                    <div class="cg-import-progress" role="status" aria-live="polite">
                        <div class="cg-import-progress-head">
                            <span class="cg-import-progress-label">@ProgressLabel</span>
                            @if (!ProgressIsIndeterminate)
                            {
                                <span class="cg-import-progress-pct mono">@ProgressPercent%</span>
                            }
                        </div>
                        <div class="cg-progress-track @(ProgressIsIndeterminate ? "indeterminate" : "")"
                             role="progressbar"
                             aria-valuemin="0" aria-valuemax="100"
                             aria-valuenow="@(ProgressIsIndeterminate ? null : ProgressPercent.ToString())"
                             aria-label="@ProgressLabel">
                            <span class="cg-progress-fill" style="width:@(ProgressIsIndeterminate ? 100 : ProgressPercent)%"></span>
                        </div>
                        <p class="cg-subtitle">Leave this page open until it finishes.</p>
                    </div>
                }

                @if (_importResult is not null)
                {
                    <div class="cg-upload-result">
                        <b>@_importResult</b>
                        @if (_importProblems.Count > 0)
                        {
                            <details open>
                                <summary>@_importProblems.Count row(s) need attention</summary>
                                <ul>
                                    @foreach (var problem in _importProblems.Take(25))
                                    {
                                        <li>@problem</li>
                                    }
                                </ul>
                                @if (_importProblems.Count > 25)
                                {
                                    <p class="cg-subtitle">…and @(_importProblems.Count - 25) more.</p>
                                }
                            </details>
                        }
                    </div>
                }
            </section>
        }

        <div class="cg-bulk-bar">
            <button type="button" class="cg-action-btn" disabled="@(_selectedIds.Count == 0)" @onclick="DeselectAll">Deselect all</button>
            @if (_selectedIds.Count > 0)
            {
                <span class="cg-result-count">@_selectedIds.Count selected</span>
                <button type="button" class="cg-action-btn cg-critical" @onclick="() => _bulkSetActive = false">Deactivate selected</button>
                <button type="button" class="cg-action-btn cg-good" @onclick="() => _bulkSetActive = true">Reactivate selected</button>
                <button type="button" class="cg-action-btn" @onclick="() => _bulkDeclarations = true">Set what they declare</button>
                <button type="button" class="cg-action-btn cg-good" @onclick="() => _bulkNotify = true">Notify selected</button>
            }
        </div>

        @if (_bulkNotify)
        {
            <div class="cg-print-overlay">
                <div class="cg-confirm-modal">
                    <h3>Email @_notifiable.Count of these @_selectedIds.Count people?</h3>
                    <p>
                        They are sent the link to submit their declarations. This is the same email a
                        new user gets, and it can be sent again later if someone misses it.
                    </p>
                    @if (_notifiable.Count < _selectedIds.Count)
                    {
                        <p class="cg-hint">
                            @(_selectedIds.Count - _notifiable.Count) of the selected have no email
                            address on their record and are skipped.
                        </p>
                    }
                    <p class="cg-hint">
                        The link points at <b>@Branding.PublicBaseUrl</b>. If that is not where this site
                        answers, set <code>Branding:PublicBaseUrl</code> before sending.
                    </p>

                    @if (_notifyProgress is not null)
                    {
                        <p class="cg-hint">@_notifyProgress</p>
                    }

                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn cg-good"
                                disabled="@(_notifying || _notifiable.Count == 0)" @onclick="BulkNotifyAsync">
                            Send @_notifiable.Count email(s)
                        </button>
                        <button type="button" class="cg-action-btn" disabled="@_notifying" @onclick="() => _bulkNotify = false">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (_bulkDeclarations)
        {
            <div class="cg-print-overlay">
                <div class="cg-confirm-modal">
                    <h3>What should these @_selectedIds.Count people declare?</h3>
                    <p>
                        Ticking a box turns that declaration on for all of them. Leaving one unticked
                        leaves it exactly as it is on each record &mdash; nothing is switched off here.
                    </p>

                    <label class="cg-check-row">
                        <input type="checkbox" @bind="_bulkInsider" /> Insider Trading
                    </label>
                    <label class="cg-check-row">
                        <input type="checkbox" @bind="_bulkCoi" /> Conflict of Interest
                    </label>
                    <label class="cg-check-row">
                        <input type="checkbox" @bind="_bulkRpRegister" /> Related Party Register
                    </label>
                    <label class="cg-check-row">
                        <input type="checkbox" @bind="_bulkRpTransactions" /> Related Party Transactions
                    </label>

                    <p class="cg-hint">
                        This does not decide who receives the declaration email &mdash; that goes to every
                        active member with an address. It decides what is waiting for them when they
                        follow the link.
                    </p>

                    <div class="cg-actions">
                        <button type="button" class="cg-action-btn cg-primary"
                                disabled="@(!_bulkInsider && !_bulkCoi && !_bulkRpRegister && !_bulkRpTransactions)"
                                @onclick="BulkSetDeclarationsAsync">
                            Apply to @_selectedIds.Count selected
                        </button>
                        <button type="button" class="cg-action-btn" @onclick="() => _bulkDeclarations = false">Cancel</button>
                    </div>
                </div>
            </div>
        }

        @if (_bulkSetActive is not null)
        {
            <JustificationPrompt Show="true"
                                 Label="@($"Why are you {(_bulkSetActive == true ? "reactivating" : "deactivating")} {_selectedIds.Count} user(s)?")"
                                 Toasts="Toasts"
                                 OnConfirm="BulkSetActiveAsync"
                                 OnCancel="() => _bulkSetActive = null" />
        }

        <div class="cg-members-layout">
            <div class="cg-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="cg-select-col"><input type="checkbox" checked="@AllVisibleSelected" @onchange="e => ToggleSelectAllVisible((bool)e.Value!)" aria-label="Select all visible" /></th>
                            <th class="cg-num-col">#</th>
                            <SortableHeader Label="User" Column="Name" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                            <th>Role</th>
                            <SortableHeader Label="Entity Name" Column="Entity" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                            <SortableHeader Label="Department" Column="Department" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                            <SortableHeader Label="Created on" Column="CreatedOn" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                            @if (_statusFilter == StatusFilter.Recent)
                            {
                                <th>Recency</th>
                            }
                            <th>Onboarding</th>
                            <SortableHeader Label="Status" Column="Active" CurrentColumn="@_sortColumn" Ascending="_sortAscending" OnSort="Sort" />
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowNumber = (_page - 1) * _pageSize; }
                        @foreach (var m in PagedMembers())
                        {
                            rowNumber++;
                            <tr class="cg-data-row">
                                <td class="cg-select-col"><input type="checkbox" checked="@_selectedIds.Contains(m.Id)" @onchange="e => ToggleSelect(m.Id, (bool)e.Value!)" aria-label="Select @m.FullName" /></td>
                                <td class="cg-num-col">@rowNumber</td>
                                <td>
                                    <div class="cg-user-cell">
                                        @{ var account = _users?.FirstOrDefault(u => u.Id == m.ApplicationUserId); var photo = ProfilePictures.Resolve(account?.ProfilePictureBlobId, account?.ProfilePicturePath); }
                                        @if (!string.IsNullOrEmpty(photo))
                                        {
                                            <img src="@photo" alt="" class="cg-table-avatar" />
                                        }
                                        else
                                        {
                                            <span class="cg-table-avatar-placeholder @AvatarTint(m.FullName)">@(m.FullName.Length > 0 ? m.FullName[..1].ToUpperInvariant() : "?")</span>
                                        }
                                        <span>
                                            <span class="cg-user-cell-name">@m.FullName</span><br />
                                            <span class="cg-user-cell-sub">@m.JobTitle</span>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @foreach (var roleName in RolesOf(m))
                                    {
                                        <span class="cg-pill @RolePillClass(roleName)">
                                            <span class="cg-role-chip-icon @(roleName == GovernanceRoles.Administrator ? "cg-role-icon-shield" : "cg-role-icon-user")" aria-hidden="true"></span>
                                            @roleName
                                        </span>
                                    }
                                    @if (RolesOf(m).Count == 0)
                                    {
                                        <span class="cg-subtitle">—</span>
                                    }
                                </td>
                                <td>@(m.Company?.Name ?? "—")</td>
                                <td>@m.Department?.Name</td>
                                <td class="mono">@m.CreatedAtUtc.ToLocalDisplay("dd/MM/yyyy")</td>
                                @if (_statusFilter == StatusFilter.Recent)
                                {
                                    <td class="mono">@RecencyLabel(m)</td>
                                }
                                <td>
                                    @{ var onboarding = OnboardingOf(m); }
                                    <span class="cg-pill @OnboardingPillClass(onboarding)" title="@OnboardingTitle(onboarding)">
                                        @OnboardingLabel(onboarding)
                                    </span>
                                </td>
                                <td>
                                    <span class="cg-status-cell">
                                        <ToggleSwitch Value="m.Active" ValueChanged="() => _pendingJustify = m" />
                                        <span class="cg-status-text @(m.Active ? "on" : "off")">@(m.Active ? "Active" : "Inactive")</span>
                                    </span>
                                </td>
                                <td>
                                    <span class="cg-row-actions">
                                        <button type="button" class="cg-icon-btn" title="Edit @m.FullName" @onclick="() => Edit(m)"><span class="cg-ico cg-ico-pencil" aria-hidden="true"></span></button>
                                        <button type="button" class="cg-icon-btn" title="View @m.FullName" @onclick="() => Edit(m)"><span class="cg-ico cg-ico-eye" aria-hidden="true"></span></button>
                                        <button type="button" class="cg-icon-btn" title="Print preview" @onclick="() => _printSingleRecord = m"><span class="cg-ico cg-ico-print" aria-hidden="true"></span></button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cg-table-foot">
                <span>Showing @FirstRowOnPage to @LastRowOnPage of @FilteredMembers().Count users</span>
                <div class="cg-pager">
                    <button type="button" title="Previous page" disabled="@(_page <= 1)" @onclick="() => GoToPage(_page - 1)">‹</button>
                    @foreach (var p in PageNumbers())
                    {
                        var target = p;
                        <button type="button" class="@(target == _page ? "active" : "")" @onclick="() => GoToPage(target)">@target</button>
                    }
                    <button type="button" title="Next page" disabled="@(_page >= TotalPages)" @onclick="() => GoToPage(_page + 1)">›</button>
                    <select class="cg-input cg-page-size" value="@_pageSize" @onchange="e => SetPageSize(int.Parse((string)e.Value!))" aria-label="Rows per page">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size / page</option>
                        }
                    </select>
                </div>
            </div>

            @if (_pendingJustify is not null)
            {
                <JustificationPrompt Show="true"
                                     Label="@($"Why are you {(_pendingJustify.Active ? "deactivating" : "reactivating")} {_pendingJustify.FullName}? (Deactivating blocks their login.)")"
                                     Toasts="Toasts"
                                     OnConfirm="ToggleActiveAsync"
                                     OnCancel="() => _pendingJustify = null" />
            }
        </div>

        @if (_printSingleRecord is not null)
        {
            <div class="cg-print-overlay">
                <div class="cg-print-modal cg-print-modal-wide">
                    <div class="cg-print-modal-actions no-print">
                        <button type="button" class="cg-action-btn cg-good" @onclick="PrintAsync">Print / Save as PDF</button>
                        <button type="button" class="cg-action-btn" @onclick="() => _printSingleRecord = null">Close</button>
                    </div>
                    <div class="cg-print-area">
                        <div class="cg-print-header">
                            <img src="images/di-logo.jpg" alt="DIP Holding PLC" />
                            <div>
                                <h2>@Branding.ParentHoldingCompany — User — @_printSingleRecord.FullName</h2>
                                <PrintFooter />
                            </div>
                        </div>
                        <div class="cg-table-wrap">
                            <table>
                                <tbody>
                                    <tr><th>Full name</th><td>@_printSingleRecord.FullName</td></tr>
                                    <tr><th>Job title</th><td>@(_printSingleRecord.JobTitle ?? "—")</td></tr>
                                    <tr><th>Entity</th><td>@(_printSingleRecord.Company?.Name ?? "—")</td></tr>
                                    <tr><th>Department</th><td>@(_printSingleRecord.Department?.Name ?? "—")</td></tr>
                                    <tr><th>Email</th><td>@(_printSingleRecord.Email ?? "—")</td></tr>
                                    <tr><th>Created on</th><td>@_printSingleRecord.CreatedAtUtc.ToLocalDisplay("dd/MM/yyyy")</td></tr>
                                    <tr><th>Last modified</th><td>@_printSingleRecord.ModifiedAtUtc.ToLocalDisplay("dd/MM/yyyy")</td></tr>
                                    <tr><th>Status</th><td>@(_printSingleRecord.Active ? "Active" : "Inactive")</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
