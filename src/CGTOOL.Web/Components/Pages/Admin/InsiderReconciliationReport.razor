@page "/reports/insider-reconciliation"
@attribute [Authorize(Roles = GovernanceRoles.AnyAdministrator)]
@rendermode InteractiveServer

<PageTitle>Declared vs Actual Trading</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="report">Declared vs actual trading</h1>
    <p class="cg-subtitle">What insiders declared buying and selling, against what the DFM recorded on the same investor number.</p>

    @if (_loading)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <ReportViewer Report="Build()">
            <Filters>
                <div class="cg-search-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.2" y2="16.2" /></svg>
                    <input type="search" placeholder="Name or NIN…" @bind="_search" @bind:event="oninput" aria-label="Search name or NIN" />
                </div>
                <select class="cg-input" style="width:auto;" @bind="_yearFilter" aria-label="Filter by year">
                    <option value="0">All years</option>
                    @foreach (var year in Years())
                    {
                        <option value="@year">@year</option>
                    }
                </select>
                <select class="cg-input" style="width:auto;" @bind="_quarterFilter" aria-label="Filter by quarter">
                    <option value="0">All quarters</option>
                    <option value="1">Q1</option>
                    <option value="2">Q2</option>
                    <option value="3">Q3</option>
                    <option value="4">Q4</option>
                </select>
                <select class="cg-input" style="width:auto;" @bind="_verdictFilter" aria-label="Filter by outcome">
                    <option value="exceptions">Exceptions only</option>
                    <option value="">Everything</option>
                    <option value="@(nameof(Verdict.NotDeclared))">Not declared</option>
                    <option value="@(nameof(Verdict.NotAtDfm))">Not seen at the DFM</option>
                    <option value="@(nameof(Verdict.Differs))">Quantities differ</option>
                    <option value="@(nameof(Verdict.Agrees))">Agrees</option>
                </select>
            </Filters>
        </ReportViewer>
    }
</div>
