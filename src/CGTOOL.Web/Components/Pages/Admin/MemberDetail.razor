@page "/admin/user-management/member/{Id:int}"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@using System.Security.Claims
@inject ApplicationDbContext Db
@inject IMemberWriter MemberWriter
@inject IMemberImpersonationApprovalWriter ImpersonationWriter
@inject IMemberNotificationWriter NotificationWriter
@inject IDirectoryEmployeeProvider DirectoryProvider
@inject IAuditLogger AuditLog
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IMemberWelcomeEmailSender WelcomeEmailSender
@inject NavigationManager Nav
@inject ILogger<MemberDetail> Logger
@inject ToastService Toasts
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject ILogger<MemberDetail> Logger

<PageTitle>@(Id == 0 ? "New User" : "Edit User")</PageTitle>

<div class="cg-shell">
    <p><a href="/admin/user-management">← Back to User Management</a></p>

    @if (_editing is null || _companies is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <EditForm Model="_editing" OnValidSubmit="SaveAsync" class="cg-member-form cg-member-page">
            <DataAnnotationsValidator />
            <h1 data-icon="user">
                @(_editing.Id == 0 ? "New user" : $"Edit — {_editing.FullName}")
                @if (_editing.Id != 0)
                {
                    <button type="button" class="cg-icon-btn" title="Notify user by email"
                            disabled="@string.IsNullOrWhiteSpace(_editing.Email)"
                            @onclick="ShowNotifyPrompt">
                        <span class="cg-icon-mail-glyph" aria-hidden="true"></span>
                    </button>
                }
            </h1>

            <p class="cg-form-intro">
                Fill in who this person is, then tick what they are responsible for. Anything marked
                <span class="cg-req-mark">*</span> is needed before you can save.
            </p>

            @* ---------------- 1. Who they are ---------------- *@
            <section class="cg-form-section">
                <div class="cg-form-section-head">
                    <span class="cg-form-step">1</span>
                    <div>
                        <h2>Who is this person?</h2>
                        <p class="cg-subtitle">Their name, where they work and how to reach them.</p>
                    </div>
                </div>

                <div class="cg-form-grid">
                    <label class="cg-field">
                        <span>Entity <em class="cg-req-mark">*</em></span>
                        <select class="cg-input" @bind="_editing.CompanyId" @bind:after="OnCompanyChangedAsync">
                            <option value="0">Choose the company they belong to…</option>
                            @foreach (var c in _companies.Where(c => c.Active || c.Id == _editing.CompanyId))
                            {
                                <option value="@c.Id">@c.Name@(c.Active ? "" : " (inactive)")</option>
                            }
                        </select>
                        <ValidationMessage For="() => _editing.CompanyId" class="cg-error" />
                    </label>

                    <label class="cg-field">
                        <span>Full name <em class="cg-req-mark">*</em></span>
                        <InputText class="cg-input" @bind-Value="_editing.FullName" maxlength="120" placeholder="As it should appear on declarations" />
                        <ValidationMessage For="() => _editing.FullName" class="cg-error" />
                    </label>

                    <label class="cg-field">
                        <span>Job title</span>
                        <InputText class="cg-input" @bind-Value="_editing.JobTitle" maxlength="120" placeholder="e.g. Head of Treasury" />
                    </label>

                    <label class="cg-field">
                        <span>Department</span>
                        <select class="cg-input" @bind="_editing.DepartmentId">
                            <option value="">Not set</option>
                            @foreach (var d in _departments!.Where(d => d.Active || d.Id == _editing.DepartmentId))
                            {
                                <option value="@d.Id">@d.Name@(d.Active ? "" : " (inactive)")</option>
                            }
                        </select>
                    </label>

                    <label class="cg-field cg-field-wide">
                        <span>Email address</span>
                        <InputText class="cg-input" @bind-Value="_editing.Email" maxlength="160" placeholder="name@dubaiinvestments.com" />
                        <p class="cg-hint">Declaration reminders and the welcome email are sent here.</p>
                        <ValidationMessage For="() => _editing.Email" class="cg-error" />
                    </label>
                </div>

                @if (_editing.CompanyId != 0)
                {
                    @if (_adSynced)
                    {
                        <div class="cg-ad-status cg-ad-ok">
                            <div>
                                <b>Save typing:</b> this entity is connected to the company directory,
                                so the details above can be filled in for you.
                            </div>
                            <button type="button" class="cg-action-btn" @onclick="LoadFromDirectoryAsync">Fill from directory</button>
                        </div>
                    }
                    else
                    {
                        <div class="cg-ad-status cg-ad-warn">
                            This entity is not connected to the company directory, so please type the details in.
                        </div>
                    }
                }
            </section>

            @* ---------------- 2. What they must declare ---------------- *@
            <section class="cg-form-section">
                <div class="cg-form-section-head">
                    <span class="cg-form-step">2</span>
                    <div>
                        <h2>What does this person have to declare?</h2>
                        <p class="cg-subtitle">Tick everything that applies. They will be asked for each one you tick.</p>
                    </div>
                </div>

                @* Replaces a multi-select that needed Ctrl-click, which is the single hardest
                   control for someone who does not use software all day. *@
                <div class="cg-choice-grid">
                    <label class="cg-choice @(_editing.InsiderTradingAccess ? "on" : "")">
                        <input type="checkbox" @bind="_editing.InsiderTradingAccess" />
                        <span class="cg-choice-body">
                            <span class="cg-choice-title">Insider Trading</span>
                            <span class="cg-choice-desc">Declares their own and their relatives' dealings in DI shares each quarter.</span>
                        </span>
                    </label>
                    <label class="cg-choice @(_editing.ConflictOfInterestAccess ? "on" : "")">
                        <input type="checkbox" @bind="_editing.ConflictOfInterestAccess" />
                        <span class="cg-choice-body">
                            <span class="cg-choice-title">Conflict of Interest</span>
                            <span class="cg-choice-desc">Declares interests that could conflict with their duties to DI.</span>
                        </span>
                    </label>
                    <label class="cg-choice @(_editing.RelatedPartyRegisterAccess ? "on" : "")">
                        <input type="checkbox" @bind="_editing.RelatedPartyRegisterAccess" />
                        <span class="cg-choice-body">
                            <span class="cg-choice-title">Related Party Register</span>
                            <span class="cg-choice-desc">Lists their relatives and the companies they are connected to.</span>
                        </span>
                    </label>
                    <label class="cg-choice @(_editing.RelatedPartyTransactionAccess ? "on" : "")">
                        <input type="checkbox" @bind="_editing.RelatedPartyTransactionAccess" />
                        <span class="cg-choice-body">
                            <span class="cg-choice-title">Related Party Transactions</span>
                            <span class="cg-choice-desc">May raise transactions with a related party for approval.</span>
                        </span>
                    </label>
                </div>
            </section>

            @* ---------------- 3. Their standing ---------------- *@
            <section class="cg-form-section">
                <div class="cg-form-section-head">
                    <span class="cg-form-step">3</span>
                    <div>
                        <h2>Their standing in the group</h2>
                        <p class="cg-subtitle">Only tick what is true — these change who has to approve what.</p>
                    </div>
                </div>

                <div class="cg-form-grid">
                    <label class="cg-field">
                        <span>Reporting manager</span>
                        <select class="cg-input" @bind="_editing.ReportingManagerId">
                            <option value="">Not set</option>
                            @foreach (var m in _members!.Where(m => m.Id != _editing.Id && m.Active))
                            {
                                <option value="@m.Id">@m.FullName</option>
                            }
                        </select>
                        <p class="cg-hint">Who they report to. Optional.</p>
                    </label>

                    <label class="cg-field">
                        <span>Position in Related Party Transaction approvals</span>
                        <select class="cg-input" @bind="_editing.RpTransactionRole">
                            <option value="@RpTransactionRole.None">Not part of the approval chain</option>
                            <option value="@RpTransactionRole.Ccao">CCAO — confirms the governance review</option>
                            <option value="@RpTransactionRole.Cfo">CFO</option>
                            <option value="@RpTransactionRole.Coo">COO</option>
                            <option value="@RpTransactionRole.MdCeo">MD &amp; CEO</option>
                        </select>
                        <p class="cg-hint">This is a position in the transaction workflow, not a system permission.</p>
                    </label>
                </div>

                <div class="cg-choice-grid cg-choice-grid-compact">
                    <label class="cg-choice @(_editing.IsBoardMember ? "on" : "")">
                        <input type="checkbox" @bind="_editing.IsBoardMember" />
                        <span class="cg-choice-body"><span class="cg-choice-title">Board member</span></span>
                    </label>
                    <label class="cg-choice @(_editing.IsExecutiveManagement ? "on" : "")">
                        <input type="checkbox" @bind="_editing.IsExecutiveManagement" />
                        <span class="cg-choice-body"><span class="cg-choice-title">Executive Management</span></span>
                    </label>
                    <label class="cg-choice @(_editing.IsExternalMember ? "on" : "")">
                        <input type="checkbox" @bind="_editing.IsExternalMember" />
                        <span class="cg-choice-body">
                            <span class="cg-choice-title">External member</span>
                            <span class="cg-choice-desc">Not a direct DI Group employee.</span>
                        </span>
                    </label>
                    <label class="cg-choice @(_editing.CanBeImpersonated ? "on" : "")">
                        <input type="checkbox" @bind="_editing.CanBeImpersonated" />
                        <span class="cg-choice-body">
                            <span class="cg-choice-title">Someone may file on their behalf</span>
                            <span class="cg-choice-desc">For Related Party Register and Conflict of Interest declarations.</span>
                        </span>
                    </label>
                </div>

                @if (_editing.CanBeImpersonated)
                {
                    <div class="cg-subsection">
                        <span class="cg-field-label">Who may file on their behalf?</span>
                        @if (_editing.Id == 0)
                        {
                            <p class="cg-hint">Save this person first, then choose who may file for them.</p>
                        }
                        else
                        {
                            <div class="cg-checkbox-list">
                                @foreach (var candidate in _members!.Where(m => m.Id != _editing.Id && m.Active))
                                {
                                    var id = candidate.Id;
                                    <label class="cg-checkbox-item">
                                        <input type="checkbox" checked="@_approvedImpersonatorIds.Contains(id)"
                                               @onchange="e => ToggleImpersonatorAsync(id, (bool)e.Value!)" />
                                        <span>@candidate.FullName</span>
                                    </label>
                                }
                            </div>
                            <p class="cg-hint">Tick each person who is allowed to file for them.</p>
                        }
                    </div>
                }
            </section>

            @* ---------------- 4. Sign-in ---------------- *@
            <section class="cg-form-section">
                <div class="cg-form-section-head">
                    <span class="cg-form-step">4</span>
                    <div>
                        <h2>How they sign in</h2>
                        <p class="cg-subtitle">Link the person to the account they sign in with.</p>
                    </div>
                </div>

                <div class="cg-form-grid">
                    <label class="cg-field">
                        <span>Sign-in account</span>
                        <select class="cg-input" @bind="_editing.ApplicationUserId" @bind:after="LoadAuditAsync">
                            <option value="">Not linked yet</option>
                            @foreach (var u in _users!)
                            {
                                <option value="@u.Id">@u.Email</option>
                            }
                        </select>
                        <p class="cg-hint">Until this is linked, they cannot sign in and see their own declarations.</p>
                    </label>

                    @if (!string.IsNullOrEmpty(_editing.ApplicationUserId))
                    {
                        <label class="cg-field">
                            <span>Profile picture</span>
                            <div class="cg-profile-upload">
                                @if (!string.IsNullOrEmpty(_profilePicturePath))
                                {
                                    <img src="@_profilePicturePath" alt="Profile picture" class="cg-profile-pic-preview" />
                                }
                                else
                                {
                                    <span class="cg-profile-pic-placeholder">@(_editing.FullName.Length > 0 ? _editing.FullName[..1].ToUpperInvariant() : "?")</span>
                                }
                                <InputFile OnChange="OnProfilePictureSelectedAsync" accept="image/png,image/jpeg,image/webp" />
                            </div>
                            <p class="cg-hint">JPEG, PNG or WebP, up to 2 MB.</p>
                        </label>
                    }
                </div>

                @* The technical fields are real but rarely touched, so they are out of the way
                   rather than sitting between the name and the email address. *@
                <details class="cg-advanced">
                    <summary>Technical details</summary>
                    <div class="cg-form-grid">
                        <label class="cg-field">
                            <span>Directory ID</span>
                            <input class="cg-input mono" @bind="_editing.AzureAdObjectId" readonly />
                            <p class="cg-hint">Set automatically when the person comes from Entra ID. Read-only.</p>
                        </label>
                        <label class="cg-field">
                            <span>Signature reference</span>
                            <InputText class="cg-input" @bind-Value="_editing.Signature" maxlength="160" placeholder="e.g. scanned signature reference" />
                        </label>
                    </div>
                </details>
            </section>

            <AuthorizeView Roles="@GovernanceRoles.Administrator" Context="rolesCtx">
                <Authorized>
                    @if (!string.IsNullOrEmpty(_editing.ApplicationUserId))
                    {
                        <label class="cg-field">
                            <span>System roles for this login</span>
                            <select class="cg-input" @bind="_systemRoleSelection" @bind:after="ApplySystemRoleAsync">
                                <option value="">No role</option>
                                @foreach (var role in _roles ?? [])
                                {
                                    <option value="@role.Name">@role.Name</option>
                                }
                            </select>
                        </label>

                        @if (_editing.ApplicationUserId != _currentUserId)
                        {
                            <div class="cg-ad-status cg-ad-warn">
                                Support access: sign in as this user's account for troubleshooting or delegated access. Fully logged.
                                <button type="button" class="cg-action-btn cg-critical" @onclick="LogInAsAsync">Log in as this user</button>
                            </div>
                        }
                    }
                </Authorized>
            </AuthorizeView>

            <div class="cg-actions">
                <button type="submit" class="cg-action-btn cg-good" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                <button type="button" class="cg-action-btn" @onclick="GoBack" disabled="@_saving">Cancel</button>
            </div>

            @if (_editing.Id != 0)
            {
                <div class="cg-actions" style="margin-top:16px;">
                    <label style="display:flex; align-items:center; gap:8px;">
                        <ToggleSwitch Value="_editing.Active" ValueChanged="() => _showDeactivateJustify = true" />
                        @(_editing.Active ? "Active" : "Inactive")
                    </label>
                    <button type="button" class="cg-action-btn" @onclick="() => _showPrintPreview = true">Print Preview</button>
                </div>
            }

            @if (_showDeactivateJustify && _editing.Id != 0)
            {
                <JustificationPrompt Show="true"
                                     Label="@($"Why are you {(_editing.Active ? "deactivating" : "reactivating")} {_editing.FullName}? (Deactivating blocks their login.)")"
                                     Toasts="Toasts"
                                     OnConfirm="DeactivateAsync"
                                     OnCancel="() => _showDeactivateJustify = false" />
            }

            <NotifyUserPrompt Show="_showNotifyPrompt" UserName="@_editing.FullName" OnChoice="NotifyChoiceAsync" />

            @if (_editing.Id != 0)
            {
                <details class="cg-audit-history">
                    <summary>Audit history (@_auditEntries.Count)</summary>
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>When</th><th>Who</th><th>Action</th><th>How</th><th>Why</th><th>IP</th></tr></thead>
                            <tbody>
                                @foreach (var entry in _auditEntries)
                                {
                                    <tr class="cg-data-row">
                                        <td class="mono">@entry.OccurredAtUtc.ToLocalDisplay("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>@entry.ActorDisplayName</td>
                                        <td>@entry.Action</td>
                                        <td>@entry.Details</td>
                                        <td>@(entry.Justification ?? "—")</td>
                                        <td class="mono">@(entry.IpAddress ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (_auditEntries.Count == 0)
                        {
                            <div class="cg-empty-state">No audit events recorded for this user yet.</div>
                        }
                    </div>
                </details>

                <details class="cg-audit-history">
                    <summary>Uploaded documents (@_documents.Count)</summary>
                    <div class="cg-tabs" role="tablist">
                        <button type="button" class="cg-tab @(_documentsTab == "latest" ? "active" : "")" role="tab" aria-selected="@(_documentsTab == "latest")" @onclick='() => _documentsTab = "latest"'>Latest (@LatestDocuments().Count)</button>
                        <button type="button" class="cg-tab @(_documentsTab == "previous" ? "active" : "")" role="tab" aria-selected="@(_documentsTab == "previous")" @onclick='() => _documentsTab = "previous"'>Previous (@PreviousDocuments().Count)</button>
                    </div>
                    <div class="cg-table-wrap">
                        <table>
                            <thead><tr><th>Document</th><th>Period</th><th>Number</th><th>Expiry</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var doc in DisplayedDocuments())
                                {
                                    <tr class="cg-data-row">
                                        <td>@doc.DocumentType</td>
                                        <td class="mono">@doc.PeriodLabel</td>
                                        <td>@(doc.Number ?? "—")</td>
                                        <td class="mono">@(doc.ExpiryDate is null ? "—" : doc.ExpiryDate.Value.ToString("dd/MM/yyyy"))</td>
                                        <td><a href="@doc.Path" target="_blank">View</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (DisplayedDocuments().Count == 0)
                        {
                            <div class="cg-empty-state">@(_documentsTab == "previous" ? "No previous (superseded) documents on file." : "No documents uploaded by this user yet.")</div>
                        }
                    </div>
                </details>
            }
        </EditForm>

        @if (_showPrintPreview)
        {
            <div class="cg-print-overlay">
                <div class="cg-print-modal">
                    <div class="cg-print-modal-actions no-print">
                        <button type="button" class="cg-action-btn cg-good" @onclick="PrintAsync">Print / Save as PDF</button>
                        <button type="button" class="cg-action-btn" @onclick="() => _showPrintPreview = false">Close</button>
                    </div>
                    <div class="cg-print-area">
                        <div class="cg-print-header">
                            <img src="images/di-logo.jpg" alt="Dubai Investments" />
                            <div>
                                <h2>Corporate Governance Tool — User Record</h2>
                                <PrintFooter />
                            </div>
                        </div>
                        <table class="cg-print-table">
                            <tbody>
                                <tr><th>Full name</th><td>@_editing.FullName</td></tr>
                                <tr><th>Entity</th><td>@(_companies?.FirstOrDefault(c => c.Id == _editing.CompanyId)?.Name ?? "—")</td></tr>
                                <tr><th>Department</th><td>@(_departments?.FirstOrDefault(d => d.Id == _editing.DepartmentId)?.Name ?? "—")</td></tr>
                                <tr><th>Job title</th><td>@(_editing.JobTitle ?? "—")</td></tr>
                                <tr><th>Email</th><td>@(_editing.Email ?? "—")</td></tr>
                                <tr><th>Login account</th><td>@(_users?.FirstOrDefault(u => u.Id == _editing.ApplicationUserId)?.Email ?? "Not linked")</td></tr>
                                <tr><th>Reporting manager</th><td>@(_members?.FirstOrDefault(m => m.Id == _editing.ReportingManagerId)?.FullName ?? "None")</td></tr>
                                <tr><th>Role assigned</th><td>@RoleAssignedSummary</td></tr>
                                <tr><th>Board member</th><td>@(_editing.IsBoardMember ? "Yes" : "No")</td></tr>
                                <tr><th>Executive Management</th><td>@(_editing.IsExecutiveManagement ? "Yes" : "No")</td></tr>
                                <tr><th>External member</th><td>@(_editing.IsExternalMember ? "Yes" : "No")</td></tr>
                                <tr><th>Can be impersonated</th><td>@(_editing.CanBeImpersonated ? "Yes" : "No")</td></tr>
                                <tr><th>Status</th><td>@(_editing.Active ? "Active" : "Inactive")</td></tr>
                                <tr><th>Signature</th><td>@(_editing.Signature ?? "—")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>
