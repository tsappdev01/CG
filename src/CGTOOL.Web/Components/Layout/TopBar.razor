@implements IDisposable
@using System.Security.Claims

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<AuthorizeView>
    <Authorized>
        <header class="cg-appbar">
            <div class="cg-appbar-actions">
                @if (_showNotifications)
                {
                    <a class="cg-appbar-bell" href="admin/pending-notifications"
                       title="@(_pendingCount == 0 ? "No pending notifications" : $"{_pendingCount} pending notification(s)")">
                        <span class="cg-appbar-bell-glyph" aria-hidden="true"></span>
                        @if (_pendingCount > 0)
                        {
                            <span class="cg-appbar-badge">@(_pendingCount > 99 ? "99+" : _pendingCount.ToString())</span>
                        }
                        <span class="cg-visually-hidden">Pending notifications</span>
                    </a>
                }

                @* The account menu the sidebar used to carry. Signing out lives here now, where
                   people look for it, rather than as an unlabelled icon under the logo. *@
                <div class="cg-appbar-account">
                    <button type="button" class="cg-appbar-user" @onclick="() => _menuOpen = !_menuOpen"
                            aria-haspopup="menu" aria-expanded="@_menuOpen">
                        @if (!string.IsNullOrEmpty(_picturePath))
                        {
                            <img src="@_picturePath" alt="" class="cg-appbar-avatar" />
                        }
                        else
                        {
                            <span class="cg-appbar-avatar cg-appbar-avatar-initials">@Initials(_displayName)</span>
                        }
                        <span class="cg-appbar-user-text">
                            <span class="cg-appbar-user-name">@_displayName</span>
                            <span class="cg-appbar-user-role">@_roleLabel</span>
                        </span>
                        <span class="cg-appbar-caret @(_menuOpen ? "open" : "")" aria-hidden="true"></span>
                    </button>

                    @if (_menuOpen)
                    {
                        @* A transparent sheet behind the panel closes it on any outside click,
                           which keeps this to markup rather than a JS document listener. *@
                        <div class="cg-appbar-menu-backdrop" @onclick="() => _menuOpen = false"></div>

                        <div class="cg-appbar-menu" role="menu">
                            <div class="cg-appbar-menu-head">
                                <span class="cg-appbar-menu-name">@_displayName</span>
                                <span class="cg-appbar-menu-role">@_roleLabel</span>
                            </div>

                            <a class="cg-appbar-menu-item" role="menuitem" href="Account/Manage">
                                <span class="cg-appbar-menu-ico cg-ico-person" aria-hidden="true"></span>
                                Manage your account
                            </a>

                            <form action="Account/Logout" method="post" class="cg-appbar-menu-form">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="Account/Login" />
                                <button type="submit" class="cg-appbar-menu-item cg-appbar-menu-signout" role="menuitem">
                                    <span class="cg-appbar-menu-ico cg-ico-signout" aria-hidden="true"></span>
                                    Sign out
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </header>
    </Authorized>
</AuthorizeView>

@code {
    private string? _displayName;
    private string? _roleLabel;
    private string? _picturePath;
    private bool _showNotifications;
    private int _pendingCount;
    private bool _menuOpen;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await RefreshAsync();
    }

    // The top bar is a persistent layout component, so it uses its own short-lived DbContext rather
    // than the circuit-scoped one -- sharing it would race whichever page is loading at the same time.
    private async Task RefreshAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            _displayName = null;
            return;
        }

        _roleLabel = user.IsInRole(GovernanceRoles.Administrator)
            ? GovernanceRoles.Administrator
            : user.FindFirst(ClaimTypes.Role)?.Value ?? GovernanceRoles.NormalUser;

        // Only people who can actually open Pending Notifications get the bell.
        _showNotifications = !GovernanceRoles.IsNormalStaffOnly(user);

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var path = await db.Users.Where(u => u.Id == userId).Select(u => u.ProfilePicturePath).FirstOrDefaultAsync();
        _picturePath = string.IsNullOrEmpty(path) ? path : $"{path}?v={DateTime.UtcNow.Ticks}";

        _displayName = await db.Members.Where(m => m.ApplicationUserId == userId).Select(m => m.FullName).FirstOrDefaultAsync()
                       ?? user.Identity?.Name;

        if (_showNotifications)
        {
            _pendingCount = await db.MemberNotifications.CountAsync(n => n.Status == MemberNotificationStatus.Pending);
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        await RefreshAsync();
        StateHasChanged();
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split([' ', '.', ','], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
