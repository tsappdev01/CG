@page "/Account/ExternalLogin"

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using CGTOOL.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

<PageTitle>Sign in</PageTitle>

<StatusMessage Message="@message" />

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private string? message;
    private ExternalLoginInfo externalLoginInfo = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    private string? ProviderDisplayName => externalLoginInfo.ProviderDisplayName;

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", $"Error from external provider: {RemoteError}", HttpContext);
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error loading external login information.", HttpContext);
        }

        externalLoginInfo = info;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }

            // We should only reach this page via the login callback, so redirect back to
            // the login page if we get here some other way.
            RedirectManager.RedirectTo("Account/Login");
        }
    }

    private async Task OnLoginCallbackAsync()
    {
        // Sign in the user with this external login provider if the user already has a login.
        var result = await SignInManager.ExternalLoginSignInAsync(
            externalLoginInfo.LoginProvider,
            externalLoginInfo.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        if (result.Succeeded)
        {
            Logger.LogInformation(
                "{Name} logged in with {LoginProvider} provider.",
                externalLoginInfo.Principal.Identity?.Name,
                externalLoginInfo.LoginProvider);
            await StampSignInAsync(await UserManager.FindByLoginAsync(externalLoginInfo.LoginProvider, externalLoginInfo.ProviderKey));
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }

        // Entra only issues an "email" claim when the account has a mail attribute, or when someone
        // has added it as an optional claim. A work account that signs in perfectly well can arrive
        // with no email at all -- and since this is the only thing tying a tenant identity to a
        // record here, that person would be turned away for a reason nobody would guess. The user
        // principal name is the same address in practice, so it stands in.
        var email = FirstNonEmptyClaim(
            ClaimTypes.Email,          // "email"
            "preferred_username",      // the v2.0 token's UPN, present on every work account
            ClaimTypes.Upn);

        // The external login isn't linked yet, but the same person may already have an account
        // (e.g. provisioned earlier via the corporate directory login) under the same email. Link
        // this SSO login to that existing account instead of silently creating a picture-less,
        // role-less duplicate ApplicationUser.
        if (!string.IsNullOrEmpty(email))
        {
            var existingUser = await UserManager.FindByEmailAsync(email);

            // Deactivating a user locks their login out. ExternalLoginSignInAsync above honours
            // that, but SignInAsync below does not check anything -- so without this, a deactivated
            // person signing in through SSO for the first time, before their login was ever linked,
            // would be let straight in.
            if (existingUser is not null && await UserManager.IsLockedOutAsync(existingUser))
            {
                RedirectManager.RedirectTo("Account/Lockout");
            }

            if (existingUser is not null)
            {
                var addLoginResult = await UserManager.AddLoginAsync(existingUser, externalLoginInfo);
                if (addLoginResult.Succeeded)
                {
                    Logger.LogInformation("Linked {LoginProvider} login to existing account for {Email}.", externalLoginInfo.LoginProvider, email);
                    await StampSignInAsync(existingUser);
                    await SignInManager.SignInAsync(existingUser, isPersistent: false, externalLoginInfo.LoginProvider);
                    RedirectManager.RedirectTo(ReturnUrl);
                }
            }
        }

        // No account here, and no self-registration: everyone in this application is provisioned
        // from the directory or the user list upload, with an entity, a department and declaration
        // access an administrator decided on. Signing in with a tenant account that nobody has been
        // set up would otherwise put a governance tool inside the reach of the whole tenant.
        Logger.LogWarning("Refused {LoginProvider} sign-in for {Email}: no account exists.", externalLoginInfo.LoginProvider, email ?? "(no email claim)");
        RedirectManager.RedirectToWithStatus("Account/Login",
            $"Error: {email ?? "That account"} is not set up in this application. Ask an administrator to add you, then sign in again.",
            HttpContext);
    }

    private string? FirstNonEmptyClaim(params string[] claimTypes)
    {
        foreach (var type in claimTypes)
        {
            var value = externalLoginInfo.Principal.FindFirstValue(type);
            if (!string.IsNullOrWhiteSpace(value)) return value;
        }

        return null;
    }

    private async Task StampSignInAsync(ApplicationUser? user)
    {
        if (user is null) return;
        user.LastSignInUtc = DateTime.UtcNow;
        await UserManager.UpdateAsync(user);
    }
}
