@* A confirmation the person has to answer before anything else. It was a panel in the flow of the
   page, which put the question wherever the caller happened to sit -- above a form on one screen,
   under a table row on another -- and left the page behind it looking as editable as before. A
   dialog puts the question in one place and makes it clear that the answer comes first. *@
@if (Show)
{
    <div class="cg-modal-backdrop" @onclick="() => OnCancel.InvokeAsync()"></div>
    <div class="cg-modal cg-confirm-modal" role="alertdialog" aria-modal="true" aria-labelledby="@($"cg-confirm-{_id:N}")">
        <div class="cg-modal-body">
            <p id="@($"cg-confirm-{_id:N}")">@Message</p>
            @if (!string.IsNullOrWhiteSpace(Detail))
            {
                <p class="cg-confirm-detail">@Detail</p>
            }
        </div>
        <div class="cg-modal-foot">
            <button type="button" class="cg-action-btn" @onclick="() => OnCancel.InvokeAsync()">@CancelLabel</button>
            <button type="button" class="cg-action-btn @(Critical ? "cg-critical" : "cg-good")" @onclick="() => OnConfirm.InvokeAsync()">@ConfirmLabel</button>
        </div>
    </div>
}

@code {
    // Labels the message so a screen reader announces the question with the dialog, and stays
    // unique where a page holds more than one of these.
    private readonly Guid _id = Guid.NewGuid();

    [Parameter] public bool Show { get; set; }
    [Parameter] public string Message { get; set; } = "Are you sure?";

    /// <summary>A second line under the question -- what the caller wants counted or spelled out
    /// before the person commits, such as how many people a notification is about to reach.</summary>
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";

    /// <summary>"Cancel" is right when declining abandons the action, and wrong when it just
    /// declines an offer and carries on -- "Not now" there.</summary>
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public bool Critical { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
