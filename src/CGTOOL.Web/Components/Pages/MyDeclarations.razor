@page "/my-declarations"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject ImpersonationContext Impersonation
@inject IAuditLogger AuditLog
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Branding Branding

<PageTitle>Declarations</PageTitle>

<div class="cg-shell cg-declarations-page">
    <InsiderDeclarationBanner />

    <h1 data-icon="doc">Declarations</h1>
    @if (_isImpersonating)
    {
        <p class="cg-subtitle">Submitting on behalf of <b>@_effectiveMember?.FullName</b>.</p>
    }
    else
    {
        <p class="cg-subtitle">Submit your Insider Declaration and Related Party &amp; Conflict of Interest (COI) declaration for each open period.</p>
    }

    @if (_effectiveMember is null)
    {
        <p class="cg-subtitle">Your login isn't linked to a User record yet. Ask an Administrator to link your account on the User Management page.</p>
    }
    else
    {
        <div class="cg-declaration-options">
            <a class="cg-declaration-option @(Option1Enabled ? "" : "disabled")"
               href="@(Option1Enabled ? "/declarations/insider-trading" : null)">
                <h2>1. Submit Insider Declaration</h2>
                <p>@(Option1Enabled ? $"Due {_insiderRun!.DueDateUtc.ToLocalDisplay():dd MMM yyyy}." : "Not currently due.")</p>
            </a>

            <a class="cg-declaration-option @(Option2Enabled ? "" : "disabled")"
               href="@(Option2Enabled ? "/declarations/related-party-coi" : null)">
                <h2>2. Submit Related Party &amp; COI Declaration</h2>
                <p>@(Option2Enabled ? $"Due {_coiRun!.DueDateUtc.ToLocalDisplay():dd MMM yyyy}." : "Not currently due.")</p>
            </a>
        </div>

        <h2 class="cg-section-heading">Insider Trading declaration history</h2>
        @if (_insiderHistory is null)
        {
            <p class="cg-loading"><em>Loading…</em></p>
        }
        else if (_insiderHistory.Count == 0)
        {
            <div class="cg-empty-state">No Insider Trading declarations submitted yet.</div>
        }
        else
        {
            <div class="cg-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Quarter</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Last modified</th>
                            <th>Due date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _insiderHistory)
                        {
                            @* A draft stays open past the due date: it was never submitted, and the
                               due date is what closes a submitted declaration to further change, not
                               what abandons an unfinished one. *@
                            var editable = d.IsDraft || d.DeclarationCycleRun!.DueDateUtc.ToLocalDisplay().Date >= DateTime.Now.Date;
                            <tr class="cg-data-row">
                                <td class="mono">Q@(d.DeclarationCycleRun!.PeriodQuarter) @d.DeclarationCycleRun!.PeriodYear</td>
                                <td><span class="cg-status-pill @(d.IsDraft ? "pending" : "cleared")">@(d.IsDraft ? "Draft" : "Submitted")</span></td>
                                <td class="mono">@(d.IsDraft ? "—" : d.SubmittedAtUtc.ToLocalDisplay("dd/MM/yyyy HH:mm"))</td>
                                <td class="mono">@(d.ModifiedAtUtc?.ToLocalDisplay("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="mono">@d.DeclarationCycleRun!.DueDateUtc.ToLocalDisplay("dd/MM/yyyy")</td>
                                <td>
                                    <button type="button" class="cg-icon-btn" title="Print preview" @onclick="() => _printDeclaration = d"><span class="cg-icon-print-glyph"></span></button>
                                    @if (editable)
                                    {
                                        <button type="button" class="cg-action-btn" @onclick="() => _confirmEditDeclaration = d">@(d.IsDraft ? "Continue" : "Edit")</button>
                                    }
                                    else
                                    {
                                        <span class="cg-subtitle" style="margin:0;">Edit window closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <ConfirmPrompt Show="_confirmEditDeclaration is not null"
                       Message="You are about to edit your declaration. Once you proceed, please make sure you re-submit your declaration after editing."
                       ConfirmLabel="Confirm"
                       OnConfirm="ConfirmEdit"
                       OnCancel="() => _confirmEditDeclaration = null" />

        <h2 class="cg-section-heading">Related Party &amp; COI declaration history</h2>
        @if (_coiHistory is null)
        {
            <p class="cg-loading"><em>Loading…</em></p>
        }
        else if (_coiHistory.Count == 0)
        {
            <div class="cg-empty-state">No Related Party &amp; COI declarations submitted yet.</div>
        }
        else
        {
            <div class="cg-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Quarter</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Last modified</th>
                            <th>Due date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _coiHistory)
                        {
                            @* A draft stays open past the due date: it was never submitted, and the
                               due date is what closes a submitted declaration to further change, not
                               what abandons an unfinished one. *@
                            var editable = d.IsDraft || d.DeclarationCycleRun!.DueDateUtc.ToLocalDisplay().Date >= DateTime.Now.Date;
                            <tr class="cg-data-row">
                                <td class="mono">Q@(d.DeclarationCycleRun!.PeriodQuarter) @d.DeclarationCycleRun!.PeriodYear</td>
                                <td><span class="cg-status-pill @(d.IsDraft ? "pending" : "cleared")">@(d.IsDraft ? "Draft" : "Submitted")</span></td>
                                <td class="mono">@(d.IsDraft ? "—" : d.SubmittedAtUtc.ToLocalDisplay("dd/MM/yyyy HH:mm"))</td>
                                <td class="mono">@(d.ModifiedAtUtc?.ToLocalDisplay("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td class="mono">@d.DeclarationCycleRun!.DueDateUtc.ToLocalDisplay("dd/MM/yyyy")</td>
                                <td>
                                    @if (editable)
                                    {
                                        <button type="button" class="cg-action-btn" @onclick="() => _confirmEditCoiDeclaration = d">@(d.IsDraft ? "Continue" : "Edit")</button>
                                    }
                                    else
                                    {
                                        <span class="cg-subtitle" style="margin:0;">Edit window closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <ConfirmPrompt Show="_confirmEditCoiDeclaration is not null"
                       Message="You are about to edit your declaration. Once you proceed, please make sure you re-submit your declaration after editing."
                       ConfirmLabel="Confirm"
                       OnConfirm="ConfirmEditCoi"
                       OnCancel="() => _confirmEditCoiDeclaration = null" />

        @if (_printDeclaration is not null)
        {
            <div class="cg-print-overlay">
                <div class="cg-print-modal cg-print-modal-wide">
                    <div class="cg-print-modal-actions no-print">
                        <button type="button" class="cg-action-btn" @onclick="() => _printDeclaration = null">Close</button>
                    </div>
                    @* The detailed submission report's own sheet, not a copy of it. The copy had
                       fallen a release behind without anyone noticing: no share transactions, and
                       a document list that stopped at the three built-in kinds. It also brings the
                       Print, PDF and Excel buttons with it, so what a declarant keeps is the same
                       document a reviewer reads. *@
                    <ReportViewer Report="PrintSheet()" />
                </div>
            </div>
        }
    }
</div>
