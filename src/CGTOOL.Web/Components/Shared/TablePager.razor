@* The pager under a table: a row count, page buttons and a rows-per-page picker. Lifted out of
   User Management so the Control Panel lists share one implementation rather than four copies.

   The component owns no state -- the page keeps Page and PageSize and slices its own rows, which
   keeps the paged list and everything else on the page (selection, counts, print) reading from the
   same source. *@

@if (TotalItems > 0 || AlwaysShow)
{
    <div class="cg-table-foot">
        <span>Showing @FirstRow to @LastRow of @TotalItems @ItemNoun</span>
        <div class="cg-pager">
            <button type="button" title="Previous page" disabled="@(Page <= 1)" @onclick="() => GoAsync(Page - 1)">‹</button>
            @foreach (var p in PageNumbers())
            {
                var target = p;
                <button type="button" class="@(target == Page ? "active" : "")" @onclick="() => GoAsync(target)">@target</button>
            }
            <button type="button" title="Next page" disabled="@(Page >= TotalPages)" @onclick="() => GoAsync(Page + 1)">›</button>
            <select class="cg-input cg-page-size" value="@PageSize" @onchange="e => SetSizeAsync(int.Parse((string)e.Value!))" aria-label="Rows per page">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size">@size / page</option>
                }
            </select>
        </div>
    </div>
}

@code {
    public static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    [Parameter, EditorRequired] public int TotalItems { get; set; }

    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>What the rows are, for the "of 42 ___" count. Plural.</summary>
    [Parameter] public string ItemNoun { get; set; } = "rows";

    /// <summary>Keep the pager on screen with nothing to page through. Off by default, so an empty
    /// list shows its empty state rather than an empty list plus "Showing 0 to 0 of 0".</summary>
    [Parameter] public bool AlwaysShow { get; set; }

    public int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)PageSize));

    private int FirstRow => TotalItems == 0 ? 0 : ((Page - 1) * PageSize) + 1;

    private int LastRow => Math.Min(Page * PageSize, TotalItems);

    /// <summary>At most seven page buttons, centred on the current page, so the pager stays a fixed
    /// width however many rows there are.</summary>
    private IEnumerable<int> PageNumbers()
    {
        const int window = 7;
        var total = TotalPages;
        if (total <= window) return Enumerable.Range(1, total);

        var start = Math.Max(1, Math.Min(Page - window / 2, total - window + 1));
        return Enumerable.Range(start, window);
    }

    private Task GoAsync(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, TotalPages));

    private async Task SetSizeAsync(int size)
    {
        await PageSizeChanged.InvokeAsync(size);
        await PageChanged.InvokeAsync(1);
    }
}
