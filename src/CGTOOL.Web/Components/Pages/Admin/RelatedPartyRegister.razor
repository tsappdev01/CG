@page "/reports/related-party-register"
@attribute [Authorize(Roles = GovernanceRoles.Administrator)]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Related Party Register</PageTitle>

<div class="cg-shell cg-shell-full">
    <h1 data-icon="report">Related Party Register</h1>
    <p class="cg-subtitle">Every related party declared in a submitted Related Party &amp; COI declaration, consolidated across all declarants, with a complete trace back to the declaration it came from.</p>

    @if (_rows is null || _relativeRows is null)
    {
        <p class="cg-loading"><em>Loading…</em></p>
    }
    else
    {
        <div class="cg-tabs" role="tablist">
            <button type="button" class="cg-tab @(_activeTab == "relatives" ? "active" : "")" role="tab" aria-selected="@(_activeTab == "relatives")" @onclick='() => SwitchTab("relatives")'>Related Party Register — @_relativeRows.Count</button>
            <button type="button" class="cg-tab @(_activeTab == "companies" ? "active" : "")" role="tab" aria-selected="@(_activeTab == "companies")" @onclick='() => SwitchTab("companies")'>Company Interests (I.B/I.C/I.D) — @_rows.Count</button>
        </div>

        <ReportViewer Report="Build()">
            <Filters>
            <div class="cg-search-wrap">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.2" y2="16.2" /></svg>
                <input type="search" placeholder="@(_activeTab == "companies" ? "Search user or company…" : "Search related party or employee name…")" @bind="_search" @bind:event="oninput" aria-label="Search" />
            </div>

            <select class="cg-input" style="width:auto;" @bind="_yearFilter" aria-label="Filter by year">
                <option value="0">All years</option>
                @foreach (var y in AvailableYears())
                {
                    <option value="@y">@y</option>
                }
            </select>

            <select class="cg-input" style="width:auto;" @bind="_quarterFilter" aria-label="Filter by quarter">
                <option value="0">All quarters</option>
                <option value="1">Q1</option>
                <option value="2">Q2</option>
                <option value="3">Q3</option>
                <option value="4">Q4</option>
            </select>

            <select class="cg-input" style="width:auto;" @bind="_companyFilter" aria-label="Filter by entity">
                <option value="0">All entities</option>
                @foreach (var c in _companies ?? [])
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>

            <select class="cg-input" style="width:auto;" @bind="_designationFilter" aria-label="Filter by designation">
                <option value="">All designations</option>
                @foreach (var d in AvailableDesignations())
                {
                    <option value="@d">@d</option>
                }
            </select>

            @if (_activeTab == "companies")
            {
                <select class="cg-input" style="width:auto;" @bind="_ownerTypeFilter" aria-label="Filter by table">
                    <option value="">All tables</option>
                    <option value="@CoiCompanyOwnerType.Self">I.B — Self-owned</option>
                    <option value="@CoiCompanyOwnerType.Relative">I.C — Relative-owned</option>
                    <option value="@CoiCompanyOwnerType.BoardOrExecutiveRole">I.D — Board/executive role</option>
                </select>

                <select class="cg-input" style="width:auto;" @bind="_expiryFilter" aria-label="Filter by expiry status">
                    <option value="">All licenses</option>
                    <option value="expired">Expired</option>
                    <option value="expiring-soon">Expiring soon (≤60 days)</option>
                    <option value="valid">Valid</option>
                </select>
            }
            </Filters>
        </ReportViewer>
    }
</div>
